@*
    The salesperson card, with their standing over the running month. The figures
    come from the posted invoices and the commission lines, so they always agree
    with the commission screen.
*@

<div class="modal fade" id="salespersonDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h5 class="modal-title">Salesperson Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Code</dt>
                            <dd class="col-sm-7" id="SpCode"></dd>

                            <dt class="col-sm-5">Name</dt>
                            <dd class="col-sm-7" id="SpName"></dd>

                            <dt class="col-sm-5">Phone</dt>
                            <dd class="col-sm-7" id="SpPhone"></dd>

                            <dt class="col-sm-5">Email</dt>
                            <dd class="col-sm-7" id="SpEmail"></dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Basis</dt>
                            <dd class="col-sm-7" id="SpBasis"></dd>

                            <dt class="col-sm-5">Rate</dt>
                            <dd class="col-sm-7" id="SpRate"></dd>

                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7" id="SpStatus"></dd>
                        </dl>
                    </div>
                </div>

                <h6 class="mt-2">This Month</h6>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <tbody>
                            <tr>
                                <th width="30%">Invoices</th>
                                <td class="text-right" id="SpInvoiceCount"></td>
                                <th width="30%">Sales Value</th>
                                <td class="text-right" id="SpSalesAmount"></td>
                            </tr>
                            <tr>
                                <th>Target</th>
                                <td class="text-right" id="SpTargetAmount"></td>
                                <th>Pending Commission</th>
                                <td class="text-right" id="SpPending"></td>
                            </tr>
                            <tr>
                                <th>Approved Commission</th>
                                <td class="text-right" id="SpApproved"></td>
                                <th>Paid Commission</th>
                                <td class="text-right" id="SpPaid"></td>
                            </tr>
                            <tr class="bg-light">
                                <th colspan="3" class="text-right">Total Commission Earned</th>
                                <th class="text-right" id="SpTotal"></th>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
