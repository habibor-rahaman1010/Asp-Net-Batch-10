@{
    ViewData["Title"] = "Salesperson List";
}

@section Styles {
    <!-- DataTables -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Salespersons</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Sales</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Commission is earned when an invoice is posted, never by hand.</h3>

                        <a asp-area="Admin" asp-controller="Salesperson" asp-action="CommissionList" class="btn btn-secondary float-right ml-2">
                            <i class="fas fa-percent"></i> Commissions
                        </a>

                        <a asp-area="Admin" asp-controller="Salesperson" asp-action="CreateSalesperson" class="btn btn-primary float-right">
                            <i class="fas fa-plus"></i> Add Salesperson
                        </a>
                    </div>

                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="salesperson" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Commission</th>
                                    <th>Monthly Target</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Commission</th>
                                    <th>Monthly Target</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="_SalespersonDetailsPartial" />

@section Scripts {
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script type="text/javascript">

        function statusBadgeClass(status) {
            switch (status) {
                case 'Active': return 'badge-success';
                case 'Inactive': return 'badge-secondary';
                default: return 'badge-secondary';
            }
        }

        function actionButtons(id) {
            return `<a href="/Admin/Salesperson/UpdateSalesperson/${id}"
                       class="btn btn-info btn-sm mr-1" title="Edit"><i class="fas fa-edit"></i></a>
                    <button type="button" class="btn btn-danger btn-sm show-bs-modal" data-id='${id}'
                        title="Delete"><i class="fas fa-trash"></i></button>`;
        }

        function postAction(url, data, successTitle) {

            data.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: url,
                type: 'POST',
                data: data,
                success: function (response) {
                    if (response.success) {
                        Swal.fire({ icon: 'success', title: successTitle, text: response.message, timer: 2200, showConfirmButton: false });
                        $('#salesperson').DataTable().ajax.reload(null, false);
                    } else {
                        Swal.fire({ icon: 'error', title: 'Failed!', text: response.message });
                    }
                },
                error: function (error) {
                    if (error.status === 403) {
                        window.location.href = '/Account/AccessDenied';
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: 'The action could not be completed.' });
                    }
                }
            });
        }

        $(function () {
            try {
                $("#salesperson").DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    ajax: {
                        url: "/Admin/Salesperson/GetSalespersonJsonData",
                        type: "POST",
                        contentType: "application/json",
                        dataType: "json",
                        data: function (d) {
                            return JSON.stringify(d);
                        },
                    },
                    columnDefs: [
                        {
                            orderable: false,
                            targets: 7,
                            render: function (data) {
                                return actionButtons(data);
                            }
                        },
                        {
                            targets: 6,
                            render: function (data) {
                                return `<span class="badge ${statusBadgeClass(data)}">${data}</span>`;
                            }
                        },
                        ...[0, 1, 2, 3, 4, 5].map(function (target) {
                            return {
                                targets: target,
                                createdCell: function (td, cellData, rowData) {
                                    $(td).addClass('table-row');
                                    $(td).attr('data-id', rowData[7]);
                                }
                            };
                        })
                    ],
                    dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                    "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
                }).buttons().container().appendTo('#salesperson_wrapper .col-md-6:eq(0)');
            } catch (e) {
                console.error("DataTable init error:", e);
            }
        });

        // Row click -> salesperson standing for the running month
        $(function () {
            $('#salesperson tbody').on('click', '.table-row', function () {
                var id = $(this).data("id");

                $.ajax({
                    url: `/Admin/Salesperson/GetSalespersonDetails?id=${id}`,
                    type: 'GET',
                    success: function (data) {

                        $('#SpCode').text(data.salespersonCode || 'N/A');
                        $('#SpName').text(data.salespersonName || 'N/A');
                        $('#SpPhone').text(data.phone || 'N/A');
                        $('#SpEmail').text(data.email || 'N/A');
                        $('#SpBasis').text(data.commissionBasis || 'N/A');
                        $('#SpRate').text(Number(data.commissionRate ?? 0).toFixed(2));
                        $('#SpStatus').text(data.status || 'N/A');

                        $('#SpInvoiceCount').text(data.invoiceCount ?? 0);
                        $('#SpSalesAmount').text(Number(data.salesAmount ?? 0).toFixed(2));
                        $('#SpTargetAmount').text(Number(data.targetAmount ?? 0).toFixed(2));
                        $('#SpPending').text(Number(data.pendingCommission ?? 0).toFixed(2));
                        $('#SpApproved').text(Number(data.approvedCommission ?? 0).toFixed(2));
                        $('#SpPaid').text(Number(data.paidCommission ?? 0).toFixed(2));
                        $('#SpTotal').text(Number(data.totalCommission ?? 0).toFixed(2));

                        $('#salespersonDetailModal').modal('show');
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) {
                            window.location.href = '/Account/AccessDenied';
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error!', text: 'Failed to load salesperson details.' });
                        }
                    }
                });
            });
        });

        $(function () {

            $('#salesperson').on('click', '.show-bs-modal', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to recover this salesperson!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/Salesperson/DeleteSalesperson', { id: id }, 'Deleted!');
                    }
                });
            });

        });
    </script>
}
