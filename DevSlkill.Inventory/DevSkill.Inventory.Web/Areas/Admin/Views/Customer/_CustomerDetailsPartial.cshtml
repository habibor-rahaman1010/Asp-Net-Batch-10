<div class="modal fade" id="customerDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h5 class="modal-title">Customer Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Customer Code</dt>
                            <dd class="col-sm-7" id="CustomerCode"></dd>

                            <dt class="col-sm-5">Customer Name</dt>
                            <dd class="col-sm-7" id="CustomerName"></dd>

                            <dt class="col-sm-5">Phone</dt>
                            <dd class="col-sm-7" id="CustomerPhone"></dd>

                            <dt class="col-sm-5">Email</dt>
                            <dd class="col-sm-7" id="CustomerEmail"></dd>

                            <dt class="col-sm-5">Address</dt>
                            <dd class="col-sm-7" id="CustomerAddress"></dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-6">Customer Type</dt>
                            <dd class="col-sm-6" id="CustomerTypeText"></dd>

                            <dt class="col-sm-6">Status</dt>
                            <dd class="col-sm-6" id="CustomerStatus"></dd>

                            <dt class="col-sm-6">Credit Limit</dt>
                            <dd class="col-sm-6" id="CreditLimit"></dd>

                            <dt class="col-sm-6">Opening Balance</dt>
                            <dd class="col-sm-6" id="OpeningBalance"></dd>

                            <dt class="col-sm-6">Current Outstanding</dt>
                            <dd class="col-sm-6 text-danger font-weight-bold" id="CurrentOutstanding"></dd>

                            <dt class="col-sm-6">Available Credit</dt>
                            <dd class="col-sm-6" id="AvailableCredit"></dd>

                            <dt class="col-sm-6">Created</dt>
                            <dd class="col-sm-6" id="CustomerCreated"></dd>
                        </dl>
                    </div>
                </div>

                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle"></i>
                    Customer transaction history will appear here once the Customer Ledger is available.
                </div>

            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
