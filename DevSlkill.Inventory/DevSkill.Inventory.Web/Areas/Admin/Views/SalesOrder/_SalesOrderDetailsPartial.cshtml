<div class="modal fade" id="salesOrderDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h5 class="modal-title">Sales Order Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Sales Order No</dt>
                            <dd class="col-sm-7" id="SoNo"></dd>

                            <dt class="col-sm-5">From Quotation</dt>
                            <dd class="col-sm-7" id="SoQuotationNo"></dd>

                            <dt class="col-sm-5">Customer</dt>
                            <dd class="col-sm-7" id="SoCustomer"></dd>

                            <dt class="col-sm-5">Warehouse</dt>
                            <dd class="col-sm-7" id="SoWarehouse"></dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Order Date</dt>
                            <dd class="col-sm-7" id="SoDate"></dd>

                            <dt class="col-sm-5">Expected Delivery</dt>
                            <dd class="col-sm-7" id="SoExpected"></dd>

                            <dt class="col-sm-5">Salesperson</dt>
                            <dd class="col-sm-7" id="SoSalesperson"></dd>

                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7" id="SoStatus"></dd>
                        </dl>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Unit</th>
                                <th class="text-right">Ordered</th>
                                <th class="text-right">Delivered</th>
                                <th class="text-right">Invoiced</th>
                                <th class="text-right">Pending</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Discount</th>
                                <th class="text-right">Tax</th>
                                <th class="text-right">Line Total</th>
                            </tr>
                        </thead>
                        <tbody id="SoItemsBody"></tbody>
                    </table>
                </div>

                <div class="row justify-content-end">
                    <div class="col-md-5">
                        <table class="table table-sm">
                            <tr>
                                <th>Sub Total</th>
                                <td class="text-right" id="SoSubTotal"></td>
                            </tr>
                            <tr>
                                <th>Item Discount</th>
                                <td class="text-right" id="SoDiscount"></td>
                            </tr>
                            <tr>
                                <th>Tax / VAT</th>
                                <td class="text-right" id="SoTax"></td>
                            </tr>
                            <tr>
                                <th>Other Charges</th>
                                <td class="text-right" id="SoOtherCharges"></td>
                            </tr>
                            <tr class="bg-light">
                                <th>Grand Total</th>
                                <th class="text-right" id="SoGrandTotal"></th>
                            </tr>
                        </table>
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-2">Reference</dt>
                    <dd class="col-sm-4" id="SoReference"></dd>

                    <dt class="col-sm-2">Notes</dt>
                    <dd class="col-sm-4" id="SoNotes"></dd>
                </dl>

            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
