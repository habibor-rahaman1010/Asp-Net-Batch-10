@model SalesOrderUpdateModel;

@{
    ViewData["Title"] = "Update Sales Order";
}

<section class="content mt-2">
    <div class="container-fluid">
        <form asp-antiforgery="true" asp-area="Admin" asp-controller="SalesOrder" asp-action="UpdateSalesOrder" method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CustomerId" />
            <input type="hidden" asp-for="BusinessLocationId" />
            <input type="hidden" asp-for="SalesQuotationId" />

            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">Update Sales Order</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="SalesOrderNo"></label>
                                <input asp-for="SalesOrderNo" class="form-control" readonly />
                                <small class="form-text text-muted">The order number is issued once and never changes.</small>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="SalesQuotationNo"></label>
                                <input asp-for="SalesQuotationNo" class="form-control" readonly />
                                <small class="form-text text-muted">An order never moves to another quotation.</small>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="CustomerId">Customer</label>
                                <select asp-items="Model.Customers" class="form-control" disabled>
                                    <option value="@Model.CustomerId" selected></option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="BusinessLocationId">Warehouse</label>
                                <select asp-items="Model.BusinessLocations" class="form-control" disabled>
                                    <option value="@Model.BusinessLocationId" selected></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="OrderDate">Order Date*</label>
                                <input asp-for="OrderDate" type="date" class="form-control" id="OrderDate" />
                                <span asp-validation-for="OrderDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="ExpectedDeliveryDate">Expected Delivery*</label>
                                <input asp-for="ExpectedDeliveryDate" type="date" class="form-control" id="ExpectedDeliveryDate" />
                                <span asp-validation-for="ExpectedDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="SalespersonId"></label>
                                <select asp-for="SalespersonId" asp-items="Model.Salespersons" class="form-control"></select>
                                <span asp-validation-for="SalespersonId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="PaymentTermId"></label>
                                <select asp-for="PaymentTermId" asp-items="Model.PaymentTerms" class="form-control"></select>
                                <span asp-validation-for="PaymentTermId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="CustomerReference"></label>
                                <input asp-for="CustomerReference" class="form-control" />
                                <span asp-validation-for="CustomerReference" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="OtherCharges"></label>
                                <input asp-for="OtherCharges" type="number" step="0.01" min="0" class="form-control" id="OtherCharges" />
                                <span asp-validation-for="OtherCharges" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Status">Status*</label>
                                <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                <small class="form-text text-muted">
                                    Only a draft can be edited. Confirming, closing and cancelling are done from the list.
                                </small>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Notes"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <partial name="_SalesOrderLinesPartial" model="Model.SalesOrderItems" />

            <div class="card">
                <div class="card-body text-center">
                    <button type="submit" class="btn btn-primary">Update Sales Order</button>
                    <a asp-area="Admin" asp-controller="SalesOrder" asp-action="SalesOrderList" class="btn btn-danger">Cancel</a>
                </div>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_SalesOrderLinesScriptPartial" />

    <script>

        var rowIndex = @Model.SalesOrderItems.Count;

        $(document).ready(function () {

            updateDeleteButtons();
            captureRenderedProducts();

            // Show the saved lines with their current server side arithmetic straight away.
            refreshAllLines();

            $("#btnAddProduct").click(function () {

                appendRow(rowIndex);
                rowIndex++;

                updateDeleteButtons();
            });

            $("#ExpectedDeliveryDate, #OrderDate").on("change", function () {

                var orderDate = $("#OrderDate").val();
                var deliveryDate = $("#ExpectedDeliveryDate").val();

                if (orderDate && deliveryDate && deliveryDate < orderDate) {
                    Swal.fire({
                        icon: "warning",
                        title: "Invalid Date",
                        text: "Expected Delivery cannot be earlier than the order date.",
                        confirmButtonText: "OK"
                    });

                    $("#ExpectedDeliveryDate").val(orderDate);
                }
            });

        });

    </script>
}
