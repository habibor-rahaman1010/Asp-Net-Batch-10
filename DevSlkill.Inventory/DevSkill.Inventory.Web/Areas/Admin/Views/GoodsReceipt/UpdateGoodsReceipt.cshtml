@model GoodsReceiptUpdateModel;

@{
    ViewData["Title"] = "Update Goods Receipt";
}

<section class="content mt-2">
    <div class="container-fluid">
        <form asp-antiforgery="true" asp-area="Admin" asp-controller="GoodsReceipt" asp-action="UpdateGoodsReceipt" method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PurchaseOrderId" />

            <!-- Header -->
            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">Update Goods Receipt</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="GoodsReceiptNo"></label>
                                <input asp-for="GoodsReceiptNo" class="form-control" readonly />
                                <small class="form-text text-muted">The receipt number is issued once and never changes.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PurchaseOrderNo"></label>
                                <input asp-for="PurchaseOrderNo" class="form-control" readonly />
                                <small class="form-text text-muted">A receipt never moves to another purchase order.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ReceiptDate">Receipt Date*</label>
                                <input asp-for="ReceiptDate" type="date" class="form-control" />
                                <span asp-validation-for="ReceiptDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SupplierName"></label>
                                <input asp-for="SupplierName" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="WarehouseName"></label>
                                <input asp-for="WarehouseName" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SupplierChallanNo"></label>
                                <input asp-for="SupplierChallanNo" class="form-control" />
                                <span asp-validation-for="SupplierChallanNo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ReceivedBy"></label>
                                <input asp-for="ReceivedBy" class="form-control" />
                                <span asp-validation-for="ReceivedBy" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Status">Status*</label>
                                <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                <small class="form-text text-muted">
                                    Setting this to <strong>Received</strong> adds the goods to stock and closes the receipt for editing.
                                </small>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Notes"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <partial name="_GoodsReceiptLinesPartial" model="Model.GoodsReceiptItems" />

            <div class="card">
                <div class="card-body text-center">
                    <button type="submit" class="btn btn-primary">Update Goods Receipt</button>
                    <a asp-area="Admin" asp-controller="GoodsReceipt" asp-action="GoodsReceiptList" class="btn btn-danger">Cancel</a>
                </div>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_GoodsReceiptLinesScriptPartial" />
}
