@*
    Receiving grid behaviour shared by the create and update goods receipt screens.
*@

<script>

    // The quantity is capped at whatever the purchase order still has outstanding,
    // and the server checks the very same rule when the receipt is saved.
    function clampReceivedQuantity(input) {

        var row = input.closest("tr");
        var remaining = parseFloat(row.find(".remaining-qty").val()) || 0;
        var value = parseFloat(input.val()) || 0;

        if (value < 0) {
            value = 0;
        }

        if (value > remaining) {

            Swal.fire({
                icon: "warning",
                title: "More Than Ordered",
                text: "Only " + remaining.toFixed(2) + " is still outstanding on this line.",
                confirmButtonText: "OK"
            });

            value = remaining;
        }

        input.val(value);
    }

    function recalculateReceiptValue() {

        var total = 0;

        $("#receiptTableBody tr").each(function () {

            var qty = parseFloat($(this).find(".received-qty").val()) || 0;
            var price = parseFloat($(this).find(".unit-price").val()) || 0;
            var lineValue = qty * price;

            $(this).find(".line-value").val(lineValue.toFixed(2));

            total += lineValue;
        });

        $("#sumReceiptValue").text(total.toFixed(2));
    }

    function buildReceiptRows(lines) {

        var body = $("#receiptTableBody").empty();

        $.each(lines, function (i, line) {

            var row = $("<tr>");

            var productCell = $("<td>").text(line.productName);
            productCell.append($('<input type="hidden">').attr("name", "GoodsReceiptItems[" + i + "].ProductId").val(line.productId));
            productCell.append($('<input type="hidden">').attr("name", "GoodsReceiptItems[" + i + "].ProductName").val(line.productName));
            productCell.append($('<input type="hidden">').attr("name", "GoodsReceiptItems[" + i + "].UnitName").val(line.unitName));
            productCell.append($('<input type="hidden">').attr("name", "GoodsReceiptItems[" + i + "].OrderedQuantity").val(line.orderedQuantity));
            productCell.append($('<input type="hidden">').attr("name", "GoodsReceiptItems[" + i + "].AlreadyReceivedQuantity").val(line.receivedQuantity));
            productCell.append($('<input type="hidden" class="remaining-qty">').attr("name", "GoodsReceiptItems[" + i + "].RemainingQuantity").val(line.remainingQuantity));
            productCell.append($('<input type="hidden" class="unit-price">').attr("name", "GoodsReceiptItems[" + i + "].UnitPrice").val(line.unitPrice));
            row.append(productCell);

            row.append($("<td>").text(line.unitName || ""));
            row.append($('<td class="text-right">').text(Number(line.orderedQuantity).toFixed(2)));
            row.append($('<td class="text-right">').text(Number(line.receivedQuantity).toFixed(2)));
            row.append($('<td class="text-right font-weight-bold">').text(Number(line.remainingQuantity).toFixed(2)));

            row.append($("<td>").append(
                $('<input type="number" step="1" min="0" class="form-control received-qty">')
                    .attr("name", "GoodsReceiptItems[" + i + "].ReceivedQuantity")
                    .val(Number(line.remainingQuantity))));

            row.append($("<td>").append(
                $('<input type="number" step="0.01" min="0" class="form-control rejected-qty">')
                    .attr("name", "GoodsReceiptItems[" + i + "].RejectedQuantity")
                    .val(0)));

            row.append($('<td class="text-right">').text(Number(line.unitPrice).toFixed(2)));
            row.append($("<td>").append($('<input class="form-control line-value" readonly>').val("0.00")));

            body.append(row);
        });

        recalculateReceiptValue();
    }

    $(document).ready(function () {

        recalculateReceiptValue();

        $(document).on("change", ".received-qty", function () {
            clampReceivedQuantity($(this));
            recalculateReceiptValue();
        });

        $(document).on("change", ".rejected-qty", function () {

            if (parseFloat($(this).val()) < 0) {
                $(this).val(0);
            }
        });

    });

</script>
