<div class="modal fade" id="goodsReceiptDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h5 class="modal-title">Goods Receipt Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Receipt No</dt>
                            <dd class="col-sm-7" id="GrnNo"></dd>

                            <dt class="col-sm-5">Purchase Order</dt>
                            <dd class="col-sm-7" id="GrnPoNo"></dd>

                            <dt class="col-sm-5">Supplier</dt>
                            <dd class="col-sm-7" id="GrnSupplier"></dd>

                            <dt class="col-sm-5">Warehouse</dt>
                            <dd class="col-sm-7" id="GrnWarehouse"></dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Receipt Date</dt>
                            <dd class="col-sm-7" id="GrnDate"></dd>

                            <dt class="col-sm-5">Supplier Challan</dt>
                            <dd class="col-sm-7" id="GrnChallan"></dd>

                            <dt class="col-sm-5">Received By</dt>
                            <dd class="col-sm-7" id="GrnReceivedBy"></dd>

                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7" id="GrnStatus"></dd>
                        </dl>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Unit</th>
                                <th class="text-right">Ordered</th>
                                <th class="text-right">Received</th>
                                <th class="text-right">Rejected</th>
                                <th class="text-right">Returned</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Line Value</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="GrnItemsBody"></tbody>
                        <tfoot>
                            <tr class="bg-light">
                                <th colspan="7" class="text-right">Receipt Value</th>
                                <th class="text-right" id="GrnTotalValue"></th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-2">Notes</dt>
                    <dd class="col-sm-10" id="GrnNotes"></dd>
                </dl>

            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
