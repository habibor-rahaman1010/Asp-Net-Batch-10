@model SellingPriceTaxUpdateModel
<!-- Modal for updating a existing Selling Price Tax -->
<div class="modal fade" id="updateSellingPriceTaxModal" tabindex="-1" role="dialog" aria-labelledby="updateSellingPriceTaxModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateSellingPriceTaxModalLabel">Update The Selling Price Tax</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form method="post" asp-antiforgery="true" id="updateSellingPriceTaxForm" enctype="multipart/form-data">
                    <input asp-for="Id" type="hidden" id="updateSellingPriceTaxId" name="Id" />
                    <div class="form-group">
                        <label asp-for="SellingPriceTaxName">Selling Tax Name</label>
                        <input asp-for="SellingPriceTaxName" type="text" class="form-control" id="editSellingTaxName" name="SellingPriceTaxName" required>
                        <span asp-validation-for="SellingPriceTaxName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="TaxRate">Description</label>
                        <input asp-for="TaxRate" type="number" class="form-control" id="editTaxRate" name="TaxRate" required>
                        <span asp-validation-for="TaxRate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description">Warranty Duration</label>
                        <textarea asp-for="Description" class="form-control" id="editDescription" name="Description" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>
