    <script type="text/javascript">
        //Load data in table used by DataTable...
        $(function () {
            $("#applicableTaxes").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                ajax: {
                    url: "/Admin/SellingPriceTax/GetSellingPriceTaxJsonData",
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    data: function (d) {
                        return JSON.stringify(d);
                    }
                },

                columnDefs: [
                    {
                        // Render description column with only 20 words
                        targets: 1,
                        render: function (data, type, row) {
                            var words = data.split(" ");
                            if (words.length > 10) {
                                return words.slice(0, 10).join(" ") + '...';
                            }
                            return data;
                        }
                    },

                    {
                        orderable: false,
                        targets: 3,
                        render: function (data, type, row) {
                            return `<button type="button" class="btn btn-info btn-sm update-applicableTax" data-id='${data}' data-toggle="modal" data-target="#updateApplicableTaxModal">
                                                        <i class="fas fa-pencil-alt"></i> Edit
                                                    </button>

                                                    <button type="submit" class="btn btn-danger btn-sm delete-applicableTax" data-id='${data}' value='${data}'>
                                                        <i class="fas fa-trash">
                                                        </i>
                                                        Delete
                                                    </button>`;
                        }
                    },
                ],

                dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]

            }).buttons().container().appendTo('#applicableTaxes_wrapper .col-md-6:eq(0)');

