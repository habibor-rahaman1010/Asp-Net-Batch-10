@model List<CustomerPaymentAllocationModel>

@*
    The allocation grid, shared by the create and update collection screens. Every
    figure but "Against This" comes off the invoice and is read only; the server
    checks the same limits when the money is taken.
*@

<div class="card">

    <div class="card-header">
        <div class="d-flex justify-content-between">
            <h3 class="card-title">Open Invoices</h3>
            <button id="btnAutoAllocate" type="button" class="btn btn-secondary btn-sm">
                <i class="fas fa-magic"></i> Spread Oldest First
            </button>
        </div>
    </div>

    <div class="card-body">

        <div class="alert alert-info">
            <i class="fas fa-money-bill-wave"></i>
            Put the money against the invoices it settles. The allocations may come to
            <strong>less</strong> than what came in, and the rest simply sits as an advance, but
            they can never come to more than was actually collected.
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th width="16%">Invoice No</th>
                        <th width="11%">Invoice Date</th>
                        <th width="11%">Due Date</th>
                        <th width="9%">Overdue</th>
                        <th width="12%">Invoice Value</th>
                        <th width="11%">Collected</th>
                        <th width="11%">Still Owing</th>
                        <th width="19%">Against This</th>
                    </tr>
                </thead>

                <tbody id="allocationTableBody">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model[i].InvoiceNo
                                <input type="hidden" name="CustomerPaymentAllocations[@i].SalesInvoiceId" value="@Model[i].SalesInvoiceId" />
                                <input type="hidden" name="CustomerPaymentAllocations[@i].InvoiceNo" value="@Model[i].InvoiceNo" />
                                <input type="hidden" name="CustomerPaymentAllocations[@i].InvoiceDate" value="@Model[i].InvoiceDate.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="CustomerPaymentAllocations[@i].DueDate" value="@Model[i].DueDate.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="CustomerPaymentAllocations[@i].OverdueDays" value="@Model[i].OverdueDays" />
                                <input type="hidden" name="CustomerPaymentAllocations[@i].GrandTotal" value="@Model[i].GrandTotal" />
                                <input type="hidden" name="CustomerPaymentAllocations[@i].PaidAmount" value="@Model[i].PaidAmount" />
                                <input type="hidden" name="CustomerPaymentAllocations[@i].PendingAmount" value="@Model[i].PendingAmount" />
                                <input type="hidden" name="CustomerPaymentAllocations[@i].RemainingAmount" value="@Model[i].RemainingAmount" class="owing-amount" />
                                <input type="hidden" name="CustomerPaymentAllocations[@i].DueAmount" value="@Model[i].DueAmount" />
                                <input type="hidden" name="CustomerPaymentAllocations[@i].Remarks" value="@Model[i].Remarks" />
                            </td>

                            <td>@Model[i].InvoiceDate.ToString("dd-MM-yyyy")</td>
                            <td>@Model[i].DueDate.ToString("dd-MM-yyyy")</td>
                            <td class="text-right">
                                @if (Model[i].OverdueDays > 0)
                                {
                                    <span class="text-danger font-weight-bold">@Model[i].OverdueDays d</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-right">@Model[i].GrandTotal.ToString("N2")</td>
                            <td class="text-right">@Model[i].PaidAmount.ToString("N2")</td>
                            <td class="text-right font-weight-bold">@Model[i].RemainingAmount.ToString("N2")</td>

                            <td>
                                <input name="CustomerPaymentAllocations[@i].AllocatedAmount" value="@Model[i].AllocatedAmount"
                                       type="number" step="0.01" min="0" class="form-control allocate-amount" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">
                <i class="fas fa-info-circle"></i>
                Choose a customer above and their open invoices will appear here, oldest debt first.
            </div>
        }

        <div class="row justify-content-end">
            <div class="col-md-5">
                <table class="table table-sm">
                    <tr>
                        <th>Amount Received</th>
                        <td class="text-right" id="sumReceived">0.00</td>
                    </tr>
                    <tr>
                        <th>Allocated</th>
                        <td class="text-right" id="sumAllocated">0.00</td>
                    </tr>
                    <tr class="bg-light">
                        <th>Unallocated Advance</th>
                        <th class="text-right" id="sumUnallocated">0.00</th>
                    </tr>
                </table>
            </div>
        </div>

    </div>

</div>
