@*
    Hold grid behaviour shared by the create and update reservation screens.
*@

<script>

    // The quantity is capped both by what the order still owes and by what is
    // actually free in the warehouse. The server checks the very same two rules.
    function clampHoldQuantity(input) {

        var row = input.closest("tr");
        var holdable = parseFloat(row.find(".holdable-qty").val()) || 0;
        var free = parseFloat(row.find(".free-stock").val()) || 0;
        var value = parseFloat(input.val()) || 0;

        if (value < 0) {
            value = 0;
        }

        if (value > holdable) {

            Swal.fire({
                icon: "warning",
                title: "More Than Ordered",
                text: "Only " + holdable.toFixed(2) + " is still holdable on this line.",
                confirmButtonText: "OK"
            });

            value = holdable;
        }

        if (value > free) {

            Swal.fire({
                icon: "warning",
                title: "Not Enough Free Stock",
                text: "Only " + free + " of this product is free, the rest is already held for someone else.",
                confirmButtonText: "OK"
            });

            value = free;
        }

        input.val(value);
    }

    function recalculateHeldQuantity() {

        var total = 0;

        $("#reservationTableBody tr").each(function () {
            total += parseFloat($(this).find(".hold-qty").val()) || 0;
        });

        $("#sumHeldQuantity").text(total.toFixed(2));
    }

    function buildHoldRows(lines) {

        var body = $("#reservationTableBody").empty();

        $.each(lines, function (i, line) {

            var row = $("<tr>");
            var prefix = "StockReservationItems[" + i + "].";

            var productCell = $("<td>").text(line.productName);
            productCell.append($('<input type="hidden">').attr("name", prefix + "ProductId").val(line.productId));
            productCell.append($('<input type="hidden">').attr("name", prefix + "ProductName").val(line.productName));
            productCell.append($('<input type="hidden">').attr("name", prefix + "UnitName").val(line.unitName));
            productCell.append($('<input type="hidden">').attr("name", prefix + "OrderedQuantity").val(line.orderedQuantity));
            productCell.append($('<input type="hidden">').attr("name", prefix + "AlreadyReservedQuantity").val(line.reservedQuantity));
            productCell.append($('<input type="hidden">').attr("name", prefix + "PendingQuantity").val(line.pendingQuantity));
            productCell.append($('<input type="hidden">').attr("name", prefix + "DeliveredQuantity").val(line.deliveredQuantity));
            productCell.append($('<input type="hidden" class="holdable-qty">').attr("name", prefix + "RemainingQuantity").val(line.remainingQuantity));
            productCell.append($('<input type="hidden">').attr("name", prefix + "CurrentStock").val(line.currentStock));
            productCell.append($('<input type="hidden" class="free-stock">').attr("name", prefix + "AvailableStock").val(line.availableStock));
            productCell.append($('<input type="hidden">').attr("name", prefix + "Remarks").val(""));
            row.append(productCell);

            row.append($("<td>").text(line.unitName || ""));
            row.append($('<td class="text-right">').text(Number(line.orderedQuantity).toFixed(2)));
            row.append($('<td class="text-right">').text(Number(line.deliveredQuantity).toFixed(2)));
            row.append($('<td class="text-right">').text(Number(line.reservedQuantity).toFixed(2)));
            row.append($('<td class="text-right">').text(Number(line.pendingQuantity).toFixed(2)));
            row.append($('<td class="text-right font-weight-bold">').text(Number(line.remainingQuantity).toFixed(2)));
            row.append($('<td class="text-right">').text(line.currentStock));
            row.append($('<td class="text-right">').text(line.availableStock));

            // Suggest whatever can actually be held: the line's outstanding quantity,
            // or the free stock when there is less of that.
            var suggested = Math.min(Number(line.remainingQuantity), Number(line.availableStock));

            row.append($("<td>").append(
                $('<input type="number" step="1" min="0" class="form-control hold-qty">')
                    .attr("name", prefix + "ReservedQuantity")
                    .val(suggested > 0 ? suggested : 0)));

            body.append(row);
        });

        recalculateHeldQuantity();
    }

    $(document).ready(function () {

        recalculateHeldQuantity();

        $(document).on("change", ".hold-qty", function () {
            clampHoldQuantity($(this));
            recalculateHeldQuantity();
        });

        $("#ReservationDate, #ExpiryDate").on("change", function () {

            var reservationDate = $("#ReservationDate").val();
            var expiryDate = $("#ExpiryDate").val();

            if (reservationDate && expiryDate && expiryDate < reservationDate) {
                Swal.fire({
                    icon: "warning",
                    title: "Invalid Date",
                    text: "A hold cannot expire before the day it was made.",
                    confirmButtonText: "OK"
                });

                $("#ExpiryDate").val(reservationDate);
            }
        });

    });

</script>
