                    </div>
                    <div class="card-body">
                        <div id="world-map" style="height: 250px; width: 100%;"></div>
                    </div>
                    <!-- /.card-body-->
                    <div class="card-footer bg-transparent">
                        <div class="row">
                            <div class="col-4 text-center">
                                <div id="sparkline-1"></div>
                                <div class="text-white">Visitors</div>
                            </div>
                            <!-- ./col -->
                            <div class="col-4 text-center">
                                <div id="sparkline-2"></div>
                                <div class="text-white">Online</div>
                            </div>
                            <!-- ./col -->
                            <div class="col-4 text-center">
                                <div id="sparkline-3"></div>
                                <div class="text-white">Sales</div>
                            </div>
                            <!-- ./col -->
                        </div>
                        <!-- /.row -->
                    </div>
                </div>
                <!-- /.card -->
                <!-- Calendar -->
                <div class="card bg-gradient-success">
                    <div class="card-header border-0">

                        <h3 class="card-title">
                            <i class="far fa-calendar-alt"></i>
                            Calendar
                        </h3>
                        <!-- tools card -->
                        <div class="card-tools">
                            <!-- button with a dropdown -->
                            <div class="btn-group">
                                <button type="button" class="btn btn-success btn-sm dropdown-toggle" data-toggle="dropdown" data-offset="-52">
                                    <i class="fas fa-bars"></i>
                                </button>
                                <div class="dropdown-menu" role="menu">
                                    <a href="#" class="dropdown-item">Add new event</a>
                                    <a href="#" class="dropdown-item">Clear events</a>
                                    <div class="dropdown-divider"></div>
                                    <a href="#" class="dropdown-item">View calendar</a>
                                </div>
                            </div>
                            <button type="button" class="btn btn-success btn-sm" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                            <button type="button" class="btn btn-success btn-sm" data-card-widget="remove">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <!-- /. tools -->
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body pt-0">
                        <!--The calendar -->
                        <div id="calendar" style="width: 100%"></div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </section>
            <!-- right col -->
        </div> *@
        <!-- /.row (main row) -->

    </div><!-- /.container-fluid -->
</section>
<!-- /.content -->

@section Scripts {
    @* SignalR is loaded by the layout, which the notification bell needs on every page *@
    
    <script>

        const connection =
        new signalR.HubConnectionBuilder()
            .withUrl("/presenceUserHub")
            .build();

        connection.on("UpdateOnlineUsers", function (count) {
            document.getElementById("activeUsers").innerText = count;
        });

        connection.start()
        .then(() => console.log("Connected"))
        .catch(err => console.error(err));

        //This is my application watch
        function updateClock() {
            const now = new Date();

            const options = {
                weekday: 'short',
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            };

            const date = now.toLocaleDateString('en-US', options);
            const time = now.toLocaleTimeString('en-US');

            document.getElementById("liveClock").innerHTML =
                `<i class="far fa-clock"></i> ${date} | ${time}`;
        }

        updateClock();
        setInterval(updateClock, 1000);

    </script>

    <script>

        // Chart chrome. Recessive grid and muted ink so the bars carry the reading.
        const vizInk = { muted: '#898781', grid: '#e1e0d9', surface: '#ffffff' };

        const formatAmount = value => Number(value).toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

        // ---- In-house stock health ----------------------------------------------
        const stockHealthCanvas = document.getElementById('stockHealthChart');

        if (stockHealthCanvas) {
            const stockHealth = {
                healthy: @Model.StockHealth.HealthyProducts,
                lowStock: @Model.StockHealth.LowStockProducts,
                outOfStock: @Model.StockHealth.OutOfStockProducts
            };

            const stockTotal = stockHealth.healthy + stockHealth.lowStock + stockHealth.outOfStock;

            new Chart(stockHealthCanvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['Healthy', 'Low Stock', 'Out of Stock'],
                    datasets: [{
                        data: [stockHealth.healthy, stockHealth.lowStock, stockHealth.outOfStock],
                        // Status colours, never reused as series colours. The legend below
                        // pairs each one with an icon and a count.
                        backgroundColor: ['#0ca30c', '#fab219', '#d03b3b'],
                        borderColor: vizInk.surface,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutoutPercentage: 68,
                    legend: { display: false },
                    tooltips: {
                        callbacks: {
                            label: (item, data) => {
                                const label = data.labels[item.index];
                                const value = data.datasets[0].data[item.index];
                                const share = stockTotal ? Math.round((value / stockTotal) * 100) : 0;

                                return ' ' + label + ': ' + value + ' products (' + share + '%)';
                            }
                        }
                    }
                }
            });
        }

        // ---- Where the goods sit -------------------------------------------------
        const warehouseStockCanvas = document.getElementById('warehouseStockChart');

        if (warehouseStockCanvas) {
            const warehouses = @Html.Raw(Json.Serialize(Model.WarehouseStock.Warehouses));

            // A long name would eat into the plot, so the axis carries a short form
            // and the tooltip keeps the full one.
            const shortWarehouseName = name => name.length > 24 ? name.slice(0, 23) + '\u2026' : name;

            new Chart(warehouseStockCanvas.getContext('2d'), {
                // Horizontal, because warehouse names read along the axis rather than
                // rotated under it.
                type: 'horizontalBar',
                data: {
                    labels: warehouses.map(x => shortWarehouseName(x.warehouseName)),
                    datasets: [{
                        label: 'Products',
                        // One series, one hue. A colour per warehouse would encode
                        // nothing the label does not already say.
                        data: warehouses.map(x => x.productCount),
                        backgroundColor: '#2a78d6'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    // Room at the right for the count that sits past the end of a bar
                    layout: { padding: { right: 34 } },
                    legend: { display: false },
                    scales: {
                        xAxes: [{
                            gridLines: { color: vizInk.grid, drawBorder: false, zeroLineColor: vizInk.grid },
                            ticks: { beginAtZero: true, fontColor: vizInk.muted, precision: 0 }
                        }],
                        yAxes: [{
                            gridLines: { display: false, drawBorder: false },
                            ticks: { fontColor: vizInk.muted },
                            barPercentage: 0.7,
                            categoryPercentage: 0.8
                        }]
                    },
                    tooltips: {
                        callbacks: {
                            title: items => warehouses[items[0].index].warehouseName,
                            label: item => {
                                const row = warehouses[item.index];

                                return ' ' + row.productCount + ' products, ' +
                                    Number(row.unitsOnHand).toLocaleString('en-US') + ' units on hand';
                            }
                        }
                    }
                },
                plugins: [{
                    // The count sits at the end of its own bar, so no bar has to be
                    // measured against the axis to be read.
                    afterDatasetsDraw: chart => {
                        const ctx = chart.ctx;

                        ctx.font = '600 12px sans-serif';
                        ctx.fillStyle = vizInk.muted;
                        ctx.textAlign = 'left';
                        ctx.textBaseline = 'middle';

                        chart.getDatasetMeta(0).data.forEach((bar, index) => {
                            ctx.fillText(warehouses[index].productCount, bar._model.x + 6, bar._model.y);
                        });
                    }
                }]
            });
        }

        // ---- Sales against purchases --------------------------------------------
        const salesVsPurchaseCanvas = document.getElementById('salesVsPurchaseChart');

        if (salesVsPurchaseCanvas) {
            const fromYearSelect = document.getElementById('salesVsPurchaseFromYear');
            const toYearSelect = document.getElementById('salesVsPurchaseToYear');
            const applyButton = document.getElementById('salesVsPurchaseApply');
            const errorBox = document.getElementById('salesVsPurchaseError');
            const caption = document.getElementById('salesVsPurchaseCaption');
            const totalSalesCell = document.getElementById('salesVsPurchaseTotalSales');
            const totalPurchaseCell = document.getElementById('salesVsPurchaseTotalPurchase');
            const gapCell = document.getElementById('salesVsPurchaseGap');

            const salesVsPurchaseChart = new Chart(salesVsPurchaseCanvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: [],
                    datasets: [
                        { label: 'Sales', data: [], backgroundColor: '#2a78d6' },
                        { label: 'Purchase', data: [], backgroundColor: '#eb6834' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    // Both series are money, so they share one scale. Two axes here would
                    // let any pair of bars be made to cross wherever we liked.
                    scales: {
                        xAxes: [{
                            gridLines: { display: false, drawBorder: false },
                            ticks: { fontColor: vizInk.muted, autoSkip: true, maxRotation: 45 },
                            // Leaves a gap between the two bars of a period and a wider one
                            // between periods, so the pairing is visible without a label.
                            barPercentage: 0.9,
                            categoryPercentage: 0.7
                        }],
                        yAxes: [{
                            gridLines: { color: vizInk.grid, drawBorder: false, zeroLineColor: vizInk.grid },
                            ticks: {
                                beginAtZero: true,
                                fontColor: vizInk.muted,
                                callback: value => Number(value).toLocaleString('en-US')
                            }
                        }]
                    },
                    legend: {
                        position: 'top',
                        align: 'end',
                        labels: { boxWidth: 12, fontColor: vizInk.muted, usePointStyle: true }
                    },
                    tooltips: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            label: (item, data) =>
                                ' ' + data.datasets[item.datasetIndex].label + ': ' + formatAmount(item.yLabel)
                        }
                    }
                }
            });

            // One render path for both the first paint and every filter change, so the
            // two can never drift apart.
            const renderSalesVsPurchase = chart => {
                salesVsPurchaseChart.data.labels = chart.points.map(x => x.label);
                salesVsPurchaseChart.data.datasets[0].data = chart.points.map(x => x.salesAmount);
                salesVsPurchaseChart.data.datasets[1].data = chart.points.map(x => x.purchaseAmount);
                salesVsPurchaseChart.update();

                const perBar = chart.granularityName === 'Year' ? 'one year' : 'one month';
                const runningNote = chart.endsOnRunningYear
                    ? ' The last period is still running, so it is not a full one yet.'
                    : '';

                caption.textContent = 'One bar covers ' + perBar + ', ' +
                    chart.fromYear + ' to ' + chart.toYear + '.' + runningNote;

                totalSalesCell.textContent = formatAmount(chart.totalSales);
                totalPurchaseCell.textContent = formatAmount(chart.totalPurchase);

                // The arrow and the sign carry the direction; the colour only reinforces it.
                const gapUp = chart.gap >= 0;
                gapCell.style.color = gapUp ? '#006300' : '#d03b3b';
                gapCell.innerHTML = '<i class="fas fa-arrow-' + (gapUp ? 'up' : 'down') + '"></i> ' +
                    formatAmount(chart.gap);
            };

            const showError = message => {
                errorBox.textContent = message;
                errorBox.style.display = '';
            };

            const applyFilter = () => {
                const fromYear = Number(fromYearSelect.value);
                const toYear = Number(toYearSelect.value);

                // Caught here as well as on the server, so an obvious mistake costs no
                // round trip.
                if (toYear < fromYear) {
                    showError('The end year cannot be earlier than the start year.');
                    return;
                }

                errorBox.style.display = 'none';
                applyButton.disabled = true;

                const url = '@Url.Action("SalesVsPurchase", "Dashboard", new { area = "Admin" })' +
                    '?fromYear=' + fromYear + '&toYear=' + toYear;

                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(response => response.json())
                    .then(payload => {
                        if (payload.success) {
                            renderSalesVsPurchase(payload.chart);
                        } else {
                            showError(payload.message);
                        }
                    })
                    .catch(() => showError('The chart could not be loaded.'))
                    .finally(() => { applyButton.disabled = false; });
            };

            applyButton.addEventListener('click', applyFilter);

            // The model is handed over in the same shape the filter endpoint returns.
            renderSalesVsPurchase(@Html.Raw(Json.Serialize(Model.SalesVsPurchase)));
        }

        // ---- Who sold what -------------------------------------------------------
        const salespersonSalesCanvas = document.getElementById('salespersonSalesChart');

        if (salespersonSalesCanvas) {
            const sellerYearSelect = document.getElementById('salespersonSalesYear');
            const sellerApplyButton = document.getElementById('salespersonSalesApply');
            const sellerErrorBox = document.getElementById('salespersonSalesError');
            const sellerCaption = document.getElementById('salespersonSalesCaption');
            const sellerEmptyNote = document.getElementById('salespersonSalesEmpty');
            const sellerScroll = document.getElementById('salespersonSalesScroll');
            const sellerPlot = document.getElementById('salespersonSalesPlot');
            const sellerTotalCell = document.getElementById('salespersonSalesTotal');
            const sellerInvoicesCell = document.getElementById('salespersonSalesInvoices');
            const sellerCountCell = document.getElementById('salespersonSalesSellers');
            const sellerTopCell = document.getElementById('salespersonSalesTop');

            // Whatever the year holds, this is what the tooltip and the end-of-bar label
            // read off, so the two can never disagree.
            let sellerRows = [];

            // A long name would eat into the plot, so the axis carries a short form and
            // the tooltip keeps the full one.
            const shortSellerName = name => name.length > 24 ? name.slice(0, 23) + '…' : name;

            const salespersonSalesChart = new Chart(salespersonSalesCanvas.getContext('2d'), {
                // Horizontal, because names read along the axis rather than rotated
                // under it.
                type: 'horizontalBar',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Sales',
                        // One series, one hue. A colour per person would encode nothing
                        // the name beside the bar does not already say.
                        data: [],
                        backgroundColor: '#0ca30c'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    // Room at the right for the amount that sits past the end of a bar
                    layout: { padding: { right: 90 } },
                    legend: { display: false },
                    scales: {
                        xAxes: [{
                            gridLines: { color: vizInk.grid, drawBorder: false, zeroLineColor: vizInk.grid },
                            ticks: {
                                beginAtZero: true,
                                fontColor: vizInk.muted,
                                callback: value => Number(value).toLocaleString('en-US')
                            }
                        }],
                        yAxes: [{
                            gridLines: { display: false, drawBorder: false },
                            ticks: { fontColor: vizInk.muted },
                            barPercentage: 0.7,
                            categoryPercentage: 0.8
                        }]
                    },
                    tooltips: {
                        callbacks: {
                            title: items => sellerRows[items[0].index].salespersonName,
                            label: item => {
                                const row = sellerRows[item.index];
                                const invoices = row.invoiceCount === 1 ? ' invoice' : ' invoices';

                                return ' ' + formatAmount(row.invoicedAmount) +
                                    ' over ' + row.invoiceCount + invoices;
                            }
                        }
                    }
                },
                plugins: [{
                    // The amount sits at the end of its own bar, so no bar has to be
                    // measured against the axis to be read.
                    afterDatasetsDraw: chart => {
                        const ctx = chart.ctx;

                        ctx.font = '600 12px sans-serif';
                        ctx.fillStyle = vizInk.muted;
                        ctx.textAlign = 'left';
                        ctx.textBaseline = 'middle';

                        chart.getDatasetMeta(0).data.forEach((bar, index) => {
                            ctx.fillText(formatAmount(sellerRows[index].invoicedAmount),
                                bar._model.x + 6, bar._model.y);
                        });
                    }
                }]
            });

            // One render path for both the first paint and every filter change, so the
            // two can never drift apart.
            const renderSalespersonSales = chart => {
                sellerRows = chart.points;

                const hasBars = sellerRows.length > 0;
                sellerEmptyNote.style.display = hasBars ? 'none' : '';
                sellerScroll.style.display = hasBars ? '' : 'none';

                salespersonSalesChart.data.labels = sellerRows.map(x => shortSellerName(x.salespersonName));
                salespersonSalesChart.data.datasets[0].data = sellerRows.map(x => x.invoicedAmount);

                // Grown a row at a time, so the bars keep one thickness however many
                // people sold that year.
                sellerPlot.style.height = Math.max(200, sellerRows.length * 38) + 'px';
                salespersonSalesChart.resize();
                salespersonSalesChart.update();

                const runningNote = chart.isRunningYear
                    ? ' This year is still running, so it is not a full one yet.'
                    : '';

                sellerCaption.textContent = 'A bar covers the whole of ' + chart.year + '.' + runningNote;

                sellerTotalCell.textContent = formatAmount(chart.totalSales);
                sellerInvoicesCell.textContent = Number(chart.totalInvoices).toLocaleString('en-US');
                sellerCountCell.textContent = chart.sellerCount;
                sellerTopCell.textContent = hasBars ? chart.topSellerName : '—';
            };

            const showSellerError = message => {
                sellerErrorBox.textContent = message;
                sellerErrorBox.style.display = '';
            };

            const applySellerFilter = () => {
                sellerErrorBox.style.display = 'none';
                sellerApplyButton.disabled = true;

                const url = '@Url.Action("SalesBySalesperson", "Dashboard", new { area = "Admin" })' +
                    '?year=' + Number(sellerYearSelect.value);

                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(response => response.json())
                    .then(payload => {
                        if (payload.success) {
                            renderSalespersonSales(payload.chart);
                        } else {
                            showSellerError(payload.message);
                        }
                    })
                    .catch(() => showSellerError('The chart could not be loaded.'))
                    .finally(() => { sellerApplyButton.disabled = false; });
            };

            sellerApplyButton.addEventListener('click', applySellerFilter);

            // The model is handed over in the same shape the filter endpoint returns.
            renderSalespersonSales(@Html.Raw(Json.Serialize(Model.SalespersonSales)));
        }

        // ---- Where we buy --------------------------------------------------------
        const supplierPurchaseCanvas = document.getElementById('supplierPurchaseChart');

        if (supplierPurchaseCanvas) {
            const supplierYearSelect = document.getElementById('supplierPurchaseYear');
            const supplierApplyButton = document.getElementById('supplierPurchaseApply');
            const supplierErrorBox = document.getElementById('supplierPurchaseError');
            const supplierCaption = document.getElementById('supplierPurchaseCaption');
            const supplierEmptyNote = document.getElementById('supplierPurchaseEmpty');
            const supplierScroll = document.getElementById('supplierPurchaseScroll');
            const supplierPlot = document.getElementById('supplierPurchasePlot');
            const supplierTotalCell = document.getElementById('supplierPurchaseTotal');
            const supplierInvoicesCell = document.getElementById('supplierPurchaseInvoices');
            const supplierCountCell = document.getElementById('supplierPurchaseCount');
            const supplierTopCell = document.getElementById('supplierPurchaseTop');

            // Whatever the year holds, this is what the tooltip and the end-of-bar label
            // read off, so the two can never disagree.
            let supplierRows = [];

            // A long name would eat into the plot, so the axis carries a short form and
            // the tooltip keeps the full one.
            const shortSupplierName = name => name.length > 24 ? name.slice(0, 23) + '…' : name;

            const supplierPurchaseChart = new Chart(supplierPurchaseCanvas.getContext('2d'), {
                // Horizontal, because supplier names read along the axis rather than
                // rotated under it.
                type: 'horizontalBar',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Purchase',
                        // The same orange the Sales vs Purchase chart gives purchases, so
                        // the buying side keeps one colour across the dashboard.
                        data: [],
                        backgroundColor: '#eb6834'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    // Room at the right for the amount that sits past the end of a bar
                    layout: { padding: { right: 90 } },
                    legend: { display: false },
                    scales: {
                        xAxes: [{
                            gridLines: { color: vizInk.grid, drawBorder: false, zeroLineColor: vizInk.grid },
                            ticks: {
                                beginAtZero: true,
                                fontColor: vizInk.muted,
                                callback: value => Number(value).toLocaleString('en-US')
                            }
                        }],
                        yAxes: [{
                            gridLines: { display: false, drawBorder: false },
                            ticks: { fontColor: vizInk.muted },
                            barPercentage: 0.7,
                            categoryPercentage: 0.8
                        }]
                    },
                    tooltips: {
                        callbacks: {
                            title: items => supplierRows[items[0].index].supplierName,
                            label: item => {
                                const row = supplierRows[item.index];
                                const invoices = row.invoiceCount === 1 ? ' invoice' : ' invoices';

                                return ' ' + formatAmount(row.purchasedAmount) +
                                    ' over ' + row.invoiceCount + invoices;
                            }
                        }
                    }
                },
                plugins: [{
                    // The amount sits at the end of its own bar, so no bar has to be
                    // measured against the axis to be read.
                    afterDatasetsDraw: chart => {
                        const ctx = chart.ctx;

                        ctx.font = '600 12px sans-serif';
                        ctx.fillStyle = vizInk.muted;
                        ctx.textAlign = 'left';
                        ctx.textBaseline = 'middle';

                        chart.getDatasetMeta(0).data.forEach((bar, index) => {
                            ctx.fillText(formatAmount(supplierRows[index].purchasedAmount),
                                bar._model.x + 6, bar._model.y);
                        });
                    }
                }]
            });

            // One render path for both the first paint and every filter change, so the
            // two can never drift apart.
            const renderSupplierPurchase = chart => {
                supplierRows = chart.points;

                const hasBars = supplierRows.length > 0;
                supplierEmptyNote.style.display = hasBars ? 'none' : '';
                supplierScroll.style.display = hasBars ? '' : 'none';

                supplierPurchaseChart.data.labels = supplierRows.map(x => shortSupplierName(x.supplierName));
                supplierPurchaseChart.data.datasets[0].data = supplierRows.map(x => x.purchasedAmount);

                // Grown a row at a time, so the bars keep one thickness however many
                // suppliers billed that year.
                supplierPlot.style.height = Math.max(200, supplierRows.length * 38) + 'px';
                supplierPurchaseChart.resize();
                supplierPurchaseChart.update();

                const runningNote = chart.isRunningYear
                    ? ' This year is still running, so it is not a full one yet.'
                    : '';

                supplierCaption.textContent = 'A bar covers the whole of ' + chart.year + '.' + runningNote;

                supplierTotalCell.textContent = formatAmount(chart.totalPurchase);
                supplierInvoicesCell.textContent = Number(chart.totalInvoices).toLocaleString('en-US');
                supplierCountCell.textContent = chart.supplierCount;

                // The share says whether the buying is spread about or leaning on one
                // supplier, which the name on its own does not.
                supplierTopCell.textContent = hasBars
                    ? chart.topSupplierName + ' (' + chart.topSupplierShare + '%)'
                    : '—';
            };

            const showSupplierError = message => {
                supplierErrorBox.textContent = message;
                supplierErrorBox.style.display = '';
            };

            const applySupplierFilter = () => {
                supplierErrorBox.style.display = 'none';
                supplierApplyButton.disabled = true;

                const url = '@Url.Action("PurchasesBySupplier", "Dashboard", new { area = "Admin" })' +
                    '?year=' + Number(supplierYearSelect.value);

                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(response => response.json())
                    .then(payload => {
                        if (payload.success) {
                            renderSupplierPurchase(payload.chart);
                        } else {
                            showSupplierError(payload.message);
                        }
                    })
                    .catch(() => showSupplierError('The chart could not be loaded.'))
                    .finally(() => { supplierApplyButton.disabled = false; });
            };

            supplierApplyButton.addEventListener('click', applySupplierFilter);

            // The model is handed over in the same shape the filter endpoint returns.
            renderSupplierPurchase(@Html.Raw(Json.Serialize(Model.SupplierPurchase)));
        }


    </script>
}
