@model DashboardViewModel;

@{
    ViewData["Title"] = "Dashboard";
}

<!-- Content Header (Page header) -->

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">

            <!-- Left -->
            <div class="col-md-4">
                <h1 class="m-0">Dashboard</h1>
            </div>

            <!-- Center -->
            <div class="col-md-4 text-center">
                <h4 id="liveClock" class="mb-0 font-weight-bold text-primary"></h4>
            </div>

            <!-- Right -->
            <div class="col-md-4">
                <ol class="breadcrumb float-sm-right mb-0">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Dashboard</li>
                </ol>
            </div>

        </div>
    </div>
</div>


<!-- /.content-header -->
<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <!-- Small boxes (Stat box) -->
        <div class="row">
            
            <!-- Total Products -->
            <div class="col-lg-3 col-6"> <!-- small box --> 
                <div class="small-box bg-info"> 
                    <div class="inner"> 
                        <h3>@Model.TotalProducts</h3> 
                        <p>Available Products</p> 
                    </div>
                        <div class="icon">
                        <i class="fas fa-boxes"></i>
                    </div> 
                    <a href="#" class="small-box-footer">More info 
                        <i class="fas fa-arrow-circle-right"></i></a> 
                   </div>
            </div>

            <!-- Total Categories -->
            <div class="col-lg-3 col-6">
                <div class="small-box bg-orange">
                    <div class="inner">
                        <h3 class="text-white">@Model.TotalCategoris</h3>
                        <p>Categories</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-tags"></i>
                    </div>
                    <a href="#" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@Model.EngagementRate<sup style="font-size: 20px">%</sup></h3>

                        <p>Engagement Rate</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-stats-bars"></i>
                    </div>
                    <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>

            <!-- ./col -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@Model.BounceRate<sup style="font-size: 20px">%</sup></h3>
                        <p>Bounce Rate</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-stats-bars"></i>
                    </div>
                    <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>

            <!-- ./col -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-teal">
                    <div class="inner">
                        <h3>@Model.TotalWarehouse</h3>
                        <p>Warehouse</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-warehouse"></i>
                    </div>
                    <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>

            <!-- ./col -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-secondary">
                    <div class="inner">
                        <h3>@Model.ActiveUsers</h3>

                        <p>Active Users</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-person-add"></i>
                    </div>
                    <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>

            <!-- ./col -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-teal">
                    <div class="inner">
                        <h3 id="activeUsers">0</h3>
                        <p>Online Users</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-person-add"></i>
                    </div>
                    <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>

            <!-- ./col -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3 class="text-white">@Model.TotalUsers</h3>

                        <p>User Registrations</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-person-add"></i>
                    </div>
                    <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>

            <!-- ./col -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h3>@Model.UniqueVisitors</h3>

                        <p>Unique Visitors</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-pie-graph"></i>
                    </div>
                    <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>

            <!-- ./col -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@Model.TotalBrands</h3>

                        <p>Brands</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-tags"></i>
                    </div>
                    <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <!-- ./col -->
        </div>



        <!-- Analysis charts -->
        <div class="row">

            <!-- In-house stock health -->
            <div class="col-lg-5">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-warehouse mr-1"></i>
                            In-House Stock Health
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.StockHealth.TotalProducts == 0)
                        {
                            <p class="text-muted text-center my-5">
                                No products in house yet, so there is nothing to chart.
                            </p>
                        }
                        else
                        {
                            <div style="position: relative; height: 240px;">
                                <canvas id="stockHealthChart"></canvas>
                                <!-- The ring shows the split; the middle keeps the total readable -->
                                <div class="text-center"
                                     style="position: absolute; top: 50%; left: 0; right: 0; transform: translateY(-50%); pointer-events: none;">
                                    <div style="font-size: 28px; font-weight: 600; line-height: 1.1;">
                                        @Model.StockHealth.TotalProducts
                                    </div>
                                    <div class="text-muted" style="font-size: 12px;">products</div>
                                </div>
                            </div>

                            <!-- Legend carries the count beside the swatch, so no slice is read by colour alone -->
                            <div class="row text-center mt-3">
                                <div class="col-4">
                                    <i class="fas fa-check-circle" style="color: #0ca30c;"></i>
                                    <div class="text-muted" style="font-size: 12px;">Healthy</div>
                                    <strong>@Model.StockHealth.HealthyProducts</strong>
                                </div>
                                <div class="col-4">
                                    <i class="fas fa-exclamation-triangle" style="color: #fab219;"></i>
                                    <div class="text-muted" style="font-size: 12px;">Low Stock</div>
                                    <strong>@Model.StockHealth.LowStockProducts</strong>
                                </div>
                                <div class="col-4">
                                    <i class="fas fa-times-circle" style="color: #d03b3b;"></i>
                                    <div class="text-muted" style="font-size: 12px;">Out of Stock</div>
                                    <strong>@Model.StockHealth.OutOfStockProducts</strong>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 12px;">Units On Hand</div>
                                <strong>@Model.StockHealth.UnitsOnHand.ToString("N0")</strong>
                            </div>
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 12px;">Reserved</div>
                                <strong>@Model.StockHealth.UnitsReserved.ToString("N0")</strong>
                            </div>
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 12px;">Available</div>
                                <strong>@Model.StockHealth.UnitsAvailable.ToString("N0")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sales against purchases -->
            <div class="col-lg-7">
                <div class="card card-outline card-info">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-bar mr-1"></i>
                            Sales vs Purchase
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>

                    <!-- The filter sits in one row directly above the chart it drives -->
                    <div class="card-body pb-0">
                        <div class="form-row align-items-end">
                            <div class="col-auto">
                                <label for="salesVsPurchaseFromYear" class="text-muted mb-1"
                                       style="font-size: 12px;">From Year</label>
                                <select id="salesVsPurchaseFromYear" class="form-control form-control-sm">
                                    @foreach (var year in Model.AvailableYears)
                                    {
                                        <option value="@year" selected="@(year == Model.SalesVsPurchase.FromYear)">@year</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <label for="salesVsPurchaseToYear" class="text-muted mb-1"
                                       style="font-size: 12px;">To Year</label>
                                <select id="salesVsPurchaseToYear" class="form-control form-control-sm">
                                    @foreach (var year in Model.AvailableYears)
                                    {
                                        <option value="@year" selected="@(year == Model.SalesVsPurchase.ToYear)">@year</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="button" id="salesVsPurchaseApply" class="btn btn-sm btn-info">
                                    <i class="fas fa-filter mr-1"></i>
                                    Apply
                                </button>
                            </div>
                        </div>

                        <div id="salesVsPurchaseError" class="alert alert-warning py-1 px-2 mt-2 mb-0"
                             style="font-size: 12px; display: none;"></div>
                    </div>

                    <div class="card-body">
                        <div style="position: relative; height: 300px;">
                            <canvas id="salesVsPurchaseChart"></canvas>
                        </div>
                        <!-- Says which period one bar covers, so a wide range is never mistaken for a narrow one -->
                        <p id="salesVsPurchaseCaption" class="text-muted mb-0 mt-2" style="font-size: 12px;"></p>
                        <p class="text-muted mb-0" style="font-size: 12px;">
                            Both sides are read off posted invoices only, so a draft or a
                            cancelled document never shows up here.
                        </p>
                    </div>

                    <div class="card-footer bg-transparent">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 12px;">Total Sales</div>
                                <strong id="salesVsPurchaseTotalSales"></strong>
                            </div>
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 12px;">Total Purchase</div>
                                <strong id="salesVsPurchaseTotalPurchase"></strong>
                            </div>
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 12px;">Sales &minus; Purchase</div>
                                <strong id="salesVsPurchaseGap"></strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Who sold what -->
        <div class="row">
            <div class="col-12">
                <div class="card card-outline card-success">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user-tie mr-1"></i>
                            Sales by Salesperson
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>

                    <!-- One year at a time: a bar is a person's whole year, so mixing two
                         years into one bar would say nothing useful -->
                    <div class="card-body pb-0">
                        <div class="form-row align-items-end">
                            <div class="col-auto">
                                <label for="salespersonSalesYear" class="text-muted mb-1"
                                       style="font-size: 12px;">Year</label>
                                <select id="salespersonSalesYear" class="form-control form-control-sm">
                                    @foreach (var year in Model.AvailableYears)
                                    {
                                        <option value="@year" selected="@(year == Model.SalespersonSales.Year)">@year</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="button" id="salespersonSalesApply" class="btn btn-sm btn-success">
                                    <i class="fas fa-filter mr-1"></i>
                                    Apply
                                </button>
                            </div>
                        </div>

                        <div id="salespersonSalesError" class="alert alert-warning py-1 px-2 mt-2 mb-0"
                             style="font-size: 12px; display: none;"></div>
                    </div>

                    <div class="card-body">
                        <!-- Said out loud rather than left as a blank chart, because an empty
                             plot area reads as a fault -->
                        <p id="salespersonSalesEmpty" class="text-muted text-center my-5" style="display: none;">
                            Nobody billed anything in this year, so there is nothing to chart.
                        </p>

                        <!-- Grows a row at a time, so a bar keeps the same thickness whether
                             two people sold or twenty -->
                        <div id="salespersonSalesScroll" style="max-height: 420px; overflow-y: auto;">
                            <div id="salespersonSalesPlot" style="position: relative; height: 240px;">
                                <canvas id="salespersonSalesChart"></canvas>
                            </div>
                        </div>

                        <p id="salespersonSalesCaption" class="text-muted mb-0 mt-2" style="font-size: 12px;"></p>
                        <p class="text-muted mb-0" style="font-size: 12px;">
                            A bar is what that salesperson billed, not what has been collected
                            from it. Only posted invoices count, the same ones the Sales vs
                            Purchase chart reads.
                        </p>
                    </div>

                    <div class="card-footer bg-transparent">
                        <div class="row text-center">
                            <div class="col-3">
                                <div class="text-muted" style="font-size: 12px;">Total Sales</div>
                                <strong id="salespersonSalesTotal"></strong>
                            </div>
                            <div class="col-3">
                                <div class="text-muted" style="font-size: 12px;">Invoices</div>
                                <strong id="salespersonSalesInvoices"></strong>
                            </div>
                            <div class="col-3">
                                <div class="text-muted" style="font-size: 12px;">Sellers</div>
                                <strong id="salespersonSalesSellers"></strong>
                            </div>
                            <div class="col-3">
                                <div class="text-muted" style="font-size: 12px;">Top Seller</div>
                                <strong id="salespersonSalesTop"></strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Where we buy -->
        <div class="row">
            <div class="col-12">
                <div class="card card-outline card-warning">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-industry mr-1"></i>
                            Purchases by Supplier
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>

                    <!-- One year at a time: a bar is a supplier's whole year, so mixing two
                         years into one bar would say nothing useful -->
                    <div class="card-body pb-0">
                        <div class="form-row align-items-end">
                            <div class="col-auto">
                                <label for="supplierPurchaseYear" class="text-muted mb-1"
                                       style="font-size: 12px;">Year</label>
                                <select id="supplierPurchaseYear" class="form-control form-control-sm">
                                    @foreach (var year in Model.AvailableYears)
                                    {
                                        <option value="@year" selected="@(year == Model.SupplierPurchase.Year)">@year</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="button" id="supplierPurchaseApply" class="btn btn-sm btn-warning">
                                    <i class="fas fa-filter mr-1"></i>
                                    Apply
                                </button>
                            </div>
                        </div>

                        <div id="supplierPurchaseError" class="alert alert-warning py-1 px-2 mt-2 mb-0"
                             style="font-size: 12px; display: none;"></div>
                    </div>

                    <div class="card-body">
                        <!-- Said out loud rather than left as a blank chart, because an empty
                             plot area reads as a fault -->
                        <p id="supplierPurchaseEmpty" class="text-muted text-center my-5" style="display: none;">
                            Nothing was bought in this year, so there is nothing to chart.
                        </p>

                        <!-- Grows a row at a time, so a bar keeps the same thickness whether
                             two suppliers billed or twenty -->
                        <div id="supplierPurchaseScroll" style="max-height: 420px; overflow-y: auto;">
                            <div id="supplierPurchasePlot" style="position: relative; height: 240px;">
                                <canvas id="supplierPurchaseChart"></canvas>
                            </div>
                        </div>

                        <p id="supplierPurchaseCaption" class="text-muted mb-0 mt-2" style="font-size: 12px;"></p>
                        <p class="text-muted mb-0" style="font-size: 12px;">
                            A bar is what that supplier billed us, not what has been paid to
                            them. Only posted invoices count, the same ones the Sales vs
                            Purchase chart reads.
                        </p>
                    </div>

                    <div class="card-footer bg-transparent">
                        <div class="row text-center">
                            <div class="col-3">
                                <div class="text-muted" style="font-size: 12px;">Total Purchase</div>
                                <strong id="supplierPurchaseTotal"></strong>
                            </div>
                            <div class="col-3">
                                <div class="text-muted" style="font-size: 12px;">Invoices</div>
                                <strong id="supplierPurchaseInvoices"></strong>
                            </div>
                            <div class="col-3">
                                <div class="text-muted" style="font-size: 12px;">Suppliers</div>
                                <strong id="supplierPurchaseCount"></strong>
                            </div>
                            <div class="col-3">
                                <!-- Everything coming from one place is a risk worth seeing,
                                     so the biggest supplier carries its share of the spend -->
                                <div class="text-muted" style="font-size: 12px;">Top Supplier</div>
                                <strong id="supplierPurchaseTop"></strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Where the goods sit -->
        <div class="row">
            <div class="col-12">
                <div class="card card-outline card-teal">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-warehouse mr-1"></i>
                            Products by Warehouse
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.WarehouseStock.TotalWarehouses == 0)
                        {
                            <p class="text-muted text-center my-5">
                                No warehouses have been set up yet, so there is nothing to chart.
                            </p>
                        }
                        else
                        {
                            <!-- Grows a row at a time, so a bar keeps the same thickness whether
                                 there are three warehouses or thirty -->
                            <div style="max-height: 420px; overflow-y: auto;">
                                <div style="position: relative; height: @(Math.Max(200, Model.WarehouseStock.TotalWarehouses * 38))px;">
                                    <canvas id="warehouseStockChart"></canvas>
                                </div>
                            </div>
                            <p class="text-muted mb-0 mt-2" style="font-size: 12px;">
                                A bar counts the products stored at that warehouse, not the units on
                                its shelves. Hover a bar for both figures.
                            </p>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 12px;">Warehouses</div>
                                <strong>@Model.WarehouseStock.TotalWarehouses</strong>
                            </div>
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 12px;">Holding Products</div>
                                <strong>@Model.WarehouseStock.WarehousesInUse</strong>
                            </div>
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 12px;">Not Assigned</div>
                                <strong>@Model.WarehouseStock.UnassignedProducts</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main row -->
        @* <div class="row">
            <!-- Left col -->
            <section class="col-lg-7 connectedSortable">
                <!-- Custom tabs (Charts with tabs)-->
                <div class="card">
                    <div class="card-header">
