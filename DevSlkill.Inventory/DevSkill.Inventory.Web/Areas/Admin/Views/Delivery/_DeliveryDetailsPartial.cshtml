<div class="modal fade" id="deliveryDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h5 class="modal-title">Delivery Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Delivery No</dt>
                            <dd class="col-sm-7" id="DlDeliveryNo"></dd>

                            <dt class="col-sm-5">Proforma Invoice</dt>
                            <dd class="col-sm-7" id="DlProformaNo"></dd>

                            <dt class="col-sm-5">Customer</dt>
                            <dd class="col-sm-7" id="DlCustomer"></dd>

                            <dt class="col-sm-5">Warehouse</dt>
                            <dd class="col-sm-7" id="DlWarehouse"></dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Delivery Date</dt>
                            <dd class="col-sm-7" id="DlDeliveryDate"></dd>

                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7" id="DlStatus"></dd>

                            <dt class="col-sm-5">Received By</dt>
                            <dd class="col-sm-7" id="DlReceivedBy"></dd>

                            <dt class="col-sm-5">Created By</dt>
                            <dd class="col-sm-7" id="DlCreatedBy"></dd>
                        </dl>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th class="text-center" width="5%">#</th>
                                <th>Product</th>
                                <th class="text-center">Ordered</th>
                                <th class="text-center">Delivered</th>
                                <th class="text-center">Remaining On This Line</th>
                            </tr>
                        </thead>
                        <tbody id="deliveryItemsTable"></tbody>
                    </table>
                </div>

                <dl class="row">
                    <dt class="col-sm-2">Notes</dt>
                    <dd class="col-sm-10" id="DlNotes"></dd>
                </dl>

            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
