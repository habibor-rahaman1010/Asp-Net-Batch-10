@{
    ViewData["Title"] = "Delivery List";
}

@section Styles {
    <!-- DataTables -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>All Delivery List</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Sales</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">All delivery record are here!</h3>

                        <a asp-area="Admin" asp-controller="Delivery" asp-action="CreateDelivery" class="btn btn-primary float-right">
                            <i class="fas fa-plus"></i> Add Delivery
                        </a>
                    </div>

                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="delivery" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Delivery No</th>
                                    <th>Proforma No</th>
                                    <th>Customer</th>
                                    <th>Delivery Date</th>
                                    <th>Warehouse</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Delivery No</th>
                                    <th>Proforma No</th>
                                    <th>Customer</th>
                                    <th>Delivery Date</th>
                                    <th>Warehouse</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="_DeliveryDetailsPartial" />

@section Scripts {
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script type="text/javascript">
        $(function () {
            try {
                $("#delivery").DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    ajax: {
                        url: "/Admin/Delivery/GetDeliveryJsonData",
                        type: "POST",
                        contentType: "application/json",
                        dataType: "json",
                        data: function (d) {
                            return JSON.stringify(d);
                        },
                    },
                    columnDefs: [
                        {
                            orderable: false,
                            targets: 6,
                            render: function (data, type, row) {

                                var status = row[5];

                                // A draft is still paper: it can be corrected, released or thrown away.
                                if (status === 'Draft') {
                                    return `<a href="/Admin/Delivery/UpdateDelivery/${data}"
                                               class="btn btn-info btn-sm mr-1">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <button type="button" class="btn btn-success btn-sm mr-1 confirm-delivery" data-id='${data}'>
                                                <i class="fas fa-truck"></i> Confirm
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm show-bs-modal" data-id='${data}'>
                                                <i class="fas fa-trash"></i> Delete
                                            </button>`;
                                }

                                // A confirmed delivery already moved stock, so cancelling is the only way back.
                                if (status === 'Confirmed') {
                                    return `<button type="button" class="btn btn-warning btn-sm cancel-delivery" data-id='${data}'>
                                                <i class="fas fa-undo"></i> Cancel
                                            </button>`;
                                }

                                return `<button type="button" class="btn btn-danger btn-sm show-bs-modal" data-id='${data}'>
                                            <i class="fas fa-trash"></i> Delete
                                        </button>`;
                            }
                        },
                        {
                            targets: 5,
                            render: function (data) {
                                var cls = 'badge-secondary';

                                if (data === 'Confirmed') cls = 'badge-success';
                                else if (data === 'Draft') cls = 'badge-info';
                                else if (data === 'Cancelled') cls = 'badge-danger';

                                return `<span class="badge ${cls}">${data}</span>`;
                            }
                        },
                        ...[0, 1, 2, 3, 4, 5].map(function (target) {
                            return {
                                targets: target,
                                createdCell: function (td, cellData, rowData) {
                                    $(td).addClass('table-row');
                                    $(td).attr('data-id', rowData[6]);
                                }
                            };
                        })
                    ],
                    dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                    "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
                }).buttons().container().appendTo('#delivery_wrapper .col-md-6:eq(0)');
            } catch (e) {
                console.error("DataTable init error:", e);
            }
        });

        // Row click -> details modal
        $(function () {
            $('#delivery tbody').on('click', '.table-row', function () {
                var id = $(this).data("id");

                $.ajax({
                    url: `/Admin/Delivery/GetDeliveryDetails?id=${id}`,
                    type: 'GET',
                    success: function (data) {
                        $('#DlDeliveryNo').text(data.deliveryNo || 'N/A');
                        $('#DlProformaNo').text(data.proformaNo || 'N/A');
                        $('#DlCustomer').text(
                            data.customerName ? `${data.customerName} (${data.customerCode})` : 'N/A');
                        $('#DlWarehouse').text(data.warehouse || 'N/A');
                        $('#DlDeliveryDate').text(
                            data.deliveryDate ? new Date(data.deliveryDate).toLocaleDateString() : 'N/A');
                        $('#DlStatus').text(data.status || 'N/A');
                        $('#DlReceivedBy').text(data.receivedBy || 'N/A');
                        $('#DlCreatedBy').text(data.createdBy || 'N/A');
                        $('#DlNotes').text(data.notes || 'N/A');

                        let rows = '';

                        if (data.deliveryItems && data.deliveryItems.length > 0) {
                            data.deliveryItems.forEach(function (item, index) {
                                rows += `
                                    <tr>
                                        <td class="text-center">${index + 1}</td>
                                        <td>${item.productName ?? 'N/A'}</td>
                                        <td class="text-center">
                                            ${Number(item.orderedQuantity ?? 0).toFixed(2)} ${item.unitName ?? ''}
                                        </td>
                                        <td class="text-center">${Number(item.deliveredQuantity ?? 0).toFixed(2)}</td>
                                        <td class="text-center">${Number(item.remainingQuantity ?? 0).toFixed(2)}</td>
                                    </tr>`;
                            });
                        } else {
                            rows = `<tr><td colspan="5" class="text-center">No Product Found</td></tr>`;
                        }

                        $("#deliveryItemsTable").html(rows);
                        $('#deliveryDetailModal').modal('show');
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) {
                            window.location.href = '/Account/AccessDenied';
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error!', text: 'Failed to load delivery details.' });
                        }
                    }
                });
            });
        });

        // One helper for every action that changes a delivery on the server.
        function postDeliveryAction(url, id, successTitle) {

            $.ajax({
                url: url,
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: successTitle,
                            text: response.message,
                            timer: 2500,
                            showConfirmButton: false
                        });

                        $('#delivery').DataTable().ajax.reload(null, false);
                    } else {
                        Swal.fire({ icon: 'error', title: 'Failed!', text: response.message });
                    }
                },
                error: function (error) {
                    if (error.status === 403) {
                        window.location.href = '/Account/AccessDenied';
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: 'The delivery action could not be completed!' });
                    }
                }
            });
        }

        // Confirm handler
        $(function () {
            $('#delivery').on('click', '.confirm-delivery', function (e) {

                e.stopPropagation();

                let id = $(this).data("id");

                Swal.fire({
                    title: 'Confirm this delivery?',
                    text: "The stock of every line will leave the warehouse.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Confirm',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postDeliveryAction('/Admin/Delivery/ConfirmDelivery', id, 'Confirmed!');
                    }
                });
            });
        });

        // Cancel handler
        $(function () {
            $('#delivery').on('click', '.cancel-delivery', function (e) {

                e.stopPropagation();

                let id = $(this).data("id");

                Swal.fire({
                    title: 'Cancel this delivery?',
                    text: "The delivered stock will be returned to the warehouse.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ffc107',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Cancel It',
                    cancelButtonText: 'Close'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postDeliveryAction('/Admin/Delivery/CancelDelivery', id, 'Cancelled!');
                    }
                });
            });
        });

        // Delete handler
        $(function () {
            $('#delivery').on('click', '.show-bs-modal', function (e) {

                // The row click opens the details modal, so stop it here.
                e.stopPropagation();

                let id = $(this).data("id");

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to recover this Delivery!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postDeliveryAction('/Admin/Delivery/DeleteDelivery', id, 'Deleted!');
                    }
                });
            });
        });
    </script>
}
