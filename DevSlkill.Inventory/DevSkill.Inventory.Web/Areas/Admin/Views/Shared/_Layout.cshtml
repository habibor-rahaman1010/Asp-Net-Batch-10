    <!-- Keep the sidebar parent menu expanded for the current page -->
    <script>
        $(function () {
            function segments(url) {
                return url.split('?')[0].split('#')[0].replace(/\/+$/, '').toLowerCase().split('/').filter(Boolean);
            }

            var current = segments(window.location.pathname);
            var best = null, bestScore = 0;

            $('.nav-sidebar a.nav-link[href]').each(function () {
                var href = this.getAttribute('href');
                if (!href || href === '#' || href.charAt(0) === '#') return;

                var link = segments(href);
                if (!link.length) return;

                var score;
                if (link.join('/') === current.join('/')) {
                    score = 1000;                       // exact page match
                } else {
                    var i = 0;
                    while (i < link.length && i < current.length && link[i] === current[i]) i++;
                    score = i >= 2 ? i : 0;             // same area + controller
                }

                if (score > bestScore) { bestScore = score; best = this; }
            });

            if (!best) return;

            $(best).addClass('active');
            $(best).parents('li.nav-item').each(function () {
                var $li = $(this);
                $li.addClass('menu-open');
                $li.children('ul.nav-treeview').addClass('menu-open').css('display', 'block');
                $li.children('a.nav-link').addClass('active');
            });
        });
    </script>

