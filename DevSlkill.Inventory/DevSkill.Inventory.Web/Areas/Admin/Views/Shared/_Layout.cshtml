    <!-- Notifications: the bell, and the live push behind it -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        // Named on window because the notification pages call it after marking
        // something read, so the badge and the page never disagree.
        window.refreshNotificationBell = function () { };

        $(function () {
            var badge = $('#notificationCount');
            var header = $('#notificationHeader');
            var items = $('#notificationItems');

            var emptyMarkup = '<span class="dropdown-item text-muted" style="font-size: 13px;">' +
                'Nothing yet. You are told about the operations you have been assigned to.</span>';

            function escapeHtml(value) {
                return $('<div>').text(value == null ? '' : value).html();
            }

            // Short and readable rather than exact: nobody reads a bell for a timestamp.
            function timeAgo(iso) {
                var then = new Date(iso);
                var seconds = Math.max(0, Math.floor((new Date() - then) / 1000));

                if (seconds < 60) return 'just now';
                if (seconds < 3600) return Math.floor(seconds / 60) + ' min';
                if (seconds < 86400) return Math.floor(seconds / 3600) + ' hours';

                return Math.floor(seconds / 86400) + ' days';
            }

            function setCount(count) {
                if (count > 0) {
                    // Past 99 the exact number stops meaning anything.
                    badge.text(count > 99 ? '99+' : count).show();
                    header.text(count + ' unread notification' + (count === 1 ? '' : 's'));
                } else {
                    badge.hide();
                    header.text('No unread notifications');
                }
            }

            function renderItems(recent) {
                if (!recent || recent.length === 0) {
                    items.html(emptyMarkup);
                    return;
                }

                var html = '';

                recent.forEach(function (row, index) {
                    if (index > 0) {
                        html += '<div class="dropdown-divider"></div>';
                    }

                    // An unread one is marked by the dot as well as by the weight, so
                    // it is not told apart by boldness alone.
                    var unreadDot = row.isRead
                        ? ''
                        : '<i class="fas fa-circle text-primary ml-1" style="font-size: 6px; vertical-align: middle;"></i>';

                    var href = row.url ? escapeHtml(row.url) : '/Admin/Notification/Index';

                    html += `<a href="${href}" class="dropdown-item">
                                <i class="fas ${escapeHtml(row.icon)} text-${escapeHtml(row.colour)} mr-2"></i>
                                <span style="${row.isRead ? '' : 'font-weight:600;'}">${escapeHtml(row.title)}</span>${unreadDot}
                                <span class="float-right text-muted text-sm">${timeAgo(row.created)}</span>
                                <div class="text-muted text-sm" style="white-space: normal;">${escapeHtml(row.message)}</div>
                             </a>`;
                });

                items.html(html);
            }

            function loadSummary() {
                $.get('/Admin/Notification/Summary')
                    .done(function (result) {
                        setCount(result.unreadCount || 0);
                        renderItems(result.recent);
                    });
            }

            window.refreshNotificationBell = loadSummary;

            loadSummary();

            // Live push. A browser that is not connected simply picks the notification
            // up on its next page load, so nothing is lost when this fails.
            try {
                var notificationConnection = new signalR.HubConnectionBuilder()
                    .withUrl('/notificationHub')
                    .withAutomaticReconnect()
                    .build();

                notificationConnection.on('UpdateNotificationCount', setCount);

                notificationConnection.on('ReceiveNotification', function (notification) {
                    // The whole bell is re-read rather than patched, so a second tab
                    // that already read something cannot leave the list stale.
                    loadSummary();

                    // Swal is already on every admin page, so its toast mode is used
                    // rather than pulling in a second notification library.
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'info',
                            title: notification.title,
                            text: notification.message,
                            showConfirmButton: false,
                            timer: 6000,
                            timerProgressBar: true
                        });
                    }
                });

                notificationConnection.start().catch(function (err) {
                    console.error('Notification hub: ' + err);
                });
            } catch (e) {
                console.error('Notification hub could not be started.', e);
            }
        });
    </script>
