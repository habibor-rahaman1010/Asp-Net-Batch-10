<!-- Product Details Modal -->
<div id="productDetailsModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-custom modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Product Details</h5>
                <button type="button" class="close" data-dismiss="modal">
                    &times;
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4">
                        <p><strong>Product Id:</strong> <span id="id"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Product Name:</strong> <span id="productName"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Price:</strong> <span id="price"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>SKU:</strong> <span id="sku"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Ratings:</strong> <span id="ratings"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Current Stock:</strong> <span id="currentStock"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Alert Quantity:</strong> <span id="alertQuantity"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Description:</strong> <span id="description"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Brand:</strong> <span id="brand"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Category:</strong> <span id="category"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Subcategory:</strong> <span id="subcategory"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Product Type:</strong> <span id="productType"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Business Location:</strong> <span id="businessLocation"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Unit:</strong> <span id="unit"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Weight:</strong> <span id="weight"></span>kg</p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Status:</strong> <span id="status"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Warranty:</strong> <span id="warranty"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Barcode Type:</strong> <span id="barcodeType"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>IMEI:</strong> <span id="imei"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Position:</strong> <span id="position"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Rack:</strong> <span id="rack"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Excise Tax:</strong> <span id="exciseTax"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Inclusive Tax:</strong> <span id="inclusiveTax"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Margin Tax:</strong> <span id="marginTax"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Selling Price:</strong> <span id="sellingPrice"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Selling Price Tax:</strong> <span id="sellingPriceTax"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Applicable Tax:</strong> <span id="applicableTax"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Store Time:</strong> <span id="storeTime"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Created:</strong> <span id="created"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Updated:</strong> <span id="updated"></span></p>
                    </div> 
                </div>

                <!-- Centered Product Image -->
                <hr />
                <div class="col-md-12 text-center">
                    <p><strong>Product Image:</strong></p>
                    <img id="productImage" src="" alt="Product Image" class="img-fluid mt-3" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary no-print" aria-label="Print" onclick="$('#productDetailsModal').printThis();">
                    <i class="fa fa-print"></i> Print
                </button>
                <button type="button" class="btn btn-secondary no-print" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>