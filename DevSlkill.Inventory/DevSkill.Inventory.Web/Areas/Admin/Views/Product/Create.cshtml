@model ProductCreateModel;

@{
    ViewData["Title"] = "Create";
}

<style>
    #container {
        width: 1000px;
        margin: 20px auto;
    }

    .ck-editor__editable[role="textbox"] {
        min-height: 300px;
    }

    .ck-content .image {
        max-width: 80%;
        margin: 20px auto;
    }

    #productImage {
        display: block;
        margin-bottom: 10px;
    }

    #imageError {
        color: teal;
    }
</style>

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="ml-2">Add New Product</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Product</a></li>
                    <li class="breadcrumb-item active">Create New</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div>
            <form asp-antiforgery="true" asp-area="Admin" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">
                <!--Form-1 -->
                <div class="col-sm-12">
                    <!-- general form elements -->
                    <div class="card card-primary" style="border-top: 4px solid #3c8dbc;">
                        <!-- /.card-header -->
                        <!-- form start -->
                        <div class="card-body">
                            <partial name="_ResponsePartial" />

                            <div class="row">
                                <!-- First row of form inputs -->
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="ProductName">Product Name*</label>
                                        <input type="text" asp-for="ProductName" class="form-control" placeholder="Product Name" />
                                        <span asp-validation-for="ProductName" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="SKU">Product SKU*</label>
                                        <input type="text" asp-for="SKU" class="form-control" placeholder=" SKU" />
                                        <span asp-validation-for="SKU" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="BarcodeTypeId">Product Barcode Types*</label>
                                        <select asp-for="BarcodeTypeId" asp-items="Model.BarcodeTypes" class="form-control"></select>
                                        <span asp-validation-for="BarcodeTypeId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Second row of form inputs -->
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="UnitId">Product Units*</label>
                                        <select asp-for="UnitId" asp-items="Model.Units" class="form-control"></select>
                                        <span asp-validation-for="UnitId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 px-3">
                                    <div class="form-group">
                                        <label asp-for="Ratings">Product Rating*</label>
                                        <input type="number" asp-for="Ratings" class="form-control" placeholder="Product Rating" value="" />
                                        <span asp-validation-for="Ratings" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="BrandId">Product Brands</label>
                                        <select asp-for="BrandId" asp-items="Model.Brands" class="form-control"></select>
                                        <span asp-validation-for="BrandId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Third row of form inputs -->
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="CategoryId">Product Categories*</label>
                                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control"></select>
                                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="SubcategoryId">Product Sub Categories*</label>
                                        <select asp-for="SubcategoryId" asp-items="Model.Subcategories" class="form-control"></select>
                                        <span asp-validation-for="SubcategoryId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="BusinessLocationId">Business Locations*</label>
                                        <select asp-for="BusinessLocationId" asp-items="Model.BusinessLocations" class="form-control"></select>
                                        <span asp-validation-for="BusinessLocationId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Second row of form inputs -->
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="Price">Product Price*</label>
                                        <input type="number" asp-for="Price" class="form-control" placeholder="Price" value="" />
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="AlertQuantity">Alert Quantity*</label>
                                        <input type="number" asp-for="AlertQuantity" class="form-control" placeholder="Alert Quantity" value="" />
                                        <span asp-validation-for="AlertQuantity" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="WarrantyId">Product Warranties</label>
                                        <select asp-for="WarrantyId" asp-items="Model.Warranties" class="form-control"></select>
                                        <span asp-validation-for="WarrantyId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!--description section -->
                            <div class="row">
                                <!-- Second row of form inputs -->
                                <div class="col-sm-8 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="Description">Product Descriptions*</label>
                                        <textarea asp-for="Description" placeholder="Description" id="editor"></textarea>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="ProductImageFile" class="control-label">Product image*</label>
                                    <div class="custom-file">
                                        <label class="custom-file-label" asp-for="ProductImageFile">Choose your file</label>
                                        <input style="width: 400px; cursor:pointer" asp-for="ProductImageFile" class="custom-file-input" id="productImage">
                                        <p id="imageError"></p>
                                    </div>
                                    <p class="mt-2">Max File size: 5MB <br/> Allowed File: .jpeg, .jpg, .png <br /> Aspect ratio should be 1:1</p>
                                    <span asp-validation-for="ProductImageFile" class="text-danger"></span>
                                </div>

                            </div>

                        </div>
                            <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div>
                
                <!--Form-2 -->
                <div class="col-sm-12">
                <!-- general form elements -->
                    <div class="card card-primary" style="border-top: 4px solid #3c8dbc;">
                        <div class="card-body">
                            <h3>Rack/Row/Position Details:</h3>
                        <div class="row">
                            <!-- First row of form inputs -->
                            <div class="col-sm-3 mb-3 px-3">
                                <div class="form-group">
                                    <label asp-for="Rack">Rack Number*</label>
                                    <input type="text" asp-for="Rack" class="form-control" placeholder="Rack" />
                                    <span asp-validation-for="Rack" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-3 mb-3 px-3">
                                <div class="form-group">
                                    <label asp-for="Row">Row Number*</label>
                                        <input type="text" asp-for="Row" class="form-control" placeholder="Row" />
                                        <span asp-validation-for="Row" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-3 mb-3 px-3">
                                <div class="form-group">
                                    <label asp-for="Position">Place Position*</label>
                                        <input type="text" asp-for="Position" class="form-control" placeholder="Position" />
                                        <span asp-validation-for="Position" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-3 mb-3 px-3">
                                <div class="form-group">
                                    <label asp-for="IMEI">Product IMEI Code*</label>
                                    <input type="text" asp-for="IMEI" class="form-control" placeholder="IMEI" />
                                    <span asp-validation-for="IMEI" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Second row of form inputs -->
                            <div class="col-sm-4 mb-3 px-3">
                                <div class="form-group">
                                    <label asp-for="Weight">Product Weight*</label>
                                    <input type="number" asp-for="Weight" class="form-control" placeholder="Weight" value=""/>
                                    <span asp-validation-for="Weight" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-4 px-3">
                                <div class="form-group">
                                    <label asp-for="StoreTime">Store Time*</label>
                                    <input type="datetime-local" asp-for="StoreTime" class="form-control" value="" />
                                    <span asp-validation-for="StoreTime" class="text-danger"></span>
                                </div>
                            </div>    

                            <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="Status">Product Status*</label>
                                        <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                        <span asp-validation-for="Status" class="text-danger"></span>
                                    </div>
                                </div>
                        </div>     
                    </div>
                </div>
                <!-- /.card -->
                </div>

                <!--Form-3 -->
                <div class="col-sm-12">
                    <!-- general form elements -->
                    <div class="card card-primary" style="border-top: 4px solid #3c8dbc;">
                        <div class="card-body">
                            <div class="row">
                                <!-- First row of form inputs -->
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="ApplicableTaxId">Applicable Tax*</label>
                                        <select asp-for="ApplicableTaxId" asp-items="Model.ApplicableTaxes" class="form-control"></select>
                                        <span asp-validation-for="ApplicableTaxId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="SellingPriceTaxId">Selling Price Tax*</label>
                                        <select asp-for="SellingPriceTaxId" asp-items="Model.SellingPriceTaxes" class="form-control"></select>
                                        <span asp-validation-for="SellingPriceTaxId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="ProductypeId">Product Type*</label>
                                        <select asp-for="ProductypeId" asp-items="Model.ProductTypes" class="form-control"></select>
                                        <span asp-validation-for="ProductypeId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                                

                            <div class="d-flex justify-content-between bg-green p-2 align-items-center mb-2">
                                <div>
                                    <h6>Default Purchase Price</h6>
                                </div>
                                <div>
                                    <h6>X Margin(%) </h6>
                                </div>
                                <div>
                                    <h6>Default Selling Price</h6>
                                </div>
                            </div>
                       
                            <div class="row">
                                <!-- First row of tax inputs -->
     
                                <div class="col-sm-3 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="ExciseTax">Excise Tax*</label>
                                        <input type="number" asp-for="ExciseTax" class="form-control" placeholder="Excise Tax" value="" id="exciseTax" />
                                        <span asp-validation-for="ExciseTax" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-3 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="InclusiveTax">Inclusive Tax*</label>
                                        <input type="number" asp-for="InclusiveTax" class="form-control" placeholder="Inclusive Tax" value="" id="inclusiveTax" />
                                        <span asp-validation-for="InclusiveTax" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-3 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="MarginTax">Margin Tax*</label>
                                        <input type="number" asp-for="MarginTax" class="form-control" placeholder="Margin Tax" value="" id="marginTax" />
                                        <span asp-validation-for="MarginTax" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Automatically calculated Selling Price -->
                                <div class="col-sm-3 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="SellingPrice">Selling Price*</label>
                                        <input type="number" asp-for="SellingPrice" class="form-control" placeholder="Selling Price" value="" id="sellingPrice" readonly />
                                        <span asp-validation-for="SellingPrice" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <!-- /.card -->
                </div>
                
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
        <!-- /.row -->
    </div><!-- /.container-fluid -->
</section>

<!-- /.content -->
@section Scripts {
    <script>
        $(document).ready(function() {
            // Function to calculate Selling Price
            function calculateSellingPrice() {
                var exciseTax = parseFloat($('#exciseTax').val()) || 0;
                var inclusiveTax = parseFloat($('#inclusiveTax').val()) || 0;
                var marginTax = parseFloat($('#marginTax').val()) || 0;

                // Calculation formula for SellingPrice
                var calInclusiveTax = (exciseTax / 100) * inclusiveTax;
                var calmarginTax = (exciseTax / 100) * marginTax;
                var sellingPrice = exciseTax + calInclusiveTax + calmarginTax;

                // Update SellingPrice field
                $('#sellingPrice').val(sellingPrice.toFixed(2));
            }

            // Attach the calculation function to input events
            $('#exciseTax, #inclusiveTax, #marginTax').on('input', function() {
                calculateSellingPrice();
            });
        });

        const productImageInput = document.getElementById('productImage');
        const imageError = document.getElementById('imageError');

        productImageInput.addEventListener('change', (event) => {
            const file = event.target.files[0];

            if (file) {
                // Validate file size and aspect ratio
                if (file.size > 5 * 1024 * 1024) {
                    imageError.textContent = 'File size is too large.';
                    productImageInput.value = '';
                } else if (file.type.startsWith('image/') && file.width === file.height) {
                    // Handle successful upload or preview
                    imageError.textContent = '';
                    // ...
                } else {
                    imageError.textContent = 'Invalid image format or aspect ratio.';
                    productImageInput.value = '';
                }
            }
        });

        document.querySelector('.custom-file-input').addEventListener('change', function (e) {
            var fileName = e.target.files[0].name;
            var label = e.target.nextElementSibling;
            label.textContent = fileName;
        });

    </script>
}

