@model ProductCreateModel;

@{
    ViewData["Title"] = "Create";
}
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Add Product</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Product</a></li>
                    <li class="breadcrumb-item active">Create New</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- left column -->
            <div class="col-sm-12">
                <!-- general form elements -->
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Add Product</h3>
                    </div>
                    <!-- /.card-header -->
                    <!-- form start -->
                    <form asp-antiforgery="true" asp-area="Admin" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="card-body">
                            <partial name="_ResponsePartial" />

                            <div class="row">
                                <!-- First row of form inputs -->
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="ProductName"></label>
                                        <input type="text" asp-for="ProductName" class="form-control" placeholder="Product Name" />
                                        <span asp-validation-for="ProductName" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="SKU"></label>
                                        <input type="text" asp-for="SKU" class="form-control" placeholder=" SKU" />
                                        <span asp-validation-for="SKU" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="BarcodeTypeId"></label>
                                        <select asp-for="BarcodeTypeId" asp-items="Model.BarcodeTypes" class="form-control"></select>
                                        <span asp-validation-for="BarcodeTypeId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Second row of form inputs -->
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="Description"></label>
                                        <input type="text" asp-for="Description" class="form-control" placeholder="Product Description" />
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 px-3">
                                    <div class="form-group">
                                        <label asp-for="Ratings"></label>
                                        <input type="number" asp-for="Ratings" class="form-control" placeholder="Product Rating" />
                                        <span asp-validation-for="Ratings" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="ProductypeId"></label>
                                        <select asp-for="ProductypeId" asp-items="Model.ProductTypes" class="form-control"></select>
                                        <span asp-validation-for="ProductypeId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Second row of form inputs -->
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="Description"></label>
                                        <input type="text" asp-for="Description" class="form-control" placeholder="Product Description" />
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="Ratings"></label>
                                        <input type="number" asp-for="Ratings" class="form-control" placeholder="Product Rating" />
                                        <span asp-validation-for="Ratings" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="ProductypeId"></label>
                                        <select asp-for="ProductypeId" asp-items="Model.ProductTypes" class="form-control"></select>
                                        <span asp-validation-for="ProductypeId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Second row of form inputs -->
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <h3>Hello</h3>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="Ratings"></label>
                                        <input type="number" asp-for="Ratings" class="form-control" placeholder="Product Rating" />
                                        <span asp-validation-for="Ratings" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="ProductypeId"></label>
                                        <select asp-for="ProductypeId" asp-items="Model.ProductTypes" class="form-control"></select>
                                        <span asp-validation-for="ProductypeId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!--description section -->
                            <div class="row">
                                <!-- Second row of form inputs -->
                                <div class="col-sm-8 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="Ratings"></label>
                                        <input type="number" asp-for="Ratings" class="form-control" placeholder="Product Rating" />
                                        <span asp-validation-for="Ratings" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="ProductypeId"></label>
                                        <select asp-for="ProductypeId" asp-items="Model.ProductTypes" class="form-control"></select>
                                        <span asp-validation-for="ProductypeId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Second row of form inputs -->
                                <div class="col-sm-5 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="Ratings"></label>
                                        <input type="number" asp-for="Ratings" class="form-control" placeholder="Product Rating" />
                                        <span asp-validation-for="Ratings" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.card-body -->

                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
                <!-- /.card -->
            </div>
            <!--/.col (left) -->
        </div>
        <!-- /.row -->
    </div><!-- /.container-fluid -->
</section>
<!-- /.content -->
