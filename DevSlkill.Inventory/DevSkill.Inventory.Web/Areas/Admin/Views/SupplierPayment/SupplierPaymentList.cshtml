@{
    ViewData["Title"] = "Supplier Payment List";
}

@section Styles {
    <!-- DataTables -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Supplier Payments</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Purchase</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Invoices are settled only when a payment is confirmed.</h3>

                        <a asp-area="Admin" asp-controller="SupplierPayment" asp-action="CreateSupplierPayment" class="btn btn-primary float-right">
                            <i class="fas fa-plus"></i> Record Payment
                        </a>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="supplierPayment" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Payment No</th>
                                    <th>Supplier</th>
                                    <th>Date</th>
                                    <th>Method</th>
                                    <th>Reference</th>
                                    <th>Amount</th>
                                    <th>Allocated</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Payment No</th>
                                    <th>Supplier</th>
                                    <th>Date</th>
                                    <th>Method</th>
                                    <th>Reference</th>
                                    <th>Amount</th>
                                    <th>Allocated</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>

<partial name="_SupplierPaymentDetailsPartial" />

<!-- /.content -->
@section Scripts {
    <!-- DataTables  & Plugins -->
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script type="text/javascript">

        function statusBadgeClass(status) {
            switch (status) {
                case 'Paid': return 'badge-success';
                case 'Cancelled': return 'badge-danger';
                default: return 'badge-secondary';
            }
        }

        // A draft is edited, confirmed or deleted. A confirmed payment has already
        // settled invoices, so only a cancellation can undo it.
        function actionButtons(id, status) {

            var buttons = '';

            if (status === 'Draft') {
                buttons += `<a href="/Admin/SupplierPayment/UpdateSupplierPayment/${id}"
                               class="btn btn-info btn-sm mr-1" title="Edit"><i class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-success btn-sm mr-1 btn-confirm" data-id='${id}'
                                title="Confirm payment"><i class="fas fa-check"></i></button>`;
            }

            if (status === 'Draft' || status === 'Paid') {
                buttons += `<button type="button" class="btn btn-warning btn-sm mr-1 btn-cancel" data-id='${id}'
                                title="Cancel"><i class="fas fa-ban"></i></button>`;
            }

            if (status === 'Draft' || status === 'Cancelled') {
                buttons += `<button type="button" class="btn btn-danger btn-sm show-bs-modal" data-id='${id}'
                                title="Delete"><i class="fas fa-trash"></i></button>`;
            }

            return buttons === '' ? '<span class="text-muted">—</span>' : buttons;
        }

        function postAction(url, data, successTitle) {

            data.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: url,
                type: 'POST',
                data: data,
                success: function (response) {
                    if (response.success) {
                        Swal.fire({ icon: 'success', title: successTitle, text: response.message, timer: 2200, showConfirmButton: false });
                        $('#supplierPayment').DataTable().ajax.reload(null, false);
                    } else {
                        Swal.fire({ icon: 'error', title: 'Failed!', text: response.message });
                    }
                },
                error: function (error) {
                    if (error.status === 403) {
                        window.location.href = '/Account/AccessDenied';
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: 'The action could not be completed.' });
                    }
                }
            });
        }

        $(function () {
            try {
                $("#supplierPayment").DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    ajax: {
                        url: "/Admin/SupplierPayment/GetSupplierPaymentJsonData",
                        type: "POST",
                        contentType: "application/json",
                        dataType: "json",
                        data: function (d) {
                            return JSON.stringify(d);
                        },
                    },
                    columnDefs: [
                        {
                            orderable: false,
                            targets: 8,
                            render: function (data, type, row) {
                                return actionButtons(data, row[7]);
                            }
                        },
                        {
                            targets: 7,
                            render: function (data) {
                                return `<span class="badge ${statusBadgeClass(data)}">${data}</span>`;
                            }
                        },
                        ...[0, 1, 2, 3, 4, 5, 6].map(function (target) {
                            return {
                                targets: target,
                                createdCell: function (td, cellData, rowData) {
                                    $(td).addClass('table-row');
                                    $(td).attr('data-id', rowData[8]);
                                }
                            };
                        })
                    ],
                    dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                    "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
                }).buttons().container().appendTo('#supplierPayment_wrapper .col-md-6:eq(0)');
            } catch (e) {
                console.error("DataTable init error:", e);
            }
        });

        // Row click -> supplier payment details modal
        $(function () {
            $('#supplierPayment tbody').on('click', '.table-row', function () {
                var id = $(this).data("id");

                $.ajax({
                    url: `/Admin/SupplierPayment/GetSupplierPaymentDetails?id=${id}`,
                    type: 'GET',
                    success: function (data) {

                        $('#SpmNo').text(data.paymentNo || 'N/A');
                        $('#SpmSupplier').text(data.supplierName || 'N/A');
                        $('#SpmDate').text(data.paymentDate ? new Date(data.paymentDate).toLocaleDateString() : 'N/A');
                        $('#SpmStatus').text(data.status || 'N/A');
                        $('#SpmMethod').text(data.paymentMethod || 'N/A');
                        $('#SpmReference').text(data.referenceNo || 'N/A');
                        $('#SpmAmount').text(Number(data.amount ?? 0).toFixed(2));
                        $('#SpmUnallocated').text(Number(data.unallocatedAmount ?? 0).toFixed(2));
                        $('#SpmAllocated').text(Number(data.allocatedAmount ?? 0).toFixed(2));
                        $('#SpmNotes').text(data.notes || 'N/A');

                        var body = $('#SpmItemsBody').empty();

                        $.each(data.supplierPaymentAllocations || [], function (i, item) {
                            var row = $('<tr>');
                            row.append($('<td>').text(item.invoiceNo || ''));
                            row.append($('<td>').text(item.supplierInvoiceNo || ''));
                            row.append($('<td>').text(item.invoiceDate ? new Date(item.invoiceDate).toLocaleDateString() : ''));
                            row.append($('<td class="text-right">').text(Number(item.grandTotal ?? 0).toFixed(2)));
                            row.append($('<td class="text-right">').text(Number(item.dueAmount ?? 0).toFixed(2)));
                            row.append($('<td class="text-right">').text(Number(item.allocatedAmount ?? 0).toFixed(2)));
                            row.append($('<td>').text(item.remarks || ''));
                            body.append(row);
                        });

                        $('#supplierPaymentDetailModal').modal('show');
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) {
                            window.location.href = '/Account/AccessDenied';
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error!', text: 'Failed to load supplier payment details.' });
                        }
                    }
                });
            });
        });

        $(function () {

            $('#supplierPayment').on('click', '.btn-confirm', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Confirm this payment?',
                    text: 'The allocated amounts are taken off the invoices straight away.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: 'Yes, Confirm',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/SupplierPayment/ConfirmSupplierPayment', { id: id }, 'Paid!');
                    }
                });
            });

            $('#supplierPayment').on('click', '.btn-cancel', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Cancel this payment?',
                    text: 'If it was already confirmed, the due goes straight back onto the invoices.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Yes, Cancel It',
                    cancelButtonText: 'Keep It'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/SupplierPayment/CancelSupplierPayment', { id: id }, 'Cancelled!');
                    }
                });
            });

            $('#supplierPayment').on('click', '.show-bs-modal', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to recover this supplier payment!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/SupplierPayment/DeleteSupplierPayment', { id: id }, 'Deleted!');
                    }
                });
            });

        });
    </script>
}
