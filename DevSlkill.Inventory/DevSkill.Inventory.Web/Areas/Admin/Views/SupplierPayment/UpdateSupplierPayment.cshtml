@model SupplierPaymentUpdateModel;

@{
    ViewData["Title"] = "Update Supplier Payment";
}

<section class="content mt-2">
    <div class="container-fluid">
        <form asp-antiforgery="true" asp-area="Admin" asp-controller="SupplierPayment" asp-action="UpdateSupplierPayment" method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SupplierId" />

            <!-- Header -->
            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">Update Supplier Payment</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PaymentNo"></label>
                                <input asp-for="PaymentNo" class="form-control" readonly />
                                <small class="form-text text-muted">The payment number is issued once and never changes.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SupplierName"></label>
                                <input asp-for="SupplierName" class="form-control" readonly />
                                <small class="form-text text-muted">A payment never moves to another supplier.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="CurrentOutstanding"></label>
                                <input asp-for="CurrentOutstanding" class="form-control" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PaymentDate">Payment Date*</label>
                                <input asp-for="PaymentDate" type="date" class="form-control" />
                                <span asp-validation-for="PaymentDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PaymentMethod">Payment Method*</label>
                                <select asp-for="PaymentMethod" asp-items="Model.PaymentMethods" class="form-control"></select>
                                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ReferenceNo"></label>
                                <input asp-for="ReferenceNo" class="form-control" />
                                <span asp-validation-for="ReferenceNo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Amount">Payment Amount*</label>
                                <div class="input-group">
                                    <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" id="Amount" />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-secondary" id="btnAutoAllocate"
                                                title="Spread this amount over the oldest invoices first">
                                            <i class="fas fa-magic"></i> Auto
                                        </button>
                                    </div>
                                </div>
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Status">Status*</label>
                                <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                <small class="form-text text-muted">
                                    Setting this to <strong>Paid</strong> settles the invoices and closes the payment for editing.
                                </small>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Notes"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <partial name="_SupplierPaymentAllocationsPartial" model="Model.SupplierPaymentAllocations" />

            <div class="card">
                <div class="card-body text-center">
                    <button type="submit" class="btn btn-primary">Update Payment</button>
                    <a asp-area="Admin" asp-controller="SupplierPayment" asp-action="SupplierPaymentList" class="btn btn-danger">Cancel</a>
                </div>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_SupplierPaymentAllocationsScriptPartial" />
}
