@model SupplierPaymentCreateModel;

@{
    ViewData["Title"] = "Record Supplier Payment";
}

<section class="content mt-2">
    <div class="container-fluid">
        <form asp-antiforgery="true" asp-area="Admin" asp-controller="SupplierPayment" asp-action="CreateSupplierPayment" method="post">

            <!-- Header -->
            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">Supplier Payment</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PaymentNo"></label>
                                <input asp-for="PaymentNo" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SupplierId">Supplier*</label>
                                <select asp-for="SupplierId" asp-items="Model.Suppliers" class="form-control" id="SupplierId"></select>
                                <span asp-validation-for="SupplierId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="CurrentOutstanding"></label>
                                <input asp-for="CurrentOutstanding" class="form-control" id="CurrentOutstanding" readonly />
                                <small class="form-text text-muted">What the supplier is owed across every posted invoice.</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PaymentDate">Payment Date*</label>
                                <input asp-for="PaymentDate" type="date" class="form-control" />
                                <span asp-validation-for="PaymentDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PaymentMethod">Payment Method*</label>
                                <select asp-for="PaymentMethod" asp-items="Model.PaymentMethods" class="form-control"></select>
                                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ReferenceNo"></label>
                                <input asp-for="ReferenceNo" class="form-control" placeholder="Cheque no, transaction id..." />
                                <span asp-validation-for="ReferenceNo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Amount">Payment Amount*</label>
                                <div class="input-group">
                                    <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" id="Amount" />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-secondary" id="btnAutoAllocate"
                                                title="Spread this amount over the oldest invoices first">
                                            <i class="fas fa-magic"></i> Auto
                                        </button>
                                    </div>
                                </div>
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Status">Status*</label>
                                <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                <small class="form-text text-muted">
                                    <strong>Paid</strong> settles the invoices immediately. A draft settles nothing.
                                </small>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Notes"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <partial name="_SupplierPaymentAllocationsPartial" model="Model.SupplierPaymentAllocations" />

            <div class="card">
                <div class="card-body text-center">
                    <button type="submit" class="btn btn-primary">Save Payment</button>
                    <a asp-area="Admin" asp-controller="SupplierPayment" asp-action="SupplierPaymentList" class="btn btn-danger">Cancel</a>
                </div>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_SupplierPaymentAllocationsScriptPartial" />

    <script>

        $(document).ready(function () {

            // Choosing a supplier rebuilds the grid from whatever it still owes.
            $("#SupplierId").on("change", function () {

                var supplierId = $(this).val();

                if (!supplierId) {
                    $("#allocationTableBody").empty();
                    $("#CurrentOutstanding").val("");
                    recalculateAllocations();
                    return;
                }

                $.get('/Admin/SupplierPayment/GetPayableInvoices', { supplierId: supplierId }, function (response) {

                    if (!response.success) {
                        Swal.fire({ icon: "error", title: "Supplier", text: response.message });
                        return;
                    }

                    $("#CurrentOutstanding").val(Number(response.currentOutstanding ?? 0).toFixed(2));

                    var open = (response.invoices || []).filter(function (invoice) {
                        return invoice.remainingAmount > 0;
                    });

                    if (open.length === 0) {
                        $("#allocationTableBody").empty();
                        recalculateAllocations();

                        Swal.fire({
                            icon: "info",
                            title: "Nothing Outstanding",
                            text: "This supplier has no posted invoice left to pay."
                        });

                        return;
                    }

                    buildAllocationRows(open);
                });
            });

        });

    </script>
}
