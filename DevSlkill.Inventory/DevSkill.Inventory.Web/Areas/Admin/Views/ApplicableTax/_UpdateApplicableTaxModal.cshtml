@model ApplicableTaxUpdateModel
<!-- Modal for updating a existing applicable tax -->
<div class="modal fade" id="updateApplicableTaxModal" tabindex="-1" role="dialog" aria-labelledby="updateApplicableTaxModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateWarrantyModalLabel">Update The Applicable Tax</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form method="post" asp-antiforgery="true" id="updateApplicableTaxForm" enctype="multipart/form-data">
                    <input asp-for="Id" type="hidden" id="updateApplicableTaxId" name="Id" />
                    <div class="form-group">
                        <label asp-for="ApplicableTaxName">Applicable Tax Name</label>
                        <input asp-for="ApplicableTaxName" type="text" class="form-control" id="editApplicableTaxName" name="ApplicableTaxName" required>
                        <span asp-validation-for="ApplicableTaxName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="TaxRate">Tax Rate</label>
                        <input asp-for="TaxRate" type="number" class="form-control" id="editTaxRate" name="TaxRate" required>
                        <span asp-validation-for="TaxRate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description">Applicable Tax Description</label>
                        <textarea asp-for="Description" class="form-control" id="editDescription" name="Description" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>
