<div class="modal fade" id="salesInvoiceDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h5 class="modal-title">Sales Invoice Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Invoice No</dt>
                            <dd class="col-sm-7" id="SiNo"></dd>

                            <dt class="col-sm-5">Sales Order</dt>
                            <dd class="col-sm-7" id="SiOrderNo"></dd>

                            <dt class="col-sm-5">Delivery</dt>
                            <dd class="col-sm-7" id="SiDeliveryNo"></dd>

                            <dt class="col-sm-5">Customer</dt>
                            <dd class="col-sm-7" id="SiCustomer"></dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Invoice Date</dt>
                            <dd class="col-sm-7" id="SiDate"></dd>

                            <dt class="col-sm-5">Due Date</dt>
                            <dd class="col-sm-7" id="SiDueDate"></dd>

                            <dt class="col-sm-5">Salesperson</dt>
                            <dd class="col-sm-7" id="SiSalesperson"></dd>

                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7" id="SiStatus"></dd>
                        </dl>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Unit</th>
                                <th class="text-right">Billed</th>
                                <th class="text-right">Returned</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Discount</th>
                                <th class="text-right">Tax</th>
                                <th class="text-right">Line Total</th>
                            </tr>
                        </thead>
                        <tbody id="SiItemsBody"></tbody>
                    </table>
                </div>

                <div class="row justify-content-end">
                    <div class="col-md-5">
                        <table class="table table-sm">
                            <tr>
                                <th>Sub Total</th>
                                <td class="text-right" id="SiSubTotal"></td>
                            </tr>
                            <tr>
                                <th>Item Discount</th>
                                <td class="text-right" id="SiDiscount"></td>
                            </tr>
                            <tr>
                                <th>Tax / VAT</th>
                                <td class="text-right" id="SiTax"></td>
                            </tr>
                            <tr>
                                <th>Other Charges</th>
                                <td class="text-right" id="SiOtherCharges"></td>
                            </tr>
                            <tr>
                                <th>Grand Total</th>
                                <td class="text-right" id="SiGrandTotal"></td>
                            </tr>
                            <tr>
                                <th>Collected</th>
                                <td class="text-right" id="SiPaid"></td>
                            </tr>
                            <tr class="bg-light">
                                <th>Still Owing</th>
                                <th class="text-right" id="SiDue"></th>
                            </tr>
                        </table>
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-2">Notes</dt>
                    <dd class="col-sm-10" id="SiNotes"></dd>
                </dl>

            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
