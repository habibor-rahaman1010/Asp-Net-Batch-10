@{
    ViewData["Title"] = "Sales Invoice List";
}

@section Styles {
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Sales Invoices</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Sales</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            Posting an invoice is the only thing that raises what a customer owes. It
                            never touches stock; the delivery has already done that.
                        </h3>

                        <a asp-area="Admin" asp-controller="SalesInvoice" asp-action="CreateSalesInvoice" class="btn btn-primary float-right">
                            <i class="fas fa-plus"></i> New Invoice
                        </a>
                    </div>

                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="salesInvoice" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Invoice No</th>
                                    <th>Customer</th>
                                    <th>Invoice Date</th>
                                    <th>Due Date</th>
                                    <th>Grand Total</th>
                                    <th>Collected</th>
                                    <th>Still Owing</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Invoice No</th>
                                    <th>Customer</th>
                                    <th>Invoice Date</th>
                                    <th>Due Date</th>
                                    <th>Grand Total</th>
                                    <th>Collected</th>
                                    <th>Still Owing</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="_SalesInvoiceDetailsPartial" />

@section Scripts {
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script type="text/javascript">

        function statusBadgeClass(status) {
            switch (status) {
                case 'Paid': return 'badge-success';
                case 'PartiallyPaid': return 'badge-info';
                case 'Posted': return 'badge-primary';
                case 'Cancelled': return 'badge-danger';
                default: return 'badge-secondary';
            }
        }

        // A draft is edited, posted or deleted. A posted invoice is collected against
        // or returned against, and can only be cancelled while neither has happened.
        function actionButtons(id, status) {

            var buttons = '';

            if (status === 'Draft') {
                buttons += `<a href="/Admin/SalesInvoice/UpdateSalesInvoice/${id}"
                               class="btn btn-info btn-sm mr-1" title="Edit"><i class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-primary btn-sm mr-1 btn-post" data-id='${id}'
                                title="Post"><i class="fas fa-check"></i></button>`;
            }

            if (status === 'Posted' || status === 'PartiallyPaid') {
                buttons += `<a href="/Admin/CustomerPayment/CreateCustomerPayment?salesInvoiceId=${id}"
                               class="btn btn-success btn-sm mr-1" title="Collect"><i class="fas fa-money-bill-wave"></i></a>`;
            }

            if (status === 'Posted' || status === 'PartiallyPaid' || status === 'Paid') {
                buttons += `<a href="/Admin/SalesReturn/CreateSalesReturn?salesInvoiceId=${id}"
                               class="btn btn-secondary btn-sm mr-1" title="Return goods"><i class="fas fa-undo"></i></a>`;
            }

            if (status !== 'Cancelled') {
                buttons += `<button type="button" class="btn btn-warning btn-sm mr-1 btn-cancel" data-id='${id}'
                                title="Cancel"><i class="fas fa-ban"></i></button>`;
            }

            if (status === 'Draft') {
                buttons += `<button type="button" class="btn btn-danger btn-sm show-bs-modal" data-id='${id}'
                                title="Delete"><i class="fas fa-trash"></i></button>`;
            }

            return buttons === '' ? '<span class="text-muted">—</span>' : buttons;
        }

        function postAction(url, data, successTitle) {

            data.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: url,
                type: 'POST',
                data: data,
                success: function (response) {
                    if (response.success) {
                        Swal.fire({ icon: 'success', title: successTitle, text: response.message, timer: 2600, showConfirmButton: false });
                        $('#salesInvoice').DataTable().ajax.reload(null, false);
                    } else {
                        Swal.fire({ icon: 'error', title: 'Failed!', text: response.message });
                    }
                },
                error: function (error) {
                    if (error.status === 403) {
                        window.location.href = '/Account/AccessDenied';
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: 'The action could not be completed.' });
                    }
                }
            });
        }

        $(function () {
            try {
                $("#salesInvoice").DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    ajax: {
                        url: "/Admin/SalesInvoice/GetSalesInvoiceJsonData",
                        type: "POST",
                        contentType: "application/json",
                        dataType: "json",
                        data: function (d) {
                            return JSON.stringify(d);
                        },
                    },
                    columnDefs: [
                        {
                            orderable: false,
                            targets: 8,
                            render: function (data, type, row) {
                                return actionButtons(data, row[7]);
                            }
                        },
                        {
                            targets: 7,
                            render: function (data) {
                                return `<span class="badge ${statusBadgeClass(data)}">${data}</span>`;
                            }
                        },
                        ...[0, 1, 2, 3, 4, 5, 6].map(function (target) {
                            return {
                                targets: target,
                                createdCell: function (td, cellData, rowData) {
                                    $(td).addClass('table-row');
                                    $(td).attr('data-id', rowData[8]);
                                }
                            };
                        })
                    ],
                    dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                    "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
                }).buttons().container().appendTo('#salesInvoice_wrapper .col-md-6:eq(0)');
            } catch (e) {
                console.error("DataTable init error:", e);
            }
        });

        // Row click -> sales invoice details modal
        $(function () {
            $('#salesInvoice tbody').on('click', '.table-row', function () {
                var id = $(this).data("id");

                $.ajax({
                    url: `/Admin/SalesInvoice/GetSalesInvoiceDetails?id=${id}`,
                    type: 'GET',
                    success: function (data) {

                        $('#SiNo').text(data.invoiceNo || 'N/A');
                        $('#SiOrderNo').text(data.salesOrderNo || 'N/A');
                        $('#SiDeliveryNo').text(data.deliveryNo || 'Whole order');
                        $('#SiCustomer').text(
                            data.customerName ? `${data.customerName} (${data.customerCode})` : 'N/A');
                        $('#SiDate').text(data.invoiceDate ? new Date(data.invoiceDate).toLocaleDateString() : 'N/A');
                        $('#SiDueDate').text(data.dueDate ? new Date(data.dueDate).toLocaleDateString() : 'N/A');
                        $('#SiSalesperson').text(data.salesperson || 'N/A');
                        $('#SiStatus').text(data.status || 'N/A');
                        $('#SiNotes').text(data.notes || 'N/A');

                        $('#SiSubTotal').text(Number(data.subTotal ?? 0).toFixed(2));
                        $('#SiDiscount').text(Number(data.itemDiscountTotal ?? 0).toFixed(2));
                        $('#SiTax').text(Number(data.totalTax ?? 0).toFixed(2));
                        $('#SiOtherCharges').text(Number(data.otherCharges ?? 0).toFixed(2));
                        $('#SiGrandTotal').text(Number(data.grandTotal ?? 0).toFixed(2));
                        $('#SiPaid').text(Number(data.paidAmount ?? 0).toFixed(2));
                        $('#SiDue').text(Number(data.dueAmount ?? 0).toFixed(2));

                        var body = $('#SiItemsBody').empty();

                        $.each(data.salesInvoiceItems || [], function (i, item) {
                            var row = $('<tr>');
                            row.append($('<td>').text(item.productName || ''));
                            row.append($('<td>').text(item.unitName || ''));
                            row.append($('<td class="text-right">').text(Number(item.quantity ?? 0).toFixed(2)));
                            row.append($('<td class="text-right">').text(Number(item.returnedQuantity ?? 0).toFixed(2)));
                            row.append($('<td class="text-right">').text(Number(item.unitPrice ?? 0).toFixed(2)));
                            row.append($('<td class="text-right">').text(Number(item.discountAmount ?? 0).toFixed(2)));
                            row.append($('<td class="text-right">').text(Number(item.taxAmount ?? 0).toFixed(2)));
                            row.append($('<td class="text-right">').text(Number(item.lineTotal ?? 0).toFixed(2)));
                            body.append(row);
                        });

                        $('#salesInvoiceDetailModal').modal('show');
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) {
                            window.location.href = '/Account/AccessDenied';
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error!', text: 'Failed to load invoice details.' });
                        }
                    }
                });
            });
        });

        $(function () {

            $('#salesInvoice').on('click', '.btn-post', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Post this invoice?',
                    text: "The customer's balance goes up by this amount and the salesperson earns their commission.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#007bff',
                    confirmButtonText: 'Yes, Post',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/SalesInvoice/PostSalesInvoice', { id: id }, 'Posted!');
                    }
                });
            });

            $('#salesInvoice').on('click', '.btn-cancel', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Cancel this invoice?',
                    text: 'It comes back off the customer account. Any collection or return against it has to be cancelled first.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Yes, Cancel It',
                    cancelButtonText: 'Keep It'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/SalesInvoice/CancelSalesInvoice', { id: id }, 'Cancelled!');
                    }
                });
            });

            $('#salesInvoice').on('click', '.show-bs-modal', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to recover this invoice!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/SalesInvoice/DeleteSalesInvoice', { id: id }, 'Deleted!');
                    }
                });
            });

        });
    </script>
}
