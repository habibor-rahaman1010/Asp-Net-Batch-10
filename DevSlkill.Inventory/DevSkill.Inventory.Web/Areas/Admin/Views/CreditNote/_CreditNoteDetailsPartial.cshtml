<div class="modal fade" id="creditNoteDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h5 class="modal-title">Credit Note Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Credit Note No</dt>
                            <dd class="col-sm-7" id="CnNo"></dd>

                            <dt class="col-sm-5">Customer</dt>
                            <dd class="col-sm-7" id="CnCustomer"></dd>

                            <dt class="col-sm-5">From Return</dt>
                            <dd class="col-sm-7" id="CnReturnNo"></dd>

                            <dt class="col-sm-5">Against Invoice</dt>
                            <dd class="col-sm-7" id="CnInvoiceNo"></dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Date</dt>
                            <dd class="col-sm-7" id="CnDate"></dd>

                            <dt class="col-sm-5">Reason</dt>
                            <dd class="col-sm-7" id="CnReason"></dd>

                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7" id="CnStatus"></dd>
                        </dl>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Product</th>
                                <th class="text-right">Qty</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Tax</th>
                                <th class="text-right">Line Total</th>
                            </tr>
                        </thead>
                        <tbody id="CnItemsBody"></tbody>
                    </table>
                </div>

                <div class="row justify-content-end">
                    <div class="col-md-5">
                        <table class="table table-sm">
                            <tr>
                                <th>Sub Total</th>
                                <td class="text-right" id="CnSubTotal"></td>
                            </tr>
                            <tr>
                                <th>Tax / VAT</th>
                                <td class="text-right" id="CnTax"></td>
                            </tr>
                            <tr>
                                <th>Credit Value</th>
                                <td class="text-right" id="CnTotal"></td>
                            </tr>
                            <tr>
                                <th>Already Spent</th>
                                <td class="text-right" id="CnApplied"></td>
                            </tr>
                            <tr class="bg-light">
                                <th>Left To Spend</th>
                                <th class="text-right" id="CnRemaining"></th>
                            </tr>
                        </table>
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-2">Notes</dt>
                    <dd class="col-sm-10" id="CnNotes"></dd>
                </dl>

            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
