@{
    ViewData["Title"] = "Credit Note List";
}

@section Styles {
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Credit Notes</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Sales</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            Issuing a credit note is what puts the credit on the customer ledger.
                            A note raised by a sales return belongs to that return and is worked on there.
                        </h3>

                        <a asp-area="Admin" asp-controller="CreditNote" asp-action="CreateCreditNote" class="btn btn-primary float-right">
                            <i class="fas fa-plus"></i> Raise Credit Note
                        </a>
                    </div>

                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="creditNote" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Credit Note No</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Raised By</th>
                                    <th>Credit Value</th>
                                    <th>Left To Spend</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Credit Note No</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Raised By</th>
                                    <th>Credit Value</th>
                                    <th>Left To Spend</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="_CreditNoteDetailsPartial" />

@section Scripts {
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script type="text/javascript">

        function statusBadgeClass(status) {
            switch (status) {
                case 'Issued': return 'badge-success';
                case 'Applied': return 'badge-primary';
                case 'Cancelled': return 'badge-danger';
                default: return 'badge-secondary';
            }
        }

        // A draft credit note owes nothing yet, so it is edited, issued or deleted.
        // Once issued the credit is on the ledger and only a withdrawal takes it off,
        // and that is refused once any of it has been spent. A note that came out of a
        // sales return is not editable here at all.
        function actionButtons(id, status, raisedBy) {

            var buttons = '';

            if (status === 'Draft') {

                if (raisedBy === 'Price adjustment') {
                    buttons += `<a href="/Admin/CreditNote/UpdateCreditNote/${id}"
                                   class="btn btn-info btn-sm mr-1" title="Edit"><i class="fas fa-edit"></i></a>`;
                }

                buttons += `<button type="button" class="btn btn-success btn-sm mr-1 btn-issue" data-id='${id}'
                                title="Issue the credit"><i class="fas fa-check"></i></button>`;
            }

            if (status === 'Issued') {
                buttons += `<button type="button" class="btn btn-warning btn-sm mr-1 btn-cancel" data-id='${id}'
                                title="Withdraw"><i class="fas fa-ban"></i></button>`;
            }

            if (status === 'Draft' || status === 'Cancelled') {
                buttons += `<button type="button" class="btn btn-danger btn-sm show-bs-modal" data-id='${id}'
                                title="Delete"><i class="fas fa-trash"></i></button>`;
            }

            return buttons === '' ? '<span class="text-muted">—</span>' : buttons;
        }

        function postAction(url, data, successTitle) {

            data.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: url,
                type: 'POST',
                data: data,
                success: function (response) {
                    if (response.success) {
                        Swal.fire({ icon: 'success', title: successTitle, text: response.message, timer: 2600, showConfirmButton: false });
                        $('#creditNote').DataTable().ajax.reload(null, false);
                    } else {
                        Swal.fire({ icon: 'error', title: 'Failed!', text: response.message });
                    }
                },
                error: function (error) {
                    if (error.status === 403) {
                        window.location.href = '/Account/AccessDenied';
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: 'The action could not be completed.' });
                    }
                }
            });
        }

        $(function () {
            try {
                $("#creditNote").DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    ajax: {
                        url: "/Admin/CreditNote/GetCreditNoteJsonData",
                        type: "POST",
                        contentType: "application/json",
                        dataType: "json",
                        data: function (d) {
                            return JSON.stringify(d);
                        },
                    },
                    columnDefs: [
                        {
                            orderable: false,
                            targets: 7,
                            render: function (data, type, row) {
                                return actionButtons(data, row[6], row[3]);
                            }
                        },
                        {
                            targets: 6,
                            render: function (data) {
                                return `<span class="badge ${statusBadgeClass(data)}">${data}</span>`;
                            }
                        },
                        ...[0, 1, 2, 3, 4, 5].map(function (target) {
                            return {
                                targets: target,
                                createdCell: function (td, cellData, rowData) {
                                    $(td).addClass('table-row');
                                    $(td).attr('data-id', rowData[7]);
                                }
                            };
                        })
                    ],
                    dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                    "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
                }).buttons().container().appendTo('#creditNote_wrapper .col-md-6:eq(0)');
            } catch (e) {
                console.error("DataTable init error:", e);
            }
        });

        // Row click -> credit note details modal
        $(function () {
            $('#creditNote tbody').on('click', '.table-row', function () {
                var id = $(this).data("id");

                $.ajax({
                    url: `/Admin/CreditNote/GetCreditNoteDetails?id=${id}`,
                    type: 'GET',
                    success: function (data) {

                        $('#CnNo').text(data.creditNoteNo || 'N/A');
                        $('#CnCustomer').text(
                            data.customerName ? `${data.customerName} (${data.customerCode})` : 'N/A');
                        $('#CnReturnNo').text(data.salesReturnNo || '—');
                        $('#CnInvoiceNo').text(data.salesInvoiceNo || '—');
                        $('#CnDate').text(data.creditNoteDate ? new Date(data.creditNoteDate).toLocaleDateString() : 'N/A');
                        $('#CnReason').text(data.reason || 'N/A');
                        $('#CnStatus').text(data.status || 'N/A');
                        $('#CnNotes').text(data.notes || 'N/A');

                        $('#CnSubTotal').text(Number(data.subTotal ?? 0).toFixed(2));
                        $('#CnTax').text(Number(data.totalTax ?? 0).toFixed(2));
                        $('#CnTotal').text(Number(data.totalAmount ?? 0).toFixed(2));
                        $('#CnApplied').text(Number(data.appliedAmount ?? 0).toFixed(2));
                        $('#CnRemaining').text(Number(data.remainingAmount ?? 0).toFixed(2));

                        var body = $('#CnItemsBody').empty();

                        $.each(data.creditNoteItems || [], function (i, item) {
                            var row = $('<tr>');
                            row.append($('<td>').text(item.description || ''));
                            row.append($('<td>').text(item.productName || '—'));
                            row.append($('<td class="text-right">').text(Number(item.quantity ?? 0).toFixed(2)));
                            row.append($('<td class="text-right">').text(Number(item.unitPrice ?? 0).toFixed(2)));
                            row.append($('<td class="text-right">').text(Number(item.taxAmount ?? 0).toFixed(2)));
                            row.append($('<td class="text-right">').text(Number(item.lineTotal ?? 0).toFixed(2)));
                            body.append(row);
                        });

                        $('#creditNoteDetailModal').modal('show');
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) {
                            window.location.href = '/Account/AccessDenied';
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error!', text: 'Failed to load credit note details.' });
                        }
                    }
                });
            });
        });

        $(function () {

            $('#creditNote').on('click', '.btn-issue', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Issue this credit note?',
                    text: 'The customer owes that much less straight away and can spend the credit against an invoice.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: 'Yes, Issue It',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/CreditNote/IssueCreditNote', { id: id }, 'Issued!');
                    }
                });
            });

            $('#creditNote').on('click', '.btn-cancel', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Withdraw this credit note?',
                    text: 'The credit comes back off the customer ledger. None of it must have been spent yet.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Yes, Withdraw It',
                    cancelButtonText: 'Keep It'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/CreditNote/CancelCreditNote', { id: id }, 'Withdrawn!');
                    }
                });
            });

            $('#creditNote').on('click', '.show-bs-modal', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to recover this credit note!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/CreditNote/DeleteCreditNote', { id: id }, 'Deleted!');
                    }
                });
            });

        });
    </script>
}
