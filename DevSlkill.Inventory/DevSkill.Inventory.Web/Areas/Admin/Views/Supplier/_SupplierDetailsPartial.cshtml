<div class="modal fade" id="supplierDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h5 class="modal-title">Supplier Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Supplier Code</dt>
                            <dd class="col-sm-7" id="SupplierCodeText"></dd>

                            <dt class="col-sm-5">Supplier Name</dt>
                            <dd class="col-sm-7" id="SupplierNameText"></dd>

                            <dt class="col-sm-5">Contact Person</dt>
                            <dd class="col-sm-7" id="SupplierContactPerson"></dd>

                            <dt class="col-sm-5">Phone</dt>
                            <dd class="col-sm-7" id="SupplierPhone"></dd>

                            <dt class="col-sm-5">Email</dt>
                            <dd class="col-sm-7" id="SupplierEmail"></dd>

                            <dt class="col-sm-5">Address</dt>
                            <dd class="col-sm-7" id="SupplierAddress"></dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-6">Tax / BIN Number</dt>
                            <dd class="col-sm-6" id="SupplierTaxNumber"></dd>

                            <dt class="col-sm-6">Payment Terms</dt>
                            <dd class="col-sm-6" id="SupplierPaymentTerms"></dd>

                            <dt class="col-sm-6">Status</dt>
                            <dd class="col-sm-6" id="SupplierStatus"></dd>

                            <dt class="col-sm-6">Credit Limit</dt>
                            <dd class="col-sm-6" id="SupplierCreditLimit"></dd>

                            <dt class="col-sm-6">Opening Balance</dt>
                            <dd class="col-sm-6" id="SupplierOpeningBalance"></dd>

                            <dt class="col-sm-6">Current Outstanding</dt>
                            <dd class="col-sm-6 text-danger font-weight-bold" id="SupplierCurrentOutstanding"></dd>

                            <dt class="col-sm-6">Available Credit</dt>
                            <dd class="col-sm-6" id="SupplierAvailableCredit"></dd>

                            <dt class="col-sm-6">Created</dt>
                            <dd class="col-sm-6" id="SupplierCreated"></dd>
                        </dl>
                    </div>
                </div>

                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle"></i>
                    The full purchase, return and payment history of this supplier is on the Supplier Ledger screen.
                </div>

            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
