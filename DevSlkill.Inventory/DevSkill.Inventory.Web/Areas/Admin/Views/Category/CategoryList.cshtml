@{
    ViewData["Title"] = "Category List";
}

<style>
    .toast {
        background-color: #28a745; /* Green background */
        color: white; /* Text color */
    }
    .toast-body{
        width: 100%;
        text-align: center;
    }

</style>

@section Styles {
    <!-- DataTables -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="categoryToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-body d-flex" id="toastMessage">
            <!-- Toast message will be dynamically set here -->
        </div>
    </div>
</div>

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>All Category List</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">category</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">All available category are here!</h3>

                        <a class="btn btn-primary float-right" data-toggle="modal" data-target="#addCategoryModal">
                            <i class="nav-icon"></i>
                            <i class="fas fa-plus"></i> Add Category
                        </a>


                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="categories" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Category Name</th>
                                    <th>Category Code</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Category Name</th>
                                    <th>Category Code</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>


@model CategoryCreateModel
<!-- Modal for adding a new category -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" role="dialog" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCategoryModalLabel">Add New Category</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form method="post" asp-antiforgery="true" id="addCategoryForm" enctype="multipart/form-data">
                    <div class="form-group">
                        <label asp-for="CategoryName">Category Name</label>
                        <input asp-for="CategoryName" type="text" class="form-control" id="categoryName" name="CategoryName" required>
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CategoryCode">Category Code</label>
                        <input asp-for="CategoryCode" type="text" class="form-control" id="categoryCode" name="CategoryCode" required>
                        <span asp-validation-for="CategoryCode" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control" id="description" name="Description" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_CategoryModal" />

<!-- /.content -->
@section Scripts {

    <!-- DataTables  & Plugins -->
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script type="text/javascript">
        $(function () {
            $("#categories").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                ajax: {
                    url: "/Admin/Category/GetCategoryJsonData",
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    data: function (d) {
                        return JSON.stringify(d);
                    },
                },

                columnDefs: [
                    {
                        // Render description column with only 20 words
                        targets: 2,
                        render: function (data, type, row) {
                            var words = data.split(" ");
                            if (words.length > 10) {
                                return words.slice(0, 10).join(" ") + '...';
                            }
                            return data;
                        }
                    },

                /*    {
                        orderable: false,
                        targets: 3,
                        render: function (data, type, row) {
                            console.log(row);
                            return `<button type="submit" class="btn btn-info btn-sm" onclick="window.location.href='/admin/Category/EditCategory/${data}'" value='${data}'>
                                            <i class="fas fa-pencil-alt">
                                            </i>
                                            Edit
                                        </button>
                                        <button type="submit" class="btn btn-danger btn-sm show-bs-modal" data-id='${data}' value='${data}'>
                                            <i class="fas fa-trash">
                                            </i>
                                            Delete
                                        </button>`;
                        }
                    }, */

                    {
                        orderable: false,
                        targets: 3,
                        render: function (data, type, row) {
                            console.log(row);
                            return `<button type="button" class="btn btn-info btn-sm edit-category" data-id='${data}' data-toggle="modal" data-target="#editCategoryModal">
                                                <i class="fas fa-pencil-alt"></i> Edit
                                            </button>

                                            <button type="submit" class="btn btn-danger btn-sm show-bs-modal" data-id='${data}' value='${data}'>
                                                <i class="fas fa-trash">
                                                </i>
                                                Delete
                                            </button>`;
                        }
                    },


                ],

                dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
            }).buttons().container().appendTo('#categories_wrapper .col-md-6:eq(0)');
        });

        //This code for delete
        $('#categories').on('click', '.show-bs-modal', function () {
            let id = $(this).data("id");
            let modal = $("#modal-default");
            modal.find('.modal-body p').text('Are you sure you want to delete this record?');
            $("#deleteId").val(id);
            $("#deleteForm").attr("action", "/admin/Category/CategoryDelete");
            modal.modal('show');
        });

        $("#deleteButton").click(function () {
            $("#deleteForm").submit();
        });

        //This code for create category...
        $(document).ready(function () {
            // Handle form submission
            $('#addCategoryForm').on('submit', function (e) {
                e.preventDefault();

                $.ajax({
                    url: '/Admin/Category/AddCategory', 
                    method: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            // Close the modal
                            $('#addCategoryModal').modal('hide');
                            $('#addCategoryForm')[0].reset();

                            // Display toast notification
                            $('#toastMessage').text(response.message);
                            $('#categoryToast').toast({
                                delay: 3000 // 3 seconds
                            });
                            $('#categoryToast').toast('show');
                            // Refresh the DataTable
                            $('#categories').DataTable().ajax.reload();
                        } else {
                            // Handle validation errors or any other errors
                            // Display toast notification
                            $('#toastMessage').text(response.message);
                            $('#categoryToast').toast({
                                delay: 3000
                            });
                            $('#categoryToast').toast('show');
                        }
                    },
                    error: function (error) {
                        $('#toastMessage').text('There was an error adding the category.');
                        $('#categoryToast').toast({
                            delay: 3000
                        });
                        $('#categoryToast').toast('show');
                    }
                });
            });
        });


        //This code for temp data response fadeOut
        $(document).ready(function () {
            setTimeout(function () {
                $('#response-alert').fadeOut('slow');
            }, 3000);
        });



        //for edit code
        $(document).ready(function () {
            // Handle the click event for the edit button
            $('#categories').on('click', '.edit-category', function () {
                var categoryId = $(this).data('id');
                console.log("clciked button");
                // Use AJAX to fetch the category data
                $.ajax({
                    url: '/Admin/Category/GetCategoryById', // Adjust to your route
                    method: 'GET',
                    data: { id: categoryId },
                    success: function (response) {
                        console.log(response.data.result.categoryName);
                        if (response.success) {
                            // Populate the modal fields with the category data
                            $('#editCategoryId').val(response.data.result.id);
                            $('#editCategoryName').val(response.data.result.categoryName);
                            $('#editCategoryCode').val(response.data.result.categoryCode);
                            $('#editDescription').val(response.data.result.description);

                            // Open the modal (bootstrap handles this)
                            $('#editCategoryModal').modal('show');
                        } else {
                            // Handle the error case (show a message or log)
                            alert('Error fetching category data');
                        }
                    },
                    error: function () {
                        alert('An error occurred while fetching the category data.');
                    }
                });
            });

            // Handle the form submission for editing a category
            $('#editCategoryForm').on('submit', function (e) {
                e.preventDefault();

                $.ajax({
                    url: '/Admin/Category/EditCategoryModal', // Adjust to your route
                    method: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            // Close the modal
                            $('#editCategoryModal').modal('hide');
                            $('#editCategoryForm')[0].reset();

                            // Display toast notification
                            $('#toastMessage').text(response.message);
                            $('#categoryToast').toast({
                                delay: 3000 // 3 seconds
                            });
                            $('#categoryToast').toast('show');

                            // Refresh the DataTable
                            $('#categories').DataTable().ajax.reload();
                        } else {
                            // Handle validation or other errors
                            $('#toastMessage').text(response.message);
                            $('#categoryToast').toast({
                                delay: 3000
                            });
                            $('#categoryToast').toast('show');
                        }
                    },
                    error: function () {
                        $('#toastMessage').text('There was an error editing the category.');
                        $('#categoryToast').toast({
                            delay: 3000
                        });
                        $('#categoryToast').toast('show');
                    }
                });
            });
        });


       
    </script>
}

