@model BusinessLocationUpdateModel
<!-- Modal for update the business location -->
<div class="modal fade" id="updateBusinessLocationModal" tabindex="-1" role="dialog" aria-labelledby="updateBusinessLocationModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateBusinessLocationModalLabel">Update The Business Location</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form method="post" asp-antiforgery="true" id="updateBusinessLocationForm" enctype="multipart/form-data">
                    <input asp-for="Id" type="hidden" id="updateBusinessLocationId" name="Id" />
                    <div class="form-group">
                        <label asp-for="LocationName">Location Name</label>
                        <input asp-for="LocationName" type="text" class="form-control" id="editLocationName" name="LocationName" required>
                        <span asp-validation-for="LocationName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Address">Address</label>
                        <textarea asp-for="Address" class="form-control" id="editAddress" name="Address" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="City">City</label>
                        <input asp-for="City" type="text" class="form-control" id="editCity" name="City" required>
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="State">State</label>
                        <input asp-for="State" type="text" class="form-control" id="editState" name="State" required>
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ZipCode">Zip Code</label>
                        <input asp-for="ZipCode" type="text" class="form-control" id="editZipCode" name="ZipCode" required>
                        <span asp-validation-for="ZipCode" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Country">Country</label>
                        <input asp-for="Country" type="text" class="form-control" id="editCountry" name="Country" required>
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>
