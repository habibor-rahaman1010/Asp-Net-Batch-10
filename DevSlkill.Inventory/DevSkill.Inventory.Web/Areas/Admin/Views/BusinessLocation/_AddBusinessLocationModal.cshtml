@model BusinessLocationCreateModel
<!-- Modal for adding a new Business Location -->
<div class="modal fade" id="addBusinessLocationModal" tabindex="-1" role="dialog" aria-labelledby="addWarantyModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addWarrantyModalLabel">Add New Business Location</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form method="post" asp-antiforgery="true" id="addBusinessLocationForm" enctype="multipart/form-data">
                    <div class="form-group">
                        <label asp-for="LocationName">Location Name</label>
                        <input asp-for="LocationName" type="text" class="form-control" id="locationName" name="LocationName" required>
                        <span asp-validation-for="LocationName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Address">Address</label>
                        <textarea asp-for="Address" class="form-control" id="address" name="Address" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="City">City</label>
                        <input asp-for="City" type="text" class="form-control" id="city" name="City" required>
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="State">State</label>
                        <input asp-for="State" type="text" class="form-control" id="state" name="State" required>
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ZipCode">Zip Code</label>
                        <input asp-for="ZipCode" type="text" class="form-control" id="zipCode" name="ZipCode" required>
                        <span asp-validation-for="ZipCode" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Country">Country</label>
                        <input asp-for="Country" type="text" class="form-control" id="country" name="Country" required>
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

