@model List<SalesReturnItemModel>

@*
    The return grid, shared by the create and update screens. Product, invoiced
    quantity and unit price all come off the invoice and are read only; only what
    is coming back is typed.
*@

<div class="card">

    <div class="card-header">
        <h3 class="card-title">Returned Products</h3>
    </div>

    <div class="card-body">

        <div class="alert alert-warning">
            <i class="fas fa-undo"></i>
            <strong>Coming Back</strong> is the quantity that goes onto the shelf again, and it does
            so only when the return is confirmed. A line can never go past what the invoice actually
            billed, less whatever has already come back.
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th width="24%">Product</th>
                        <th width="8%">Unit</th>
                        <th width="10%">Invoiced</th>
                        <th width="11%">Already Back</th>
                        <th width="10%">Pending</th>
                        <th width="10%">Returnable</th>
                        <th width="12%">Coming Back</th>
                        <th width="8%">Unit Price</th>
                        <th width="7%">Line Total</th>
                    </tr>
                </thead>

                <tbody id="returnTableBody">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model[i].ProductName
                                <input type="hidden" name="SalesReturnItems[@i].ProductId" value="@Model[i].ProductId" />
                                <input type="hidden" name="SalesReturnItems[@i].ProductName" value="@Model[i].ProductName" />
                                <input type="hidden" name="SalesReturnItems[@i].UnitName" value="@Model[i].UnitName" />
                                <input type="hidden" name="SalesReturnItems[@i].InvoicedQuantity" value="@Model[i].InvoicedQuantity" />
                                <input type="hidden" name="SalesReturnItems[@i].AlreadyReturnedQuantity" value="@Model[i].AlreadyReturnedQuantity" />
                                <input type="hidden" name="SalesReturnItems[@i].PendingQuantity" value="@Model[i].PendingQuantity" />
                                <input type="hidden" name="SalesReturnItems[@i].RemainingQuantity" value="@Model[i].RemainingQuantity" class="returnable-qty" />
                                <input type="hidden" name="SalesReturnItems[@i].UnitPrice" value="@Model[i].UnitPrice" class="unit-price" />
                                <input type="hidden" name="SalesReturnItems[@i].TaxRate" value="@Model[i].TaxRate" class="tax-rate" />
                                <input type="hidden" name="SalesReturnItems[@i].Remarks" value="@Model[i].Remarks" />
                            </td>

                            <td>@Model[i].UnitName</td>
                            <td class="text-right">@Model[i].InvoicedQuantity.ToString("N2")</td>
                            <td class="text-right">@Model[i].AlreadyReturnedQuantity.ToString("N2")</td>
                            <td class="text-right">@Model[i].PendingQuantity.ToString("N2")</td>
                            <td class="text-right font-weight-bold">@Model[i].RemainingQuantity.ToString("N2")</td>

                            <td>
                                <input name="SalesReturnItems[@i].ReturnQuantity" value="@Model[i].ReturnQuantity"
                                       type="number" step="1" min="0" class="form-control return-qty" />
                            </td>

                            <td class="text-right">@Model[i].UnitPrice.ToString("N2")</td>
                            <td><input class="form-control line-total" value="0.00" readonly /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">
                <i class="fas fa-info-circle"></i>
                Choose a sales invoice above and its returnable lines will appear here.
            </div>
        }

        <div class="row justify-content-end">
            <div class="col-md-4">
                <table class="table table-sm">
                    <tr class="bg-light">
                        <th>Credit To Customer</th>
                        <th class="text-right" id="sumReturnValue">0.00</th>
                    </tr>
                </table>
            </div>
        </div>

    </div>

</div>
