@model PurchaseOrderUpdateModel;

@{
    ViewData["Title"] = "Update Purchase Order";
}

<section class="content mt-2">
    <div class="container-fluid">
        <form asp-antiforgery="true" asp-area="Admin" asp-controller="PurchaseOrder" asp-action="UpdatePurchaseOrder" method="post">

            <input type="hidden" asp-for="Id" />

            <!-- Header -->
            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">Update Purchase Order</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PurchaseOrderNo"></label>
                                <input asp-for="PurchaseOrderNo" class="form-control" readonly />
                                <small class="form-text text-muted">The order number is issued once and never changes.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="OrderDate">Order Date*</label>
                                <input asp-for="OrderDate" type="date" class="form-control" />
                                <span asp-validation-for="OrderDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ExpectedDeliveryDate">Expected Delivery*</label>
                                <input asp-for="ExpectedDeliveryDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpectedDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PurchaseRequisitionNo"></label>
                                <input asp-for="PurchaseRequisitionNo" class="form-control" readonly />
                                <small class="form-text text-muted">The source requisition is fixed once the order exists.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SupplierId">Supplier*</label>

                                @* The order is a commitment to this supplier, so it is shown but never
                                   edited. The disabled select posts nothing; the hidden field carries it. *@
                                <input type="hidden" asp-for="SupplierId" id="SupplierIdHidden" />
                                <select asp-for="SupplierId" asp-items="Model.Suppliers" class="form-control" disabled></select>

                                <small class="form-text text-muted">The supplier is fixed once the order is created.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="BusinessLocationId">Warehouse*</label>

                                <input type="hidden" asp-for="BusinessLocationId" id="BusinessLocationIdHidden" />
                                <select asp-for="BusinessLocationId" asp-items="Model.BusinessLocations" class="form-control" disabled></select>

                                <small class="form-text text-muted">The warehouse is fixed once the order is created.</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PaymentTermId"></label>
                                <select asp-for="PaymentTermId" asp-items="Model.PaymentTerms" class="form-control"></select>
                                <span asp-validation-for="PaymentTermId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Status">Status*</label>
                                <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                <small class="form-text text-muted">Approval, receiving and closing are done from the list screen.</small>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="OtherCharges"></label>
                                <input asp-for="OtherCharges" type="number" step="0.01" min="0" class="form-control" id="OtherCharges" />
                                <span asp-validation-for="OtherCharges" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="Notes"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <partial name="_PurchaseOrderLinesPartial" model="Model.PurchaseOrderItems" />

            <div class="card">
                <div class="card-body text-center">
                    <button type="submit" class="btn btn-primary">Update Purchase Order</button>
                    <a asp-area="Admin" asp-controller="PurchaseOrder" asp-action="PurchaseOrderList" class="btn btn-danger">Cancel</a>
                </div>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_PurchaseOrderLinesScriptPartial" />

    <script>

        var rowIndex = @Model.PurchaseOrderItems.Count;

        $(document).ready(function () {

            updateDeleteButtons();
            captureRenderedProducts();

            // Show the saved lines with their current server side arithmetic straight away.
            refreshAllLines();

            $("#btnAddProduct").click(function () {

                appendRow(rowIndex);
                rowIndex++;

                updateDeleteButtons();
            });

            $("#ExpectedDeliveryDate, #OrderDate").on("change", function () {

                var orderDate = $("#OrderDate").val();
                var deliveryDate = $("#ExpectedDeliveryDate").val();

                if (orderDate && deliveryDate && deliveryDate < orderDate) {
                    Swal.fire({
                        icon: "warning",
                        title: "Invalid Date",
                        text: "Expected Delivery cannot be earlier than the order date.",
                        confirmButtonText: "OK"
                    });

                    $("#ExpectedDeliveryDate").val(orderDate);
                }
            });

        });

    </script>
}
