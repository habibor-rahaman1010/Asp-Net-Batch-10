@model SalesQuotationCreateModel;

@{
    ViewData["Title"] = "Create Sales Quotation";
}

<section class="content mt-2">
    <div class="container-fluid">
        <form asp-antiforgery="true" asp-area="Admin" asp-controller="SalesQuotation" asp-action="CreateSalesQuotation" method="post">

            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">Sales Quotation</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="QuotationNo"></label>
                                <input asp-for="QuotationNo" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="CustomerId">Customer*</label>
                                <select asp-for="CustomerId" asp-items="Model.Customers" class="form-control" id="CustomerId"></select>
                                <small class="form-text text-muted">The customer decides which price list and discount rules apply.</small>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="BusinessLocationId">Warehouse*</label>
                                <select asp-for="BusinessLocationId" asp-items="Model.BusinessLocations" class="form-control" id="BusinessLocationId"></select>
                                <small class="form-text text-muted">Its products are the ones that may be quoted.</small>
                                <span asp-validation-for="BusinessLocationId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="QuotationDate">Quotation Date*</label>
                                <input asp-for="QuotationDate" type="date" class="form-control" id="QuotationDate" />
                                <span asp-validation-for="QuotationDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="ValidUntil">Valid Until*</label>
                                <input asp-for="ValidUntil" type="date" class="form-control" id="ValidUntil" />
                                <small class="form-text text-muted">After this date the prices are no longer being held.</small>
                                <span asp-validation-for="ValidUntil" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="SalespersonId"></label>
                                <select asp-for="SalespersonId" asp-items="Model.Salespersons" class="form-control"></select>
                                <span asp-validation-for="SalespersonId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="PaymentTermId"></label>
                                <select asp-for="PaymentTermId" asp-items="Model.PaymentTerms" class="form-control"></select>
                                <span asp-validation-for="PaymentTermId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="CustomerReference"></label>
                                <input asp-for="CustomerReference" class="form-control" placeholder="Their enquiry or tender number" />
                                <span asp-validation-for="CustomerReference" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="OtherCharges"></label>
                                <input asp-for="OtherCharges" type="number" step="0.01" min="0" class="form-control" id="OtherCharges" />
                                <small class="form-text text-muted">Freight and the like, belonging to no single line.</small>
                                <span asp-validation-for="OtherCharges" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Status">Status*</label>
                                <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                <small class="form-text text-muted"><strong>Sent</strong> hands the offer to the customer straight away.</small>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Notes"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <partial name="_SalesQuotationLinesPartial" model="Model.SalesQuotationItems" />

            <div class="card">
                <div class="card-body text-center">
                    <button type="submit" class="btn btn-primary">Save Sales Quotation</button>
                    <a asp-area="Admin" asp-controller="SalesQuotation" asp-action="SalesQuotationList" class="btn btn-danger">Cancel</a>
                </div>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_SalesQuotationLinesScriptPartial" />

    <script>

        var rowIndex = @Model.SalesQuotationItems.Count;

        function loadWarehouseProducts(warehouseId, done) {

            if (!warehouseId) {
                warehouseProducts = [];
                $(".product-select").each(function () { loadProducts($(this)); });
                recalculateTotals();
                return;
            }

            $.ajax({
                url: "/Admin/SalesQuotation/GetProductsByWarehouse",
                type: "GET",
                data: { warehouseId: warehouseId },
                success: function (response) {

                    warehouseProducts = response;

                    $(".product-select").each(function () { loadProducts($(this)); });

                    // Nothing can be quoted out of a warehouse that stocks nothing, so
                    // that is said here rather than being discovered at the save.
                    if (warehouseProducts.length === 0) {
                        Swal.fire({
                            icon: "warning",
                            title: "No Product Here",
                            text: "This warehouse has no active product, so nothing can be quoted from it.",
                            confirmButtonText: "OK"
                        });
                    }

                    if (done) { done(); } else { recalculateTotals(); }
                },
                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Products Not Loaded",
                        text: "The products of the selected warehouse could not be loaded.",
                        confirmButtonText: "OK"
                    });
                }
            });
        }

        $(document).ready(function () {

            updateDeleteButtons();
            captureRenderedProducts();
            refreshAllLines();

            // A quotation is served out of one warehouse, so its products decide what
            // the lines may hold. Changing it starts the lines over.
            $("#BusinessLocationId").on("change", function () {

                $("#productTableBody tr").each(function () {
                    clearLinePreview($(this));
                });

                loadWarehouseProducts($(this).val());
            });

            // The customer decides the price list and the discount rules, so the lines
            // are priced again as soon as it changes.
            $("#CustomerId").on("change", function () {
                refreshAllLines();
            });

            $("#btnAddProduct").click(function () {

                if (!$("#BusinessLocationId").val()) {

                    Swal.fire({
                        icon: "warning",
                        title: "Warehouse Required",
                        text: "Select a warehouse first, its products are the ones you can quote.",
                        confirmButtonText: "OK"
                    });

                    return;
                }

                appendRow(rowIndex);
                rowIndex++;

                updateDeleteButtons();
            });

            $("#QuotationDate, #ValidUntil").on("change", function () {

                var quotationDate = $("#QuotationDate").val();
                var validUntil = $("#ValidUntil").val();

                if (quotationDate && validUntil && validUntil < quotationDate) {
                    Swal.fire({
                        icon: "warning",
                        title: "Invalid Date",
                        text: "An offer cannot expire before the day it was made.",
                        confirmButtonText: "OK"
                    });

                    $("#ValidUntil").val(quotationDate);
                }
            });

        });

    </script>
}
