@model SalesQuotationUpdateModel;

@{
    ViewData["Title"] = "Update Sales Quotation";
}

<section class="content mt-2">
    <div class="container-fluid">
        <form asp-antiforgery="true" asp-area="Admin" asp-controller="SalesQuotation" asp-action="UpdateSalesQuotation" method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CustomerId" />
            <input type="hidden" asp-for="BusinessLocationId" />

            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">Update Sales Quotation</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="QuotationNo"></label>
                                <input asp-for="QuotationNo" class="form-control" readonly />
                                <small class="form-text text-muted">The quotation number is issued once and never changes.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="CustomerId">Customer</label>
                                <select asp-items="Model.Customers" class="form-control" disabled>
                                    <option value="@Model.CustomerId" selected></option>
                                </select>
                                <small class="form-text text-muted">An offer never moves to another customer.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="BusinessLocationId">Warehouse</label>
                                <select asp-items="Model.BusinessLocations" class="form-control" disabled>
                                    <option value="@Model.BusinessLocationId" selected></option>
                                </select>
                                <small class="form-text text-muted">The warehouse is fixed once the offer exists.</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="QuotationDate">Quotation Date*</label>
                                <input asp-for="QuotationDate" type="date" class="form-control" id="QuotationDate" />
                                <span asp-validation-for="QuotationDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="ValidUntil">Valid Until*</label>
                                <input asp-for="ValidUntil" type="date" class="form-control" id="ValidUntil" />
                                <span asp-validation-for="ValidUntil" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="SalespersonId"></label>
                                <select asp-for="SalespersonId" asp-items="Model.Salespersons" class="form-control"></select>
                                <span asp-validation-for="SalespersonId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="PaymentTermId"></label>
                                <select asp-for="PaymentTermId" asp-items="Model.PaymentTerms" class="form-control"></select>
                                <span asp-validation-for="PaymentTermId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="CustomerReference"></label>
                                <input asp-for="CustomerReference" class="form-control" />
                                <span asp-validation-for="CustomerReference" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="OtherCharges"></label>
                                <input asp-for="OtherCharges" type="number" step="0.01" min="0" class="form-control" id="OtherCharges" />
                                <span asp-validation-for="OtherCharges" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Status">Status*</label>
                                <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                <small class="form-text text-muted">
                                    Accepting, rejecting and expiring are done from the list, not here.
                                </small>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Notes"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <partial name="_SalesQuotationLinesPartial" model="Model.SalesQuotationItems" />

            <div class="card">
                <div class="card-body text-center">
                    <button type="submit" class="btn btn-primary">Update Sales Quotation</button>
                    <a asp-area="Admin" asp-controller="SalesQuotation" asp-action="SalesQuotationList" class="btn btn-danger">Cancel</a>
                </div>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_SalesQuotationLinesScriptPartial" />

    <script>

        var rowIndex = @Model.SalesQuotationItems.Count;

        $(document).ready(function () {

            updateDeleteButtons();
            captureRenderedProducts();

            // Show the saved lines with their current server side arithmetic straight away.
            refreshAllLines();

            $("#btnAddProduct").click(function () {

                appendRow(rowIndex);
                rowIndex++;

                updateDeleteButtons();
            });

            $("#QuotationDate, #ValidUntil").on("change", function () {

                var quotationDate = $("#QuotationDate").val();
                var validUntil = $("#ValidUntil").val();

                if (quotationDate && validUntil && validUntil < quotationDate) {
                    Swal.fire({
                        icon: "warning",
                        title: "Invalid Date",
                        text: "An offer cannot expire before the day it was made.",
                        confirmButtonText: "OK"
                    });

                    $("#ValidUntil").val(quotationDate);
                }
            });

        });

    </script>
}
