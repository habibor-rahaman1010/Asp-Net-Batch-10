@model UnitCreateModel
<!-- Modal for adding a new warranty -->
<div class="modal fade" id="addWarrantyModal" tabindex="-1" role="dialog" aria-labelledby="addWarantyModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addWarrantyModalLabel">Add New Warranty</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form method="post" asp-antiforgery="true" id="addWarrantyForm" enctype="multipart/form-data">
                    <div class="form-group">
                        <label asp-for="UnitName">Unit Name</label>
                        <input asp-for="UnitName" type="text" class="form-control" id="unitName" name="UnitName" required>
                        <span asp-validation-for="UnitName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ShortName">Short Name</label>
                        <input asp-for="ShortName" type="text" class="form-control" id="shortName" name="ShortName" required>
                        <span asp-validation-for="ShortName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AllowDecimal">Allow Decimal</label>
                        <textarea asp-for="AllowDecimal" class="form-control" id="WarrantyDuration" name="WarrantyDuration" rows="3"></textarea>
                        <span asp-validation-for="AllowDecimal" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>
