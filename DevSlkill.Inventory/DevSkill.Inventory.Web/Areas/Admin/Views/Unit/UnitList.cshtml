@{
    ViewData["Title"] = "Unit List";
}

<style>
    .toast {
        background-color: #28a745;
        color: white;
    }

    .toast-body {
        width: 100%;
        text-align: center;
    }

</style>

@section Styles {
    <!-- DataTables -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="unitToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-body d-flex" id="toastMessage">
            <!-- Toast message will be dynamically set here -->
        </div>
    </div>
</div>

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>All Unit List</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Unit</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">All available Unit are here!</h3>

                        <a class="btn btn-primary float-right" data-toggle="modal" data-target="#addUnitModal">
                            <i class="nav-icon"></i>
                            <i class="fas fa-plus"></i> Add Unit
                        </a>


                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="units" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Unit Name</th>
                                    <th>Unit Short Name</th>
                                    <th>Allow Decimal</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Unit Name</th>
                                    <th>Unit Short Name</th>
                                    <th>Allow Decimal</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>

<partial name="_UnitCreateModal" />
<partial name="_UpdateUnitModal" />

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabel">Delete Confirmation</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this record?</p>
                <p>If you delete this it gone forever!</p>
            </div>
            <div class="modal-footer">
                <!-- The form that will be submitted when delete is confirmed -->
                <form method="POST" id="unit-form" asp-antiforgery="true" , enctype="multipart/form-data">
                    <!-- Hidden input to store the ID of the item to be deleted -->
                    <input type="hidden" id="delete-id" name="id">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="unit-delete">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!-- DataTables  & Plugins -->
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script type="text/javascript">
        //Load data in table used by DataTable...
        $(function () {
            $("#units").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                ajax: {
                    url: "/Admin/Unit/GetUnitJsonResponse",
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    data: function (d) {
                        console.log(d);
                        return JSON.stringify(d);
                    }
                },

                columnDefs: [
                    {
                        orderable: false,
                        targets: 3,
                        render: function (data, type, row) {
                            return `<button type="button" class="btn btn-info btn-sm update-unit" data-id='${data}' data-toggle="modal" data-target="#editCategoryModal">
                                                                        <i class="fas fa-pencil-alt"></i> Edit
                                                                    </button>

                                                                    <button type="submit" class="btn btn-danger btn-sm show-bs-modal" data-id='${data}' value='${data}'>
                                                                        <i class="fas fa-trash">
                                                                        </i>
                                                                        Delete
                                                                    </button>`;
                        }
                    },
                ],

                dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]

            }).buttons().container().appendTo('#warranties_wrapper .col-md-6:eq(0)');

            //This code create a new Unit Magerment...
            $(document).ready(function () {
                // Handle form submission
                $('#addUnitForm').on('submit', function (e) {
                    e.preventDefault();

                    $.ajax({
                        url: '/Admin/Unit/AddUnit',
                        method: 'POST',
                        data: $(this).serialize(),
                        success: function (response) {
                            if (response.success) {
                                // Close the modal
                                $('#addUnitModal').modal('hide');
                                $('#addUnitForm')[0].reset();

                                // Display toast notification
                                $('#toastMessage').text(response.message);
                                $('#unitToast').toast({
                                    delay: 3000
                                });
                                $('#unitToast').toast('show');
                                // Refresh the DataTable
                                $('#units').DataTable().ajax.reload();
                            } 
                            else {
                                // Handle validation errors or any other errors
                                // Display toast notification
                                $('#toastMessage').text(response.message);
                                $('#unitToast').toast({
                                    delay: 3000
                                });
                                $('#unitToast').toast('show');
                            }
                        },
                        error: function (error) {
                            $('#toastMessage').text('There was an error adding the Unit Magerment.');
                            $('#unitToast').toast({
                                delay: 3000
                            });
                            $('#unitToast').toast('show');
                        }
                    });
                });
            });


            //This code for Unit delete...
            $('#units').on('click', '.show-bs-modal', function (e) {
                let id = $(this).data("id");
                $("#delete-id").val(id);
                $("#unit-form").attr("action", "/Admin/Unit/DeleteUnit");
                $("#delete-modal").modal('show')
            });

            $("#unit-delete").click(function () {
                $("#unit-form").submit();
            });


            //This code for Unit Update...
            $(document).ready(function () {
                // Handle the click event for the edit button
                $('#units').on('click', '.update-unit', function () {
                    var warrantyId = $(this).data('id');
                    console.log("button is clicked");

                    // Use AJAX to fetch the Unit Magerment data
                    $.ajax({
                        url: '/Admin/Unit/GetUnitById',
                        method: 'GET',
                        data: { id: warrantyId },
                        success: function (response) {
                            console.log(response)
                            if (response.success) {
                                // Populate the modal fields with the Unit Magerment data
                                $('#updateUnitId').val(response.data.result.id);
                                $('#editUnitName').val(response.data.result.unitName);
                                $('#editShortName').val(response.data.result.shortName);
                                $('#editStatus').val(response.data.result.allowDecimal.toString());

                                // Open the modal (bootstrap handles this)
                                $('#updateUnitModal').modal('show');
                            }
                            else {
                                alert('Error fetching Unit Magerment data');
                            }
                        },
                        error: function () {
                            alert('An error occurred while fetching the Unit Magerment data.');
                        }
                    });
                });

                // Handle the form submission for editing a Unit Magerment
                $('#updateUnitForm').on('submit', function (e) {
                    e.preventDefault();

                    $.ajax({
                        url: '/Admin/Unit/EditUnit',
                        method: 'POST',
                        data: $(this).serialize(),
                        success: function (response) {
                            if (response.success) {
                                // Close the modal and reset
                                $('#updateUnitModal').modal('hide');
                                $('#updateUnitForm')[0].reset();

                                // Display toast notification
                                $('#toastMessage').text(response.message);
                                $('#unitToast').toast({
                                    delay: 3000
                                });
                                $('#unitToast').toast('show');

                                // Refresh the DataTable
                                $('#units').DataTable().ajax.reload();
                            }
                            else {
                                $('#toastMessage').text(response.message);
                                $('#unitToast').toast({
                                    delay: 3000
                                });
                                $('#unitToast').toast('show');
                            }
                        },
                        error: function () {
                            $('#toastMessage').text('There was an error editing the Unit Magerment.');
                            $('#unitToast').toast({
                                delay: 3000
                            });
                            $('#unitToast').toast('show');
                        }
                    });
                });
            });

            //This code for temp data response fadeOut
            $(document).ready(function () {
                setTimeout(function () {
                    $('#response-alert').fadeOut('slow');
                }, 3000);
            });

        });

    </script>
}

