@model UnitUpdateModel
<!-- Modal for Update Unit Magerment -->
<div class="modal fade" id="updateUnitModal" tabindex="-1" role="dialog" aria-labelledby="updateUnitModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateUnitModalLabel">Update The Unit</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form method="post" asp-antiforgery="true" id="updateUnitForm" enctype="multipart/form-data">
                    <input asp-for="Id" type="hidden" id="updateUnitId" name="Id" />
                    <div class="form-group">
                        <label asp-for="UnitName">Unit Name</label>
                        <input asp-for="UnitName" type="text" class="form-control" id="editUnitName" name="UnitName" required>
                        <span asp-validation-for="UnitName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ShortName">Short Name</label>
                        <input asp-for="ShortName" type="text" class="form-control" id="editShortName" name="ShortName" required>
                        <span asp-validation-for="ShortName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AllowDecimal">Allow Decimal</label>
                        <select asp-for="AllowDecimal" asp-items="ViewBag.AllowDecimalOptions" id="editStatus" class="form-control"></select>
                        <span asp-validation-for="AllowDecimal" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>
