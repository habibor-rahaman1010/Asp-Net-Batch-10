@model RequestForQuotationCreateModel;

@{
    ViewData["Title"] = "Create Request For Quotation";
    ViewData["Products"] = Model.Products;
}

<section class="content mt-2">
    <div class="container-fluid">
        <form asp-antiforgery="true" asp-area="Admin" asp-controller="RequestForQuotation" asp-action="CreateRequestForQuotation" method="post">

            <!-- Header -->
            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">Request For Quotation</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="RfqNo"></label>
                                <input asp-for="RfqNo" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="RfqDate">RFQ Date*</label>
                                <input asp-for="RfqDate" type="date" class="form-control" />
                                <span asp-validation-for="RfqDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ResponseDeadline">Response Deadline*</label>
                                <input asp-for="ResponseDeadline" type="date" class="form-control" />
                                <small class="form-text text-muted">
                                    A quotation received after this date is still recorded, but it is
                                    flagged as expired when the offers are compared.
                                </small>
                                <span asp-validation-for="ResponseDeadline" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="PurchaseRequisitionId"></label>
                                <select asp-for="PurchaseRequisitionId" asp-items="Model.PurchaseRequisitions" class="form-control" id="PurchaseRequisitionId"></select>
                                <small class="form-text text-muted">
                                    Only approved requisitions are listed. Picking one fills the grid
                                    below with what it asked for.
                                </small>
                                <span asp-validation-for="PurchaseRequisitionId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="BusinessLocationId">Warehouse*</label>
                                <select asp-for="BusinessLocationId" asp-items="Model.BusinessLocations" class="form-control" id="BusinessLocationId"></select>
                                <span asp-validation-for="BusinessLocationId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Status">Status*</label>
                                <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                <small class="form-text text-muted">
                                    Suppliers can only quote against a request that has been sent.
                                </small>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="Notes"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"
                                          placeholder="Terms, delivery expectations, anything the suppliers should know."></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <partial name="_RequestForQuotationLinesPartial" model="Model.RequestForQuotationItems" view-data="ViewData" />

            <div class="card">
                <div class="card-body text-center">
                    <button type="submit" class="btn btn-primary">Save Request</button>
                    <a asp-area="Admin" asp-controller="RequestForQuotation" asp-action="RequestForQuotationList" class="btn btn-danger">Cancel</a>
                </div>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RequestForQuotationLinesScriptPartial" />

    <script>

        var rowIndex = @Model.RequestForQuotationItems.Count;

        $(document).ready(function () {

            updateDeleteButtons();
            captureRenderedProducts();

            $("#productTableBody tr").each(function () {
                refreshStock($(this));
            });

            // A requisition already says what is needed and where, so choosing one
            // rebuilds the grid instead of making the buyer retype it.
            $("#PurchaseRequisitionId").on("change", function () {

                var requisitionId = $(this).val();

                if (!requisitionId) {
                    return;
                }

                $.ajax({
                    url: "/Admin/RequestForQuotation/GetRequisitionLines",
                    type: "GET",
                    data: { purchaseRequisitionId: requisitionId },
                    success: function (response) {

                        if (!response.success) {
                            Swal.fire({ icon: "error", title: "Not Loaded", text: response.message });
                            return;
                        }

                        $("#BusinessLocationId").val(response.warehouseId);

                        $("#productTableBody").empty();
                        rowIndex = 0;

                        $.each(response.lines, function (i, line) {

                            appendRow(rowIndex);

                            var row = $("#productTableBody tr:last");

                            row.find(".product-select").val(line.productId);
                            row.find(".line-qty").val(line.quantity);
                            row.find("input[name$='.Remarks']").val(line.remarks);

                            refreshStock(row);

                            rowIndex++;
                        });

                        if (rowIndex === 0) {
                            appendRow(rowIndex);
                            rowIndex++;
                        }

                        updateDeleteButtons();
                    },
                    error: function () {
                        Swal.fire({
                            icon: "error",
                            title: "Requisition Not Loaded",
                            text: "The lines of the selected requisition could not be loaded.",
                            confirmButtonText: "OK"
                        });
                    }
                });

            });

            $("#btnAddProduct").click(function () {

                appendRow(rowIndex);
                rowIndex++;

                updateDeleteButtons();
            });

            $("#RfqDate, #ResponseDeadline").on("change", function () {

                var rfqDate = $("#RfqDate").val();
                var deadline = $("#ResponseDeadline").val();

                if (rfqDate && deadline && deadline < rfqDate) {
                    Swal.fire({
                        icon: "warning",
                        title: "Invalid Date",
                        text: "The response deadline cannot be earlier than the RFQ date.",
                        confirmButtonText: "OK"
                    });

                    $("#ResponseDeadline").val(rfqDate);
                }
            });

        });

    </script>
}
