@{
    ViewData["Title"] = "Request For Quotation List";
}

@section Styles {
    <!-- DataTables -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Requests For Quotation</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Purchase</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Suppliers can only quote against a request that has been sent.</h3>

                        <a asp-area="Admin" asp-controller="RequestForQuotation" asp-action="CreateRequestForQuotation" class="btn btn-primary float-right">
                            <i class="fas fa-plus"></i> Add RFQ
                        </a>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="requestForQuotation" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>RFQ No</th>
                                    <th>RFQ Date</th>
                                    <th>Deadline</th>
                                    <th>Warehouse</th>
                                    <th>Requisition</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>RFQ No</th>
                                    <th>RFQ Date</th>
                                    <th>Deadline</th>
                                    <th>Warehouse</th>
                                    <th>Requisition</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>

<partial name="_RequestForQuotationDetailsPartial" />

<!-- /.content -->
@section Scripts {
    <!-- DataTables  & Plugins -->
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script type="text/javascript">

        function statusBadgeClass(status) {
            switch (status) {
                case 'Sent': return 'badge-info';
                case 'Awarded': return 'badge-success';
                case 'Closed': return 'badge-dark';
                case 'Cancelled': return 'badge-danger';
                default: return 'badge-secondary';
            }
        }

        // A draft is still being written, so it can be edited, sent or deleted. Once it
        // is sent the lines are frozen and the request either gets awarded from the
        // comparison screen or closed with nothing chosen.
        function actionButtons(id, status) {

            var buttons = '';

            if (status === 'Draft') {
                buttons += `<a href="/Admin/RequestForQuotation/UpdateRequestForQuotation/${id}"
                               class="btn btn-info btn-sm mr-1" title="Edit"><i class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-success btn-sm mr-1 btn-send" data-id='${id}'
                                title="Send to suppliers"><i class="fas fa-paper-plane"></i></button>`;
            }

            if (status === 'Sent' || status === 'Awarded') {
                buttons += `<a href="/Admin/SupplierQuotation/CompareQuotations?requestForQuotationId=${id}"
                               class="btn btn-primary btn-sm mr-1" title="Compare quotations"><i class="fas fa-balance-scale"></i></a>`;
            }

            if (status === 'Sent') {
                buttons += `<button type="button" class="btn btn-secondary btn-sm mr-1 btn-close-rfq" data-id='${id}'
                                title="Close without awarding"><i class="fas fa-archive"></i></button>`;
            }

            if (status === 'Draft' || status === 'Sent') {
                buttons += `<button type="button" class="btn btn-warning btn-sm mr-1 btn-cancel" data-id='${id}'
                                title="Cancel"><i class="fas fa-ban"></i></button>`;
            }

            if (status === 'Draft' || status === 'Cancelled') {
                buttons += `<button type="button" class="btn btn-danger btn-sm show-bs-modal" data-id='${id}'
                                title="Delete"><i class="fas fa-trash"></i></button>`;
            }

            return buttons === '' ? '<span class="text-muted">—</span>' : buttons;
        }

        function postAction(url, data, successTitle) {

            data.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: url,
                type: 'POST',
                data: data,
                success: function (response) {
                    if (response.success) {
                        Swal.fire({ icon: 'success', title: successTitle, text: response.message, timer: 2200, showConfirmButton: false });
                        $('#requestForQuotation').DataTable().ajax.reload(null, false);
                    } else {
                        Swal.fire({ icon: 'error', title: 'Failed!', text: response.message });
                    }
                },
                error: function (error) {
                    if (error.status === 403) {
                        window.location.href = '/Account/AccessDenied';
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: 'The action could not be completed.' });
                    }
                }
            });
        }

        $(function () {
            try {
                $("#requestForQuotation").DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    ajax: {
                        url: "/Admin/RequestForQuotation/GetRequestForQuotationJsonData",
                        type: "POST",
                        contentType: "application/json",
                        dataType: "json",
                        data: function (d) {
                            return JSON.stringify(d);
                        },
                    },
                    columnDefs: [
                        {
                            orderable: false,
                            targets: 6,
                            render: function (data, type, row) {
                                return actionButtons(data, row[5]);
                            }
                        },
                        {
                            targets: 5,
                            render: function (data) {
                                return `<span class="badge ${statusBadgeClass(data)}">${data}</span>`;
                            }
                        },
                        ...[0, 1, 2, 3, 4].map(function (target) {
                            return {
                                targets: target,
                                createdCell: function (td, cellData, rowData) {
                                    $(td).addClass('table-row');
                                    $(td).attr('data-id', rowData[6]);
                                }
                            };
                        })
                    ],
                    dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                    "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
                }).buttons().container().appendTo('#requestForQuotation_wrapper .col-md-6:eq(0)');
            } catch (e) {
                console.error("DataTable init error:", e);
            }
        });

        // Row click -> request for quotation details modal
        $(function () {
            $('#requestForQuotation tbody').on('click', '.table-row', function () {
                var id = $(this).data("id");

                $.ajax({
                    url: `/Admin/RequestForQuotation/GetRequestForQuotationDetails?id=${id}`,
                    type: 'GET',
                    success: function (data) {

                        $('#RfqNo').text(data.rfqNo || 'N/A');
                        $('#RfqRequisitionNo').text(data.requisitionNo || 'N/A');
                        $('#RfqWarehouse').text(data.warehouse || 'N/A');
                        $('#RfqDate').text(data.rfqDate ? new Date(data.rfqDate).toLocaleDateString() : 'N/A');
                        $('#RfqDeadline').text(data.responseDeadline ? new Date(data.responseDeadline).toLocaleDateString() : 'N/A');
                        $('#RfqStatus').text(data.status || 'N/A');
                        $('#RfqNotes').text(data.notes || 'N/A');

                        $('#RfqCompareLink').attr('href',
                            `/Admin/SupplierQuotation/CompareQuotations?requestForQuotationId=${data.id}`);

                        var body = $('#RfqItemsBody').empty();

                        $.each(data.requestForQuotationItems || [], function (i, item) {
                            var row = $('<tr>');
                            row.append($('<td>').text(item.productName || ''));
                            row.append($('<td>').text(item.unitName || ''));
                            row.append($('<td class="text-right">').text(Number(item.quantity ?? 0).toFixed(2)));
                            row.append($('<td>').text(item.remarks || ''));
                            body.append(row);
                        });

                        $('#requestForQuotationDetailModal').modal('show');
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) {
                            window.location.href = '/Account/AccessDenied';
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error!', text: 'Failed to load request for quotation details.' });
                        }
                    }
                });
            });
        });

        $(function () {

            $('#requestForQuotation').on('click', '.btn-send', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Send this request to suppliers?',
                    text: 'Its lines are frozen after this, and suppliers can start quoting against it.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: 'Yes, Send',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/RequestForQuotation/SendRequestForQuotation', { id: id }, 'Sent!');
                    }
                });
            });

            $('#requestForQuotation').on('click', '.btn-close-rfq', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Close this request?',
                    text: 'Use this when none of the quotations is going to be awarded.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Close',
                    cancelButtonText: 'Keep It Open'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/RequestForQuotation/CloseRequestForQuotation', { id: id }, 'Closed!');
                    }
                });
            });

            $('#requestForQuotation').on('click', '.btn-cancel', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Cancel this request for quotation?',
                    text: 'Suppliers will no longer be able to quote against it.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Yes, Cancel It',
                    cancelButtonText: 'Keep It'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/RequestForQuotation/CancelRequestForQuotation', { id: id }, 'Cancelled!');
                    }
                });
            });

            $('#requestForQuotation').on('click', '.show-bs-modal', function () {
                let id = $(this).data("id");

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to recover this request for quotation!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/RequestForQuotation/DeleteRequestForQuotation', { id: id }, 'Deleted!');
                    }
                });
            });

        });
    </script>
}
