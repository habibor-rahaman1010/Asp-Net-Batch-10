<div class="modal fade" id="purchaseReturnDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h5 class="modal-title">Purchase Return Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Return No</dt>
                            <dd class="col-sm-7" id="PrtNo"></dd>

                            <dt class="col-sm-5">Goods Receipt</dt>
                            <dd class="col-sm-7" id="PrtGrnNo"></dd>

                            <dt class="col-sm-5">Supplier</dt>
                            <dd class="col-sm-7" id="PrtSupplier"></dd>

                            <dt class="col-sm-5">Warehouse</dt>
                            <dd class="col-sm-7" id="PrtWarehouse"></dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Return Date</dt>
                            <dd class="col-sm-7" id="PrtDate"></dd>

                            <dt class="col-sm-5">Reason</dt>
                            <dd class="col-sm-7" id="PrtReason"></dd>

                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7" id="PrtStatus"></dd>
                        </dl>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Unit</th>
                                <th class="text-right">Received</th>
                                <th class="text-right">Returned</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Line Total</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="PrtItemsBody"></tbody>
                        <tfoot>
                            <tr class="bg-light">
                                <th colspan="5" class="text-right">Supplier Credit</th>
                                <th class="text-right" id="PrtTotalAmount"></th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-2">Notes</dt>
                    <dd class="col-sm-10" id="PrtNotes"></dd>
                </dl>

            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
