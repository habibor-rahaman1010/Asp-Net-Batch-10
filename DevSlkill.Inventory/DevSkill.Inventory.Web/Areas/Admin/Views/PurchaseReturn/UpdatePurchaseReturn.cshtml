@model PurchaseReturnUpdateModel;

@{
    ViewData["Title"] = "Update Purchase Return";
}

<section class="content mt-2">
    <div class="container-fluid">
        <form asp-antiforgery="true" asp-area="Admin" asp-controller="PurchaseReturn" asp-action="UpdatePurchaseReturn" method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="GoodsReceiptId" />

            <!-- Header -->
            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">Update Purchase Return</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ReturnNo"></label>
                                <input asp-for="ReturnNo" class="form-control" readonly />
                                <small class="form-text text-muted">The return number is issued once and never changes.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="GoodsReceiptNo"></label>
                                <input asp-for="GoodsReceiptNo" class="form-control" readonly />
                                <small class="form-text text-muted">A return never moves to another goods receipt.</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ReturnDate">Return Date*</label>
                                <input asp-for="ReturnDate" type="date" class="form-control" />
                                <span asp-validation-for="ReturnDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SupplierName"></label>
                                <input asp-for="SupplierName" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="WarehouseName"></label>
                                <input asp-for="WarehouseName" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Status">Status*</label>
                                <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                <small class="form-text text-muted">
                                    Setting this to <strong>Returned</strong> takes the goods out of stock and closes the return for editing.
                                </small>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Reason">Reason*</label>
                                <input asp-for="Reason" class="form-control" />
                                <span asp-validation-for="Reason" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Notes"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <partial name="_PurchaseReturnLinesPartial" model="Model.PurchaseReturnItems" />

            <div class="card">
                <div class="card-body text-center">
                    <button type="submit" class="btn btn-primary">Update Purchase Return</button>
                    <a asp-area="Admin" asp-controller="PurchaseReturn" asp-action="PurchaseReturnList" class="btn btn-danger">Cancel</a>
                </div>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_PurchaseReturnLinesScriptPartial" />
}
