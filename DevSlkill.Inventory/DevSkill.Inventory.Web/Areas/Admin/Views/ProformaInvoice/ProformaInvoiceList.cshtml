@{
    ViewData["Title"] = "Proforma Invoice List";
}

@section Styles {
    <!-- DataTables -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>All Proforma Invoice List</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Sales</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">All proforma invoice record are here!</h3>

                        <a asp-area="Admin" asp-controller="ProformaInvoice" asp-action="CreateProformaInvoice" class="btn btn-primary float-right">
                            <i class="fas fa-plus"></i> Add Proforma Invoice
                        </a>
                    </div>

                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="proformaInvoice" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Proforma No</th>
                                    <th>Customer</th>
                                    <th>Proforma Date</th>
                                    <th>Valid Until</th>
                                    <th>Warehouse</th>
                                    <th>Grand Total</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Proforma No</th>
                                    <th>Customer</th>
                                    <th>Proforma Date</th>
                                    <th>Valid Until</th>
                                    <th>Warehouse</th>
                                    <th>Grand Total</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="_ProformaInvoiceDetailsPartial" />

@section Scripts {
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script type="text/javascript">
        $(function () {
            try {
                $("#proformaInvoice").DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    ajax: {
                        url: "/Admin/ProformaInvoice/GetProformaInvoiceJsonData",
                        type: "POST",
                        contentType: "application/json",
                        dataType: "json",
                        data: function (d) {
                            return JSON.stringify(d);
                        },
                    },
                    columnDefs: [
                        {
                            orderable: false,
                            targets: 7,
                            render: function (data, type, row) {

                                var status = row[6];

                                // Goods may leave only once the customer has accepted, and a
                                // partly shipped document stays open for the rest.
                                var deliverable = status === 'Accepted'
                                    || status === 'Converted'
                                    || status === 'PartiallyDelivered';

                                var deliverButton = deliverable
                                    ? `<a href="/Admin/Delivery/CreateDelivery?proformaInvoiceId=${data}"
                                          class="btn btn-success btn-sm mr-1">
                                           <i class="fas fa-truck"></i> Deliver
                                       </a>`
                                    : '';

                                // Everything below has already left the pre-sale stage, the
                                // server refuses those edits and deletes as well.
                                var locked = status === 'Converted'
                                    || status === 'Cancelled'
                                    || status === 'PartiallyDelivered'
                                    || status === 'Delivered';

                                if (locked) {
                                    return `${deliverButton}<span class="badge badge-secondary">Locked</span>`;
                                }

                                return `${deliverButton}
                                        <a href="/Admin/ProformaInvoice/UpdateProformaInvoice/${data}"
                                           class="btn btn-info btn-sm mr-1">
                                            <i class="fas fa-edit"></i> Edit
                                         </a>
                                        <button type="button" class="btn btn-danger btn-sm show-bs-modal" data-id='${data}'>
                                            <i class="fas fa-trash"></i> Delete
                                        </button>`;
                            }
                        },
                        {
                            targets: 6,
                            render: function (data) {
                                var cls = 'badge-secondary';

                                if (data === 'Accepted' || data === 'Converted' || data === 'Delivered') cls = 'badge-success';
                                else if (data === 'Sent') cls = 'badge-info';
                                else if (data === 'Rejected' || data === 'Cancelled') cls = 'badge-danger';
                                else if (data === 'Expired' || data === 'PartiallyDelivered') cls = 'badge-warning';

                                return `<span class="badge ${cls}">${data}</span>`;
                            }
                        },
                        {
                            targets: 5,
                            className: 'text-right'
                        },
                        ...[0, 1, 2, 3, 4, 5, 6].map(function (target) {
                            return {
                                targets: target,
                                createdCell: function (td, cellData, rowData) {
                                    $(td).addClass('table-row');
                                    $(td).attr('data-id', rowData[7]);
                                }
                            };
                        })
                    ],
                    dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                    "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
                }).buttons().container().appendTo('#proformaInvoice_wrapper .col-md-6:eq(0)');
            } catch (e) {
                console.error("DataTable init error:", e);
            }
        });

        // Row click -> details modal
        $(function () {
            $('#proformaInvoice tbody').on('click', '.table-row', function () {
                var id = $(this).data("id");

                $.ajax({
                    url: `/Admin/ProformaInvoice/GetProformaInvoiceDetails?id=${id}`,
                    type: 'GET',
                    success: function (data) {
                        $('#PiProformaNo').text(data.proformaNo || 'N/A');
                        $('#PiCustomer').text(
                            data.customerName ? `${data.customerName} (${data.customerCode})` : 'N/A');
                        $('#PiWarehouse').text(data.warehouse || 'N/A');
                        $('#PiSalesperson').text(data.salespersonName || 'N/A');
                        $('#PiProformaDate').text(
                            data.proformaDate ? new Date(data.proformaDate).toLocaleDateString() : 'N/A');
                        $('#PiValidUntil').text(
                            data.validUntil ? new Date(data.validUntil).toLocaleDateString() : 'N/A');
                        $('#PiStatus').text(data.status || 'N/A');
                        $('#PiPaymentTerms').text(data.paymentTerms || 'N/A');
                        $('#PiNotes').text(data.notes || 'N/A');

                        $('#PiSubTotal').text(Number(data.subTotal ?? 0).toFixed(2));
                        $('#PiItemDiscount').text(Number(data.itemDiscountTotal ?? 0).toFixed(2));
                        $('#PiOrderDiscount').text(Number(data.orderDiscount ?? 0).toFixed(2));
                        $('#PiTotalTax').text(Number(data.totalTax ?? 0).toFixed(2));
                        $('#PiGrandTotal').text(Number(data.grandTotal ?? 0).toFixed(2));

                        let rows = '';

                        if (data.proformaInvoiceItems && data.proformaInvoiceItems.length > 0) {
                            data.proformaInvoiceItems.forEach(function (item, index) {
                                rows += `
                                    <tr>
                                        <td class="text-center">${index + 1}</td>
                                        <td>${item.productName ?? 'N/A'}</td>
                                        <td class="text-center">
                                            ${Number(item.quantity ?? 0).toFixed(2)} ${item.unitName ?? ''}
                                        </td>
                                        <td class="text-right">${Number(item.unitPrice ?? 0).toFixed(2)}</td>
                                        <td class="text-right">${Number(item.discountAmount ?? 0).toFixed(2)}</td>
                                        <td class="text-center">${Number(item.taxRate ?? 0).toFixed(2)}</td>
                                        <td class="text-right">${Number(item.taxAmount ?? 0).toFixed(2)}</td>
                                        <td class="text-right">${Number(item.lineTotal ?? 0).toFixed(2)}</td>
                                    </tr>`;
                            });
                        } else {
                            rows = `<tr><td colspan="8" class="text-center">No Product Found</td></tr>`;
                        }

                        $("#proformaInvoiceItemsTable").html(rows);
                        $('#proformaInvoiceDetailModal').modal('show');
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) {
                            window.location.href = '/Account/AccessDenied';
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error!', text: 'Failed to load proforma invoice details.' });
                        }
                    }
                });
            });
        });

        // Delete handler
        $(function () {
            $('#proformaInvoice').on('click', '.show-bs-modal', function (e) {

                // The row click opens the details modal, so stop it here.
                e.stopPropagation();

                let id = $(this).data("id");

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to recover this Proforma Invoice!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Admin/ProformaInvoice/DeleteProformaInvoice',
                            type: 'POST',
                            data: {
                                id: id,
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire({ icon: 'success', title: 'Deleted!', text: response.message, timer: 2000, showConfirmButton: false });
                                    $('#proformaInvoice').DataTable().ajax.reload(null, false);
                                } else {
                                    Swal.fire({ icon: 'error', title: 'Failed!', text: response.message });
                                }
                            },
                            error: function (error) {
                                if (error.status === 403) {
                                    window.location.href = '/Account/AccessDenied';
                                } else {
                                    Swal.fire({ icon: 'error', title: 'Error!', text: 'There was an error deleting the Proforma Invoice!' });
                                }
                            }
                        });
                    }
                });
            });
        });
    </script>
}
