<div class="modal fade" id="proformaInvoiceDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h5 class="modal-title">Proforma Invoice Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Proforma No</dt>
                            <dd class="col-sm-7" id="PiProformaNo"></dd>

                            <dt class="col-sm-5">Customer</dt>
                            <dd class="col-sm-7" id="PiCustomer"></dd>

                            <dt class="col-sm-5">Warehouse</dt>
                            <dd class="col-sm-7" id="PiWarehouse"></dd>

                            <dt class="col-sm-5">Salesperson</dt>
                            <dd class="col-sm-7" id="PiSalesperson"></dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Proforma Date</dt>
                            <dd class="col-sm-7" id="PiProformaDate"></dd>

                            <dt class="col-sm-5">Valid Until</dt>
                            <dd class="col-sm-7" id="PiValidUntil"></dd>

                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7" id="PiStatus"></dd>

                            <dt class="col-sm-5">Payment Terms</dt>
                            <dd class="col-sm-7" id="PiPaymentTerms"></dd>
                        </dl>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th class="text-center" width="5%">#</th>
                                <th>Product</th>
                                <th class="text-center">Qty</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Discount</th>
                                <th class="text-center">Tax %</th>
                                <th class="text-right">Tax</th>
                                <th class="text-right">Line Total</th>
                            </tr>
                        </thead>
                        <tbody id="proformaInvoiceItemsTable"></tbody>
                    </table>
                </div>

                <div class="row justify-content-end">
                    <div class="col-md-5">
                        <table class="table table-sm">
                            <tr>
                                <th>Sub Total</th>
                                <td class="text-right" id="PiSubTotal"></td>
                            </tr>
                            <tr>
                                <th>Item Discount</th>
                                <td class="text-right" id="PiItemDiscount"></td>
                            </tr>
                            <tr>
                                <th>Order Discount</th>
                                <td class="text-right" id="PiOrderDiscount"></td>
                            </tr>
                            <tr>
                                <th>Tax / VAT</th>
                                <td class="text-right" id="PiTotalTax"></td>
                            </tr>
                            <tr class="bg-light">
                                <th>Grand Total</th>
                                <th class="text-right" id="PiGrandTotal"></th>
                            </tr>
                        </table>
                    </div>
                </div>

                <dl class="row">
                    <dt class="col-sm-2">Notes</dt>
                    <dd class="col-sm-10" id="PiNotes"></dd>
                </dl>

            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
