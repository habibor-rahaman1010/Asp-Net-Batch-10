@model StockTransferCreateModel;

@{
    ViewData["Title"] = "Create Stock Transfer";
}

@{
    var productOptions = string.Join("",
        Model.StockTransferItems[0].Products.Select(x =>
            $"<option value='{x.Value}'>{x.Text}</option>"));

    var unitOptions = string.Join("",
        Model.StockTransferItems[0].Units.Select(x =>
            $"<option value='{x.Value}'>{x.Text}</option>"));
}

<section class="content mt-2">
    <div class="container-fluid">
        <form asp-antiforgery="true" asp-area="Admin" asp-controller="StockTransfer" asp-action="CreateStockTransfer" method="post" enctype="multipart/form-data">

            <!-- Header -->
            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">
                        Stock Transfer
                    </h3>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="TransferNo"></label>
                                <input asp-for="TransferNo" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="TransferDate">Transfer Date*</label>
                                <input type="datetime-local" asp-for="TransferDate" class="form-control" value="" />
                                <span asp-validation-for="TransferDate" class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="FromWarehouseId">From Warehouse*</label>
                                <select asp-for="FromWarehouseId" asp-items="Model.FromWarehouses" class="form-control"></select>
                                <span asp-validation-for="FromWarehouseId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ToWarehouseId">To Warehouse*</label>
                                <select asp-for="ToWarehouseId" asp-items="Model.ToWarehouses" class="form-control"></select>
                                <span asp-validation-for="ToWarehouseId" class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-sm-4 mb-3 px-3">
                            <div class="form-group">
                                <label asp-for="StockTransferStatus">Product Status*</label>
                                <select asp-for="StockTransferStatus" asp-items="Model.StockTransferStatuses" class="form-control"></select>
                                <span asp-validation-for="StockTransferStatus" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">

                                <label asp-for="Remarks"></label>

                                <textarea asp-for="Remarks"
                                          class="form-control"
                                          rows="3"></textarea>

                                <span asp-validation-for="Remarks"
                                      class="text-danger"></span>

                            </div>
                        </div>
                    </div>

                </div>

            </div>


            <!-- Products -->
            <div class="card">

                <div class="card-header">

                    <div class="d-flex justify-content-between">

                        <h3 class="card-title">
                            Products
                        </h3>

                        <button id="btnAddProduct" type="button" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i>
                            Add Product
                        </button>

                    </div>

                </div>

                <div class="card-body">

                    <table class="table table-bordered table-striped">

                        <thead>

                            <tr>

                                <th width="35%">
                                    Product
                                </th>

                                <th width="20%">
                                    Available Qty
                                </th>

                                <th width="20%">
                                    Transfer Qty
                                </th>

                                <th width="15%">
                                    Unit
                                </th>

                                <th width="10%">
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody id="productTableBody">

                            <tr>
                                <td>
                                    <div class="form-group">
                                        <select asp-for="StockTransferItems[0].ProductId" asp-items="Model.StockTransferItems[0].Products" class="form-control product-select"></select>
                                        <span asp-validation-for="StockTransferItems[0].ProductId" class="text-danger"></span>
                                    </div>
                                </td>

                                <td>
                                    <input class="form-control available-qty"
                                           value="0"
                                           readonly />
                                </td>

                                <td>
                                    <input asp-for="StockTransferItems[0].Quantity"
                                           class="form-control transfer-qty" />
                                </td>

                                <td>
                                    <div class="form-group">
                                        <select asp-for="StockTransferItems[0].UnitId" asp-items="Model.StockTransferItems[0].Units" class="form-control unit-select"></select>
                                        <span asp-validation-for="StockTransferItems[0].UnitId" class="text-danger"></span>
                                    </div>
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn btn-danger btn-sm btnRemoveRow">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- Footer Buttons -->
            <div class="card">
                <div class="card-body text-center">

                    <button type="submit" class="btn btn-primary">
                        Complete Transfer
                    </button>

                    <button type="button" class="btn btn-danger">
                        Cancel
                    </button>

                </div>

            </div>

        </form>
    </div>
</section>


@section Scripts {
    <script>

        var rowIndex = 1;

        function updateDeleteButtons() {
            if ($("#productTableBody tr").length == 1) {
                $(".btnRemoveRow").prop("disabled", true);
            } else {
                $(".btnRemoveRow").prop("disabled", false);
            }
        }

        $(document).ready(function () {

            updateDeleteButtons();

            $("#btnAddProduct").click(function () {

                var row = `
                <tr>

                    <td>
                        <select name="StockTransferItems[${rowIndex}].ProductId"
                                class="form-control product-select">
                            @Html.Raw(productOptions)
                        </select>
                    </td>

                    <td>
                        <input class="form-control available-qty"
                               value="0"
                               readonly />
                    </td>

                    <td>
                        <input name="StockTransferItems[${rowIndex}].Quantity"
                               class="form-control transfer-qty" />
                    </td>

                    <td>
                        <select name="StockTransferItems[${rowIndex}].UnitId"
                                class="form-control unit-select">
                            @Html.Raw(unitOptions)
                        </select>
                    </td>

                    <td>
                        <button type="button"
                                class="btn btn-danger btn-sm btnRemoveRow">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>

                </tr>`;

                $("#productTableBody").append(row);

                rowIndex++;

                updateDeleteButtons();
            });

            $(document).on("click", ".btnRemoveRow", function () {

                if ($("#productTableBody tr").length > 1) {
                    $(this).closest("tr").remove();
                    updateDeleteButtons();
                }

            });

        });

        $(document).on('change', '.product-select', function () {

            var productId = $(this).val();
            var row = $(this).closest('tr');

            $.get('/Admin/Product/GetProductInfo',
                { productId: productId },
                function (response) {

                    row.find('.available-qty')
                        .val(response.availableQuantity);

                    row.find('.unit-select')
                        .val(response.unitId);
                });
        });

        $(document).on('input', '.transfer-qty', function () {

            var row = $(this).closest('tr');

            var availableQty = parseFloat(row.find('.available-qty').val()) || 0;
            var transferQty = parseFloat($(this).val()) || 0;

            if (transferQty < 0) {
                alert('Transfer Qty cannot be negative.');
                $(this).val('');
                return;
            }

            if (transferQty > availableQty) {
                alert('Transfer Qty should be equal to or less than Available Qty.');
                $(this).val(availableQty);
            }

        });

    </script>
}