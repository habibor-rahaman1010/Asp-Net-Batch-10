@{
    ViewData["Title"] = "Stock Transfer List";
}

<style>
    .toast {
        background-color: #28a745;
        color: white;
    }

    .toast-body {
        width: 100%;
        text-align: center;
    }

</style>

@section Styles {
    <!-- DataTables -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="categoryToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-body d-flex" id="toastMessage">
            <!-- Toast message will be dynamically set here -->
        </div>
    </div>
</div>

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>All Stock Transfer List</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Stock</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">All stock transfer record are here!</h3>

                        <a asp-area="Admin" asp-controller="StockTransfer" asp-action="CreateStockTransfer" class="btn btn-primary float-right">
                            <i class="fas fa-plus"></i> Add Stock Transfer
                        </a>

                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="stockTransfer" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Transfer Id</th>
                                    <th>Item Name</th>
                                    <th>From Warehouse</th>
                                    <th>To Warehouse</th>
                                    <th>Quantity</th>
                                    <th>TransferDate</th>
                                    <th>Status</th>
                                    <th>Remarks</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Transfer Id</th>
                                    <th>Item Name</th>
                                    <th>From Warehouse</th>
                                    <th>To Warehouse</th>
                                    <th>Quantity</th>
                                    <th>TransferDate</th>
                                    <th>Status</th>
                                    <th>Remarks</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>

<partial name="_StockTransferDetailsPartial" />

<!-- /.content -->
@section Scripts {
    <!-- DataTables  & Plugins -->
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>


    <script type="text/javascript">
        $(function () {
            try {
                $("#stockTransfer").DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    ajax: {
                        url: "/Admin/StockTransfer/GetStockTransferJsonData",
                        type: "POST",
                        contentType: "application/json",
                        dataType: "json",
                        data: function (d) {
                            return JSON.stringify(d);
                        },
                    },
                    columnDefs: [
                        {
                            orderable: false,
                            targets: 8,
                            render: function (data, type, row) {
                                return `<a href="/Admin/StockTransfer/UpdateStockTransfer/${data}"
                                           class="btn btn-info btn-sm mr-1">
                                            <i class="fas fa-edit"></i> Edit
                                         </a>
                                        <button type="submit" class="btn btn-danger btn-sm show-bs-modal" data-id='${data}' value='${data}'>
                                            <i class="fas fa-trash"></i> Delete
                                        </button>`;
                            }
                        },
                        ...[0, 1, 2, 3, 4, 5, 6, 7].map(function (target) {
                            return {
                                targets: target,
                                createdCell: function (td, cellData, rowData) {
                                    $(td).addClass('table-row');
                                    $(td).attr('data-id', rowData[8]);
                                }
                            };
                        })
                    ],
                    dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                    "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
                }).buttons().container().appendTo('#stockTransfer_wrapper .col-md-6:eq(0)');
            } catch (e) {
                console.error("DataTable init error:", e);
            }
        });

               // 2) Row click -> Details modal (আলাদা, স্বাধীন ব্লক)
        $(function () {
            $('#stockTransfer tbody').on('click', '.table-row', function () {
                var id = $(this).data("id");

                $.ajax({
                    url: `/Admin/StockTransfer/GetStockTransferDetails?id=${id}`,
                    type: 'GET',
                    success: function (data) {
                        console.log(data)
                        $('#TransferNo').text(data.transferNo || 'N/A');
                        $('#TransferDate').text(
                            data.transferDate
                                ? new Date(data.transferDate).toLocaleString('en-US', { hour12: true })
                                : 'N/A'
                        );
                        $('#Status').text(data.status || 'N/A');
                        $('#Remarks').text(data.remarks || 'N/A');
                        $('#FromWarehouse').text(data.fromWarehouse?.locationName || 'N/A');
                        $('#ToWarehouse').text(data.toWarehouse?.locationName || 'N/A');

                        let rows = '';

                        if (data.stockTransferItems && data.stockTransferItems.length > 0) {
                            data.stockTransferItems.forEach(function (item, index) {
                                rows += `
                                    <tr>
                                        <td class="text-center">${index + 1}</td>
                                        <td><span class="product-name">${item.productName ?? 'N/A'}</span></td>
                                        <td class="text-center">
                                            <span class="badge bg-primary quantity-badge">${item.quantity}</span>
                                        </td>
                                        <td class="text-end price-text">${Number(item.unitPrice ?? 0).toFixed(2)}</td>
                                        <td class="text-end price-text">${Number(item.subtotal ?? 0).toFixed(2)}</td>
                                    </tr>`;
                            });
                        } 
                        else {
                            rows = `<tr><td colspan="5" class="text-center">No Product Found</td></tr>`;
                        }

                        $("#stockTransferItemsTable").html(rows);
                        $("#modalTotalAmount").text(Number(data.totalAmount  ?? 0).toFixed(2))

                        $('#stockTransferDetailModal').modal('show');
                    },
                    error: function (xhr) {
                        console.log(xhr);
                        if (xhr.status === 403) {
                            window.location.href = '/Account/AccessDenied';
                        } else {
                            alert("Failed to load stock transfer details.");
                        }
                    }
                });
            });
        });


        // 3) Delete handler (আলাদা ব্লক)
        $(function () {
            $('#stockTransfer').on('click', '.show-bs-modal', function () {
                let id = $(this).data("id");
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to recover this Stock Transfer!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Admin/StockTransfer/DeleteStockTransfer',
                            type: 'POST',
                            data: {
                                id: id,
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire({ icon: 'success', title: 'Deleted!', text: response.message, timer: 2000, showConfirmButton: false });
                                    $('#stockTransfer').DataTable().ajax.reload(null, false);
                                } else {
                                    Swal.fire({ icon: 'error', title: 'Failed!', text: response.message });
                                }
                            },
                            error: function (error) {
                                if (error.status === 403) {
                                    window.location.href = '/Account/AccessDenied';
                                } else {
                                    Swal.fire({ icon: 'error', title: 'Error!', text: 'There was an error deleting the Stock Transfer!.' });
                                }
                            }
                        });
                    }
                });
            });
        });
    </script>
}