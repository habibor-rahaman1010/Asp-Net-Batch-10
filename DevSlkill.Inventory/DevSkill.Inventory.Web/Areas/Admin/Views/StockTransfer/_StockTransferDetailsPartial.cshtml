<style>
    #stockTransferDetailsTable {
        font-size: 14px;
    }

        #stockTransferDetailsTable thead th {
            vertical-align: middle;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        #stockTransferDetailsTable td {
            padding: 12px;
        }

    .product-name {
        font-weight: 600;
    }

    .quantity-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
    }

    .price-text {
        font-weight: 600;
    }
</style>

<!-- Stock Transfer Details Modal -->
<div id="stockTransferDetailModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-custom modal-xl" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Stock Transfer Details (Transfer No: <span id="TransferNo"></span>)</h5>
                <button type="button" class="close" data-dismiss="modal">
                    &times;
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4">
                        <p><strong>Transfer Date:</strong> <span id="TransferDate"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Status:</strong> <span id="Status"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Remarks:</strong> <span id="Remarks"></span></p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <p><strong>From Warehouse:</strong> <span id="FromWarehouse"></span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>To Warehouse:</strong> <span id="ToWarehouse"></span></p>
                    </div>
                </div>

                <!-- Product Details Table -->
                <div class="col-sm-12 mt-3">
                    <div class="table-responsive">

                        <table class="table table-bordered table-hover align-middle"
                               id="stockTransferDetailsTable">

                            <thead class="table-dark">
                                <tr>
                                    <th style="width:5%">#</th>
                                    <th style="width:35%">Product</th>
                                    <th style="width:20%" class="text-center">Quantity</th>
                                    <th style="width:20%" class="text-end">Unit Price</th>
                                    <th style="width:20%" class="text-end">Subtotal</th>
                                </tr>
                            </thead>

                            <tbody id="stockTransferItemsTable">
                            </tbody>

                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="4" class="text-end">
                                        Total Amount
                                    </td>
                                    <td class="text-end" id="modalTotalAmount">
                                    </td>
                                </tr>
                            </tfoot>

                        </table>

                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary no-print" aria-label="Print" onclick="$('#stockTransferDetailModal').printThis();">
                    <i class="fa fa-print"></i> Print
                </button>
                <button type="button" class="btn btn-secondary no-print" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>