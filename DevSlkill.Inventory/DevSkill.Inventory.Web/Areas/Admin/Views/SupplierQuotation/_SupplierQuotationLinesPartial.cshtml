@model List<SupplierQuotationItemModel>

@*
    The quoted grid, shared by the create and update screens. Product, unit and the
    quantity asked for come from the request and are read only; the supplier's
    price, discount and — where they can only part-supply — quantity are typed.
*@

<div class="card">

    <div class="card-header">
        <h3 class="card-title">Quoted Products</h3>
    </div>

    <div class="card-body">

        <div class="alert alert-info">
            <i class="fas fa-file-invoice-dollar"></i>
            This is what the supplier is offering, not an order. Nothing here moves stock
            or money; the award only decides which quotation a purchase order is raised
            from. A line quoted for less than was asked for is highlighted.
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th width="24%">Product</th>
                        <th width="8%">Unit</th>
                        <th width="10%">Asked For</th>
                        <th width="11%">Quoted Qty</th>
                        <th width="12%">Unit Price</th>
                        <th width="11%">Discount</th>
                        <th width="12%">Line Total</th>
                        <th width="12%">Remarks</th>
                    </tr>
                </thead>

                <tbody id="quotationTableBody">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model[i].ProductName
                                <input type="hidden" name="SupplierQuotationItems[@i].ProductId" value="@Model[i].ProductId" />
                                <input type="hidden" name="SupplierQuotationItems[@i].ProductName" value="@Model[i].ProductName" />
                                <input type="hidden" name="SupplierQuotationItems[@i].UnitName" value="@Model[i].UnitName" />
                                <input type="hidden" name="SupplierQuotationItems[@i].RequestedQuantity"
                                       value="@Model[i].RequestedQuantity" class="requested-qty" />
                            </td>

                            <td>@Model[i].UnitName</td>

                            <td class="text-right">@Model[i].RequestedQuantity.ToString("N2")</td>

                            <td>
                                <input name="SupplierQuotationItems[@i].Quantity" value="@Model[i].Quantity"
                                       type="number" step="0.01" min="0" class="form-control line-qty" />
                            </td>

                            <td>
                                <input name="SupplierQuotationItems[@i].UnitPrice" value="@Model[i].UnitPrice"
                                       type="number" step="0.01" min="0" class="form-control unit-price" />
                            </td>

                            <td>
                                <input name="SupplierQuotationItems[@i].DiscountAmount" value="@Model[i].DiscountAmount"
                                       type="number" step="0.01" min="0" class="form-control line-discount" />
                            </td>

                            <td><input class="form-control line-total" value="0.00" readonly /></td>

                            <td>
                                <input name="SupplierQuotationItems[@i].Remarks" value="@Model[i].Remarks" class="form-control" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                <i class="fas fa-info-circle"></i>
                Choose a request for quotation above and the products it asked to be
                quoted for will appear here.
            </div>
        }

        <div class="row justify-content-end">
            <div class="col-md-4">
                <table class="table table-sm">
                    <tr>
                        <th>Sub Total</th>
                        <th class="text-right" id="sumSubTotal">0.00</th>
                    </tr>
                    <tr>
                        <th>Discount</th>
                        <th class="text-right" id="sumDiscountTotal">0.00</th>
                    </tr>
                    <tr>
                        <th>Other Charges</th>
                        <th class="text-right" id="sumOtherCharges">0.00</th>
                    </tr>
                    <tr class="bg-light">
                        <th>Grand Total</th>
                        <th class="text-right" id="sumGrandTotal">0.00</th>
                    </tr>
                </table>
            </div>
        </div>

    </div>

</div>
