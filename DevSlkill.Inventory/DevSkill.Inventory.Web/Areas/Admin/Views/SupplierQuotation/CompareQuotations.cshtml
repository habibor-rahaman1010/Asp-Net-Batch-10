@model QuotationComparisonModel;

@{
    ViewData["Title"] = "Compare Quotations";

    var comparison = Model.Comparison;
    var isAwarded = comparison != null && comparison.SelectedSupplierQuotationId.HasValue;
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Compare Quotations</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Purchase</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @Html.AntiForgeryToken()

        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Pick a request and read the offers across</h3>
            </div>

            <div class="card-body">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-area="Admin" asp-controller="SupplierQuotation" asp-action="CompareQuotations" method="get">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="RequestForQuotationId"></label>
                                <select asp-for="RequestForQuotationId" asp-items="Model.RequestForQuotations" class="form-control"></select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label>&nbsp;</label><br />
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-balance-scale"></i> Compare
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

            </div>
        </div>

        @if (comparison == null)
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                Choose a request for quotation above. Only requests that have been sent out
                have offers to weigh against each other.
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        @comparison.RfqNo &mdash; @comparison.WarehouseName
                        <span class="badge badge-secondary ml-2">@comparison.Status</span>
                    </h3>

                    @if (isAwarded)
                    {
                        <button type="button" id="btnUndoAward" class="btn btn-warning btn-sm float-right"
                                data-id="@comparison.RequestForQuotationId">
                            <i class="fas fa-undo"></i> Undo Award
                        </button>
                    }
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-2">RFQ Date</dt>
                        <dd class="col-sm-4">@comparison.RfqDate.ToString("dd-MM-yyyy")</dd>

                        <dt class="col-sm-2">Response Deadline</dt>
                        <dd class="col-sm-4">@comparison.ResponseDeadline.ToString("dd-MM-yyyy")</dd>
                    </dl>
                </div>
            </div>

            @if (comparison.Offers.Count == 0)
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    No supplier has quoted against this request yet.
                    <a asp-area="Admin" asp-controller="SupplierQuotation" asp-action="CreateSupplierQuotation"
                       asp-route-requestForQuotationId="@comparison.RequestForQuotationId">Record a quotation</a>.
                </div>
            }
            else
            {
                <!-- Offer summary -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">The offers</h3>
                    </div>

                    <div class="card-body">

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Cheapest and fastest are only ranked among the offers that cover
                            everything the request asked for &mdash; a part quote is not really
                            cheaper, it is smaller. Awarding a winner rejects every other live
                            offer on this request; it does not create a purchase order, and it
                            moves neither stock nor money.
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Quotation No</th>
                                        <th>Supplier</th>
                                        <th>Supplier's Ref</th>
                                        <th class="text-right">Sub Total</th>
                                        <th class="text-right">Discount</th>
                                        <th class="text-right">Other</th>
                                        <th class="text-right">Grand Total</th>
                                        <th class="text-right">Delivery Days</th>
                                        <th>Valid Until</th>
                                        <th>Payment Terms</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var offer in comparison.Offers)
                                    {
                                        var isWinner = comparison.SelectedSupplierQuotationId == offer.SupplierQuotationId;

                                        <tr class="@(isWinner ? "table-success" : offer.Status == "Cancelled" || offer.Status == "Rejected" ? "text-muted" : "")">
                                            <td>@offer.QuotationNo</td>

                                            <td>
                                                @offer.SupplierName
                                                @if (!offer.IsComplete)
                                                {
                                                    <span class="badge badge-warning ml-1" title="This supplier did not quote every requested product, or quoted a smaller quantity.">Part quote</span>
                                                }
                                            </td>

                                            <td>@offer.SupplierQuotationNo</td>
                                            <td class="text-right">@offer.SubTotal.ToString("N2")</td>
                                            <td class="text-right">@offer.DiscountTotal.ToString("N2")</td>
                                            <td class="text-right">@offer.OtherCharges.ToString("N2")</td>

                                            <td class="text-right font-weight-bold">
                                                @offer.GrandTotal.ToString("N2")
                                                @if (offer.IsLowestPrice)
                                                {
                                                    <span class="badge badge-success ml-1">Lowest</span>
                                                }
                                            </td>

                                            <td class="text-right">
                                                @offer.DeliveryDays
                                                @if (offer.IsFastestDelivery)
                                                {
                                                    <span class="badge badge-primary ml-1">Fastest</span>
                                                }
                                            </td>

                                            <td>
                                                @offer.ValidUntil.ToString("dd-MM-yyyy")
                                                @if (offer.IsExpired)
                                                {
                                                    <span class="badge badge-danger ml-1" title="The price is no longer held.">Expired</span>
                                                }
                                            </td>

                                            <td>@offer.PaymentTermName</td>

                                            <td>
                                                <span class="badge @(offer.Status == "Selected" ? "badge-success"
                                                                    : offer.Status == "Rejected" ? "badge-warning"
                                                                    : offer.Status == "Cancelled" ? "badge-danger" : "badge-info")">
                                                    @offer.Status
                                                </span>
                                            </td>

                                            <td>
                                                @if (isWinner)
                                                {
                                                    <a asp-area="Admin" asp-controller="PurchaseOrder" asp-action="CreatePurchaseOrder"
                                                       asp-route-supplierQuotationId="@offer.SupplierQuotationId"
                                                       class="btn btn-primary btn-sm" title="Raise the purchase order on this quotation">
                                                        <i class="fas fa-file-signature"></i> Raise PO
                                                    </a>
                                                }
                                                else if (!isAwarded && offer.Status == "Received")
                                                {
                                                    <button type="button" class="btn btn-success btn-sm btn-select"
                                                            data-id="@offer.SupplierQuotationId"
                                                            data-supplier="@offer.SupplierName">
                                                        <i class="fas fa-trophy"></i> Award
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">&mdash;</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>

                <!-- Line by line -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Unit price, product by product</h3>
                    </div>

                    <div class="card-body">

                        <div class="table-responsive">
                            <table class="table table-bordered table-sm">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Unit</th>
                                        <th class="text-right">Asked For</th>
                                        @foreach (var offer in comparison.Offers)
                                        {
                                            <th class="text-center">@offer.SupplierName</th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var requested in comparison.RequestedLines)
                                    {
                                        <tr>
                                            <td>@requested.ProductName</td>
                                            <td>@requested.UnitName</td>
                                            <td class="text-right">@requested.Quantity.ToString("N2")</td>

                                            @foreach (var offer in comparison.Offers)
                                            {
                                                var line = offer.Lines.FirstOrDefault(x => x.ProductId == requested.ProductId);

                                                @if (line == null)
                                                {
                                                    <td class="text-center text-muted">not quoted</td>
                                                }
                                                else
                                                {
                                                    <td class="text-center @(line.IsLowestUnitPrice ? "table-success font-weight-bold" : "")">
                                                        @line.UnitPrice.ToString("N2")
                                                        @if (line.Quantity < requested.Quantity)
                                                        {
                                                            <br />
                                                            <small class="text-warning">only @line.Quantity.ToString("N2")</small>
                                                        }
                                                    </td>
                                                }
                                            }
                                        </tr>
                                    }
                                </tbody>

                                <tfoot>
                                    <tr class="bg-light">
                                        <th colspan="3" class="text-right">Grand Total</th>
                                        @foreach (var offer in comparison.Offers)
                                        {
                                            <th class="text-center">@offer.GrandTotal.ToString("N2")</th>
                                        }
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                    </div>
                </div>
            }
        }

    </div>
</section>

@section Scripts {
    <script type="text/javascript">

        function postAction(url, data, successTitle) {

            data.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: url,
                type: 'POST',
                data: data,
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: successTitle,
                            text: response.message,
                            timer: 2200,
                            showConfirmButton: false
                        }).then(function () {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Failed!', text: response.message });
                    }
                },
                error: function (error) {
                    if (error.status === 403) {
                        window.location.href = '/Account/AccessDenied';
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: 'The action could not be completed.' });
                    }
                }
            });
        }

        $(function () {

            $('.btn-select').on('click', function () {

                let id = $(this).data("id");
                let supplier = $(this).data("supplier");

                Swal.fire({
                    title: 'Award to ' + supplier + '?',
                    text: 'Every other live offer on this request is rejected. No order is created yet.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: 'Yes, Award',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/SupplierQuotation/SelectWinningQuotation', { id: id }, 'Awarded!');
                    }
                });
            });

            $('#btnUndoAward').on('click', function () {

                let requestForQuotationId = $(this).data("id");

                Swal.fire({
                    title: 'Undo this award?',
                    text: 'The request goes back to being open, and the rejected offers become live again. This is blocked once a purchase order has been raised on the winning quotation.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Yes, Undo',
                    cancelButtonText: 'Keep It'
                }).then((result) => {
                    if (result.isConfirmed) {
                        postAction('/Admin/SupplierQuotation/UndoAward',
                            { requestForQuotationId: requestForQuotationId }, 'Award Undone!');
                    }
                });
            });

        });
    </script>
}
