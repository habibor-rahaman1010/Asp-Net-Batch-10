@*
    Line grid behaviour shared by the create and update quotation screens.

    The products and the quantities asked for belong to the request, so they are
    never typed here. Only the price, the discount and — where a supplier can only
    part-supply — the quoted quantity are entered.
*@

<script>

    function recalculateLine(row) {

        var qty = parseFloat(row.find(".line-qty").val()) || 0;
        var price = parseFloat(row.find(".unit-price").val()) || 0;
        var discount = parseFloat(row.find(".line-discount").val()) || 0;

        var gross = qty * price;

        // A discount larger than the line itself would turn the line negative, so it
        // is capped at the gross amount.
        if (discount > gross) {
            discount = gross;
            row.find(".line-discount").val(discount.toFixed(2));
        }

        row.find(".line-total").val((gross - discount).toFixed(2));
    }

    function recalculateTotals() {

        var subTotal = 0;
        var discountTotal = 0;

        $("#quotationTableBody tr").each(function () {

            var row = $(this);

            recalculateLine(row);

            var qty = parseFloat(row.find(".line-qty").val()) || 0;
            var price = parseFloat(row.find(".unit-price").val()) || 0;

            subTotal += qty * price;
            discountTotal += parseFloat(row.find(".line-discount").val()) || 0;
        });

        var otherCharges = parseFloat($("#OtherCharges").val()) || 0;

        $("#sumSubTotal").text(subTotal.toFixed(2));
        $("#sumDiscountTotal").text(discountTotal.toFixed(2));
        $("#sumOtherCharges").text(otherCharges.toFixed(2));
        $("#sumGrandTotal").text((subTotal - discountTotal + otherCharges).toFixed(2));

        flagShortLines();
    }

    // A supplier is allowed to quote less than was asked for, but the buyer should
    // see it rather than discover it after the award.
    function flagShortLines() {

        $("#quotationTableBody tr").each(function () {

            var row = $(this);

            var asked = parseFloat(row.find(".requested-qty").val()) || 0;
            var quoted = parseFloat(row.find(".line-qty").val()) || 0;

            row.toggleClass("table-warning", quoted < asked);
        });
    }

    function appendQuotationRow(index, line) {

        var row = `
        <tr>
            <td>
                ${line.productName}
                <input type="hidden" name="SupplierQuotationItems[${index}].ProductId" value="${line.productId}" />
                <input type="hidden" name="SupplierQuotationItems[${index}].ProductName" value="${line.productName}" />
                <input type="hidden" name="SupplierQuotationItems[${index}].UnitName" value="${line.unitName || ''}" />
                <input type="hidden" name="SupplierQuotationItems[${index}].RequestedQuantity"
                       value="${line.requestedQuantity}" class="requested-qty" />
            </td>

            <td>${line.unitName || ''}</td>

            <td class="text-right">${Number(line.requestedQuantity).toFixed(2)}</td>

            <td>
                <input name="SupplierQuotationItems[${index}].Quantity" value="${line.requestedQuantity}"
                       type="number" step="0.01" min="0" class="form-control line-qty" />
            </td>

            <td>
                <input name="SupplierQuotationItems[${index}].UnitPrice" value="0"
                       type="number" step="0.01" min="0" class="form-control unit-price" />
            </td>

            <td>
                <input name="SupplierQuotationItems[${index}].DiscountAmount" value="0"
                       type="number" step="0.01" min="0" class="form-control line-discount" />
            </td>

            <td><input class="form-control line-total" value="0.00" readonly /></td>

            <td>
                <input name="SupplierQuotationItems[${index}].Remarks" class="form-control" />
            </td>
        </tr>`;

        $("#quotationTableBody").append(row);
    }

    $(document).ready(function () {

        $(document).on("input change", ".line-qty, .unit-price, .line-discount, #OtherCharges", function () {
            recalculateTotals();
        });

    });

</script>
