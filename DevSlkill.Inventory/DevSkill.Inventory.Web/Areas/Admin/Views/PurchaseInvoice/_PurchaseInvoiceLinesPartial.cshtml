@model List<PurchaseInvoiceItemModel>

@*
    The invoice grid, shared by the create and update screens. The product, unit
    price and tax rate all come from the purchase order and are read only, so a
    supplier can never be billed at a price nobody agreed.
*@

<div class="card">

    <div class="card-header">
        <h3 class="card-title">Billed Products</h3>
    </div>

    <div class="card-body">

        <div class="alert alert-info">
            <i class="fas fa-shield-alt"></i>
            Only goods that have actually been received can be billed, so
            <strong>Billable</strong> is capped by the goods receipts, not by the order.
            The unit price and tax rate come from the purchase order; every total is
            calculated again on the server when you save.
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th width="22%">Product</th>
                        <th width="8%">Unit</th>
                        <th width="10%">Received</th>
                        <th width="10%">Already Billed</th>
                        <th width="9%">Billable</th>
                        <th width="11%">Billing Now</th>
                        <th width="10%">Unit Price</th>
                        <th width="10%">Discount</th>
                        <th width="10%">Line Total</th>
                    </tr>
                </thead>

                <tbody id="invoiceTableBody">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model[i].ProductName
                                <input type="hidden" name="PurchaseInvoiceItems[@i].ProductId" value="@Model[i].ProductId" />
                                <input type="hidden" name="PurchaseInvoiceItems[@i].ProductName" value="@Model[i].ProductName" />
                                <input type="hidden" name="PurchaseInvoiceItems[@i].UnitName" value="@Model[i].UnitName" />
                                <input type="hidden" name="PurchaseInvoiceItems[@i].ReceivedQuantity" value="@Model[i].ReceivedQuantity" />
                                <input type="hidden" name="PurchaseInvoiceItems[@i].InvoicedQuantity" value="@Model[i].InvoicedQuantity" />
                                <input type="hidden" name="PurchaseInvoiceItems[@i].RemainingQuantity" value="@Model[i].RemainingQuantity" class="remaining-qty" />
                                <input type="hidden" name="PurchaseInvoiceItems[@i].UnitPrice" value="@Model[i].UnitPrice" class="unit-price" />
                                <input type="hidden" name="PurchaseInvoiceItems[@i].TaxRate" value="@Model[i].TaxRate" class="tax-rate" />
                            </td>

                            <td>@Model[i].UnitName</td>
                            <td class="text-right">@Model[i].ReceivedQuantity.ToString("N2")</td>
                            <td class="text-right">@Model[i].InvoicedQuantity.ToString("N2")</td>
                            <td class="text-right font-weight-bold">@Model[i].RemainingQuantity.ToString("N2")</td>

                            <td>
                                <input name="PurchaseInvoiceItems[@i].Quantity" value="@Model[i].Quantity"
                                       type="number" step="0.01" min="0" class="form-control line-qty" />
                            </td>

                            <td class="text-right">@Model[i].UnitPrice.ToString("N2")</td>

                            <td>
                                <input name="PurchaseInvoiceItems[@i].DiscountAmount" value="@Model[i].DiscountAmount"
                                       type="number" step="0.01" min="0" class="form-control discount-amount" />
                            </td>

                            <td><input class="form-control line-total" value="0.00" readonly /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                <i class="fas fa-info-circle"></i>
                Choose a purchase order above and everything it has received but not yet billed will appear here.
            </div>
        }

        <div class="row justify-content-end">
            <div class="col-md-5">
                <table class="table table-sm">
                    <tr>
                        <th>Sub Total</th>
                        <td class="text-right" id="sumSubTotal">0.00</td>
                    </tr>
                    <tr>
                        <th>Item Discount</th>
                        <td class="text-right" id="sumDiscount">0.00</td>
                    </tr>
                    <tr>
                        <th>Tax / VAT</th>
                        <td class="text-right" id="sumTax">0.00</td>
                    </tr>
                    <tr>
                        <th>Other Charges</th>
                        <td class="text-right" id="sumOtherCharges">0.00</td>
                    </tr>
                    <tr class="bg-light">
                        <th>Grand Total</th>
                        <th class="text-right" id="sumGrandTotal">0.00</th>
                    </tr>
                </table>
            </div>
        </div>

    </div>

</div>
