@{
    ViewData["Title"] = "Waranty List";
}

<style>
    .toast {
        background-color: #28a745;
        color: white;
    }

    .toast-body {
        width: 100%;
        text-align: center;
    }

    tbody tr {
        cursor: pointer;
    }
</style>

@section Styles {
    <!-- DataTables -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="adjustmentTypeToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-body d-flex" id="toastMessage">
            <!-- Toast message will be dynamically set here -->
        </div>
    </div>
</div>

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>All Stock Adjustment List</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Stock Adjustment</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">All available stock adjustment are here!</h3>

                        <a class="btn btn-primary float-right" asp-area="Admin" asp-controller="StockAdjustment" asp-action="CreateStockAdjustment">
                            <i class="nav-icon"></i>
                            <i class="fas fa-plus"></i> Add Stock Adjustment
                        </a>

                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="adjustmentTypes" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Location Name</th>
                                    <th>Adjustment Type</th>
                                    <th>Product Name</th>
                                    <th>Reference No</th>
                                    <th>TotalAmount</th>
                                    <th>TotalAmountRecover</th>
                                    <th>Reason</th>
                                    <th>AdjustmentDate</th>
                                    <th>AddedBy</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Location Name</th>
                                    <th>Adjustment Type</th>
                                    <th>Product Name</th>
                                    <th>Reference No</th>
                                    <th>TotalAmount</th>
                                    <th>TotalAmountRecover</th>
                                    <th>Reason</th>
                                    <th>AdjustmentDate</th>
                                    <th>AddedBy</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>

<partial name="_StockAdjustmentDetailsPartial" />

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabel">Delete Confirmation</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this record?</p>
                <p>If you delete this it gone forever!</p>
            </div>
            <div class="modal-footer">
                <!-- The form that will be submitted when delete is confirmed -->
                <form method="POST" id="adjustmentType-form" asp-antiforgery="true" , enctype="multipart/form-data">
                    <!-- Hidden input to store the ID of the item to be deleted -->
                    <input type="hidden" id="delete-id" name="id">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="warranty-delete">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables  & Plugins -->
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <!--This is link for print-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/printThis/1.15.0/printThis.min.js"></script>

    <script type="text/javascript">
        //Load data in table used by DataTable...
        $(function () {
            $("#adjustmentTypes").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                ajax: {
                    url: "/Admin/StockAdjustment/GetStockAdjustmentJsonData",
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    data: function (d) {
                        return JSON.stringify(d);
                    }
                },

                columnDefs: [

                    {
                        orderable: false,
                        targets: 9,
                        render: function (data, type, row) {
                            return `
                             <a href="/Admin/StockAdjustment/UpdateStockAdjustment/${data}"
                               class="btn btn-info btn-sm mr-1">
                                <i class="fas fa-edit"></i> Edit
                             </a>

                            <button type="submit" class="btn btn-danger btn-sm show-bs-modal" data-id='${data}' value='${data}'>
                                <i class="fas fa-trash">
                                </i>
                                Delete
                            </button>`;
                        }
                    },
                    ...[0, 1, 2, 3, 4, 5, 6, 7, 8].map(function (target) {
                        return {
                            targets: target,
                            createdCell: function (td, type, data) {
                                $(td).addClass('table-row');
                                $(td).attr('data-id', data[9]);
                            }
                        };
                    })
                ],

                dom: '<"row"<"col-sm-12 col-md-6"lB><"col-sm-12 col-md-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]

            }).buttons().container().appendTo('#adjustmentTypes_wrapper .col-md-6:eq(0)');

            
            //This is code delete the adjustment type...
            $(document).ready(function () {
                // Handle the click event on delete buttons in the list
                $('#adjustmentTypes').on('click', '.show-bs-modal', function (e) {
                    let id = $(this).data("id");  // Get the ID of the item to delete
                    $("#delete-id").val(id);  // Set the hidden input value with the ID
                    $("#delete-modal").modal('show');  // Show the delete confirmation modal
                });

                // Handle the delete confirmation button click
                $("#warranty-delete").click(function () {
                    let id = $("#delete-id").val();  // Get the ID from the hidden input
                    // Send the delete request via AJAX
                    $.ajax({
                        url: '/Admin/StockAdjustment/DeleteStockAdjustment',
                        type: 'POST',
                        data: {
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()  // Include anti-forgery token
                        },
                        success: function (response) {
                            if (response.success) {
                                // Close the modal
                                $('#delete-modal').modal('hide');

                                // Display toast notification
                                $('#toastMessage').text(response.message);
                                $('#adjustmentTypeToast').toast({
                                    delay: 3000
                                });
                                $('#adjustmentTypeToast').toast('show');
                                // Refresh the DataTable
                                $('#adjustmentTypes').DataTable().ajax.reload();
                            }
                            else {
                                $('#toastMessage').text(response.message);
                                $('#adjustmentTypeToast').toast({
                                    delay: 3000
                                });
                                $('#adjustmentTypeToast').toast('show');
                            }
                        },
                        error: function (error) {
                            if (error.status === 403) {
                                // Redirect to Access Denied page if the status is 403
                                window.location.href = '/Account/AccessDenied';
                            }
                            else 
                            {
                                $('#toastMessage').text('There was an error adding the brand.');
                                $('#adjustmentTypeToast').toast({
                                    delay: 3000
                                });
                                $('#adjustmentTypeToast').toast('show');
                            }
                        }
                    });
                });
            });


            // This code for product details
            $('#adjustmentTypes tbody').on('click', '.table-row', function () {
                console.log("clicked");
                var productId = $(this).data().id;
                $.ajax({
                    url: `/Admin/StockAdjustment/GetStockAdjustmentyById/${productId}`,
                    method: 'GET',
                    success: function (data) {
                        console.log(data);

                        // Display data or 'N/A' if value is empty
                        $('#id').text(data.id || 'N/A');
                        $('#ReferenceNo').text(data.referenceNo || 'N/A');
                        $('#AdjustmentDate').text(data.adjustmentDate ? new Date(data.adjustmentDate).toLocaleString('en-US', { hour12: true }) : 'N/A');
                        $('#TotalAmount').text(data.totalAmount || 'N/A');
                        $('#TotalAmountRecover').text(data.totalAmountRecover || 'N/A');
                        $('#Reason').text(data.reason || 'N/A');
                        $('#AddedBy').text(data.addedBy || 'N/A');
                        $('#BusinessLocationName').text(data.businessLocation?.locationName || 'N/A');
                        $('#AdjustmentTypeName').text(data.adjustmentType?.adjustmentTypeName || 'N/A');
                        $('#ProductId').text(data.product?.id || 'N/A');
                        $('#ProductName').text(data.product?.productName || 'N/A');
                        $('#ProductPrice').text(data.product?.price || 'N/A');

                        $('#ProductTableName').text(data.product?.productName || 'N/A');
                        $('#ProductQuantity').text(data.adjustmentQuantity || 'N/A');
                        $('#ProductUnitPrice').text(data.unitPrice || 'N/A');
                        $('#ProductSubtotal').text(data.totalAmount || 'N/A');
                        // Show the modal
                        $('#stockAdjustmentDetailModal').modal('show');
                    },
                    error: function (xhr, status, error) {
                        if (xhr.status === 403) {
                            // Redirect to Access Denied page if the status is 403
                            window.location.href = '/Account/AccessDenied';
                        }
                        else 
                        {
                            console.error("Error fetching product data:", error);
                            alert('Failed to load product details.');
                        }
                    }
                });
            });


            //This code for temp data response fadeOut
            $(document).ready(function () {
                setTimeout(function () {
                    $('#response-alert').fadeOut('slow');
                }, 3000);
            });

        });
    </script>
}
