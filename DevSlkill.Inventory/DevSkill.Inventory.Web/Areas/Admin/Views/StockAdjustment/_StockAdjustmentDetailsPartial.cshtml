<!-- Product Details Modal -->
<div id="productDetailsModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-custom modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Stock Adjustment Details (Reference No: <span id="ReferenceNo"></span>)</h5>
                <button type="button" class="close" data-dismiss="modal">
                    &times;
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4">
                        <p><strong>Adjustment Date:</strong> <span id="AdjustmentDate"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Total Amount:</strong> <span id="TotalAmount"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Total Amount Recover:</strong> <span id="TotalAmountRecover"></span></p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <p><strong>Reason:</strong> <span id="Reason"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Added By:</strong> <span id="AddedBy"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Business Location Name:</strong> <span id="BusinessLocationName"></span></p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <p><strong>Adjustment Type:</strong> <span id="AdjustmentTypeName"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Product Id:</strong> <span id="ProductId"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Product Name:</strong> <span id="ProductName"></span></p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Price:</strong> <span id="ProductPrice"></span></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary no-print" aria-label="Print" onclick="$('#productDetailsModal').printThis();">
                    <i class="fa fa-print"></i> Print
                </button>
                <button type="button" class="btn btn-secondary no-print" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
