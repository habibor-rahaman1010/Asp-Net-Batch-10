@model StockAdjustmentCreateModel;

@{
    ViewData["Title"] = "Create Stock Adjustment";
}

<style>
    #container {
        width: 1000px;
        margin: 20px auto;
    }

    .ck-editor__editable[role="textbox"] {
        min-height: 300px;
    }

    .ck-content .image {
        max-width: 80%;
        margin: 20px auto;
    }

    #productImage {
        display: block;
        margin-bottom: 10px;
    }

    #imageError {
        color: teal;
    }

    .ui-autocomplete {
        border: 1px solid #007bff;
        background-color: #f8f9fa;
        border-radius: 4px;
        max-height: 200px;
        overflow-y: auto;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        z-index: 1000;
        width: 50% !important;
    }

    .ui-menu {
        list-style-type: none;
        padding: 2px;
        margin: 2px;
    }

    .ui-menu-item {
        padding: 8px 12px;
        font-size: 14px;
        cursor: pointer;
        width: 100%;
        box-sizing: border-box;
    }

    .ui-menu-item:hover {
        background-color: #007bff;
        color: white;
    }
</style>

@{
    var productOptions = string.Join("",
        Model.StockAdjustmentItems[0].Products.Select(x =>
            $"<option value='{x.Value}'>{x.Text}</option>"));

    var unitOptions = string.Join("",
        Model.StockAdjustmentItems[0].Units.Select(x =>
            $"<option value='{x.Value}'>{x.Text}</option>"));
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="ml-2">Add Stock Adjustment</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Stock</a></li>
                    <li class="breadcrumb-item active">Create New</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div>
            <form asp-antiforgery="true" asp-area="Admin" asp-controller="StockAdjustment" asp-action="CreateStockAdjustment" method="post" enctype="multipart/form-data">
                <!--Form-1 -->
                <div class="col-sm-12">
                    <!-- general form elements -->
                    <div class="card card-primary" style="border-top: 4px solid #3c8dbc;">
                        <!-- /.card-header -->
                        <!-- form start -->
                        <div class="card-body">
                            <partial name="_ResponsePartial" />

                            <div class="row">
                                <!-- First row of form inputs -->
                                <div class="col-sm-3 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="BusinessLocationId">Business Location*</label>
                                        <select asp-for="BusinessLocationId" asp-items="Model.BusinessLocations" class="form-control"></select>
                                        <span asp-validation-for="BusinessLocationId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-3 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="ReferenceNo">Reference No*</label>
                                        <input type="text" asp-for="ReferenceNo" class="form-control" placeholder="Reference No" />
                                        <span asp-validation-for="ReferenceNo" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="AdjustmentDate">Store Time*</label>
                                        <input type="datetime-local" asp-for="AdjustmentDate" class="form-control" value="" />
                                        <span asp-validation-for="AdjustmentDate" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-3 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="AdjustmentTypeId">Adjustment Types*</label>
                                        <select asp-for="AdjustmentTypeId" asp-items="Model.AdjustmentTypes" class="form-control"></select>
                                        <span asp-validation-for="AdjustmentTypeId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div>

                <!--Form-2 -->
                <div class="col-sm-12">
                    <!-- general form elements -->
                    <div class="card card-primary" style="border-top: 4px solid #3c8dbc;">
                        <div class="card-body">
                            <div class="card-header">
                                <h3 class="card-title">Search your product</h3>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">

                                <div class="mb-2">
                                    <button type="button"
                                            class="btn btn-primary"
                                            id="btnAddRow">
                                        <i class="fas fa-plus"></i> Add Product
                                    </button>
                                </div>

                                <table class="table table-bordered table-striped">

                                    <thead>
                                        <tr>
                                            <th width="35%">Product</th>
                                            <th width="20%">Available Qty</th>
                                            <th width="15%">Adjustment Qty</th>
                                            <th width="15%">Unit Price</th>
                                            <th width="15%">Subtotal</th>
                                            <th width="10%">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody id="productTableBody">

                                        <tr>
                                            <td>
                                                <select asp-for="StockAdjustmentItems[0].ProductId"
                                                        asp-items="Model.StockAdjustmentItems[0].Products"
                                                        class="form-control product-select">
                                                </select>
                                            </td>

                                            <td>
                                                <input type="text"
                                                       class="form-control available-qty"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="StockAdjustmentItems[0].AdjustmentQuantity"
                                                       class="form-control adjustment-qty" />
                                            </td>

                                            <td>
                                                <input asp-for="StockAdjustmentItems[0].UnitPrice"
                                                       class="form-control unit-price"
                                                       readonly />
                                            </td>

                                            <td>
                                                <div class="form-group">
                                                    <select asp-for="StockAdjustmentItems[0].UnitId" asp-items="Model.StockAdjustmentItems[0].Units" class="form-control unit-select"></select>
                                                    <span asp-validation-for="StockAdjustmentItems[0].UnitId" class="text-danger"></span>
                                                </div>
                                            </td>

                                            <td>
                                                <button type="button"
                                                        class="btn btn-danger btn-sm btnRemoveRow">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>

                                    </tbody>

                                </table>

                            </div>
                        </div>
                    </div>
                    <!-- /.card -->
                </div>

                <!--Form-3 -->
                <div class="col-sm-12">
                    <!-- general form elements -->
                    <div class="card card-primary" style="border-top: 4px solid #3c8dbc;">
                        <div class="card-body">
                            <div class="row">
                                <!-- First row of form inputs -->
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="TotalAmountRecover">Total Amount Recover*</label>
                                        <input type="number" asp-for="TotalAmountRecover" class="form-control" placeholder="Total Amount Recover" value="" />
                                        <span asp-validation-for="TotalAmountRecover" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="Reason">Reason*</label>
                                        <textarea asp-for="Reason" class="form-control" placeholder="Enter reason" style="width: 100%; height: 80px;"></textarea>
                                        <span asp-validation-for="Reason" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-sm-4 mb-3 px-3">
                                    <div class="form-group">
                                        <label asp-for="AddedBy">Added By*</label>
                                        <input type="text" asp-for="AddedBy" class="form-control" placeholder="Added By" />
                                        <span asp-validation-for="AddedBy" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /.card -->
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
        <!-- /.row -->
    </div><!-- /.container-fluid -->
</section>
<!-- /.content -->

<!-- This is jquery portion  -->
@section Scripts {
    <script>
        var rowIndex = 1;
let warehouseProducts = [];

$(document).ready(function () {

    updateDeleteButtons();

    // Load products by Business Location
    $("#BusinessLocationId").change(function () {

        let warehouseId = $(this).val();

        if (!warehouseId)
            return;

        $.ajax({
            url: "/Admin/StockTransfer/GetProductsByWarehouse",
            type: "GET",
            data: { warehouseId: warehouseId },
            success: function (response) {

                warehouseProducts = response;

                $(".product-select").each(function () {
                    loadProducts($(this));
                });

            },
            error: function () {
                alert("Failed to load products.");
            }
        });

    });

    // Add Row
    $("#btnAddRow").click(function () {

        var row = `
        <tr>

            <td>
                <select name="StockTransferItems[${rowIndex}].ProductId"
                        class="form-control product-select">
                    @Html.Raw(productOptions)
                </select>
            </td>

            <td>
                <input type="text"
                       class="form-control available-qty"
                       readonly />
            </td>

            <td>
                <input type="number"
                       name="StockAdjustmentItems[${rowIndex}].AdjustmentQuantity"
                       class="form-control adjustment-qty"
                       value="1"
                       min="1" />
            </td>

            <td>
                <input type="number"
                       name="StockAdjustmentItems[${rowIndex}].UnitPrice"
                       class="form-control unit-price"
                       readonly />
            </td>

            <td>
                <select name="StockTransferItems[${rowIndex}].UnitId"
                        class="form-control unit-select">
                    @Html.Raw(unitOptions)
                </select>
            </td>

            <td>
                <button type="button"
                        class="btn btn-danger btn-sm btnRemoveRow">
                    <i class="fas fa-trash"></i>
                </button>
            </td>

        </tr>`;

        $("#productTableBody").append(row);

        loadProducts($("#productTableBody tr:last").find(".product-select"));

        rowIndex++;

        updateDeleteButtons();

    });

    // Remove Row
    $(document).on("click", ".btnRemoveRow", function () {

        if ($("#productTableBody tr").length > 1) {

            $(this).closest("tr").remove();

            reIndexRows();

            calculateTotal();

            updateDeleteButtons();
        }

    });

    // Product Change
    $(document).on("change", ".product-select", function () {

        let selected = $(this).val();

        // Duplicate Product Check
        let count = $(".product-select").filter(function () {
            return $(this).val() === selected;
        }).length;

        if (count > 1) {
            alert("Product already selected.");
            $(this).val("");
            return;
        }

        let row = $(this).closest("tr");

        $.get("/Admin/Product/GetProductInfo",
            { productId: selected },
            function (response) {
                console.log(response)
                row.find(".available-qty").val(response.availableQuantity);
                row.find(".unit-select").val(response.unitId);
                row.find(".unit-price").val(response.unitPrice);

                calculateRow(row);

            });

    });

    // Qty Change
    $(document).on("keyup change", ".adjustment-qty", function () {

        calculateRow($(this).closest("tr"));

    });

});

// Load Products
function loadProducts(dropdown) {

    dropdown.empty();

    dropdown.append('<option value="">-- Select Product --</option>');

    $.each(warehouseProducts, function (i, product) {

        dropdown.append(
            $("<option>")
                .val(product.id)
                .text(product.text)
        );

    });

}

// Calculate Row
function calculateRow(row) {

    let qty = parseFloat(row.find(".adjustment-qty").val()) || 0;
    let stock = parseFloat(row.find(".available-qty").val()) || 0;

    if (qty > stock) {
        alert("Adjustment Qty cannot be greater than Current Stock.");
        qty = stock;
        row.find(".adjustment-qty").val(stock);
    }

    let price = parseFloat(row.find(".unit-price").val()) || 0;

    let subtotal = qty * price;

    row.find(".subtotal").val(subtotal.toFixed(2));

    calculateTotal();

}

// Calculate Total
function calculateTotal() {

    let total = 0;

    $(".subtotal").each(function () {

        total += parseFloat($(this).val()) || 0;

    });

    $("#total_adjustment").text(total.toFixed(2));
    $("#total_amount").val(total.toFixed(2));

}

// Reindex
function reIndexRows() {

    $("#productTableBody tr").each(function (index) {

        $(this).find("[name]").each(function () {

            $(this).attr("name",
                $(this).attr("name").replace(/StockAdjustmentItems\[\d+\]/,
                    "StockAdjustmentItems[" + index + "]"));

        });

    });

    rowIndex = $("#productTableBody tr").length;

}

// Delete Button
function updateDeleteButtons() {

    $(".btnRemoveRow").prop(
        "disabled",
        $("#productTableBody tr").length === 1
    );

}
    </script>
}